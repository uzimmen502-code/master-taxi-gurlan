{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "_comment": "Windows'da TCP dinamik diapazon 1024-15000 (`netsh int ipv4 show dynamicport tcp`) va Hyper-V/WinNAT har yuklanishda shu ichidan ~100 portlik bloklarni band qiladi (`netsh interface ipv4 show excludedportrange protocol=tcp`): avval 8080 (8075-8174), 2026-10-07 da 9500 (9440-9539) — port bo'sh ko'rinsa ham ochilmaydi. Shuning uchun port dinamik diapazondan TASHQARIDA (>15000). `emulators:exec` FIRESTORE_EMULATOR_HOST'ni bola jarayonga o'zi uzatadi, shuning uchun test fayllaridagi standart qiymat o'zgarmaydi.",
    "firestore": {
      "port": 18080
    },
    "ui": {
      "enabled": false
    }
  },
  "hosting": [
    {
      "site": "master-taxi-gurlan",
      "public": "build/hosting",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/admin",
          "destination": "/admin/index.html"
        },
        {
          "source": "/admin/**",
          "destination": "/admin/index.html"
        },
        {
          "source": "/clip/**",
          "function": "clipPage"
        },
        {
          "source": "/s/**",
          "function": "shopPage"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(css|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|webp|gif|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/admin/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "target": "landing",
      "public": "docs/landing",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "video/build_onepager_mp4.py",
        "video/frames/**",
        "build_kitob.js"
      ],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|webp|gif|ico|mp4)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    }
  ],
  "functions": [
    {
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "source": "functions"
    },
    {
      "source": "y",
      "codebase": "y",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    },
    {
      "source": "functions_demand",
      "codebase": "demand",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "tools",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
