{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ava://offer_input/v1",
  "title": "submitOffer callable kirish yuklamasi (v1)",
  "description": "Taklifchi yuboradigan yuklama. `providerId`, `status`, `createdAt`, `ownerId` (denormalizatsiya, Т-2.2) va `revision` — hammasi SERVERDA qo'yiladi. Taklifchi boshqa taklifning narxini ko'rmaydi (tasdiqlangan qaror), shuning uchun yuklamada ham hech qanday raqobatchi ma'lumoti yo'q.",
  "type": "object",
  "required": ["demandId", "clientRequestId"],
  "additionalProperties": false,
  "properties": {
    "demandId": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9-]+$",
      "description": "Composite kalit uchun `_` va `/` bo'lmasligi SHART (13.1.3)."
    },
    "clientRequestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "price": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 10000000000
    },
    "priceType": {
      "type": "string",
      "enum": ["fixed", "negotiable", "per_unit"],
      "default": "fixed"
    },
    "quantity": { "type": ["integer", "null"], "minimum": 1, "maximum": 1000000 },
    "message": { "type": "string", "maxLength": 500 },
    "etaMinutes": { "type": ["integer", "null"], "minimum": 1, "maximum": 20160 },
    "delivery": { "type": "boolean", "default": false },
    "media": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 5, "maxLength": 500 }
    }
  }
}
