# functions/.env — NUSXA QILMANG git'ga (.gitignore'da).
# Copy: copy .env.example .env  then fill values
#
# ⚠️ MUHIM: bu faylga FAQAT maxfiy BO'LMAGAN qiymatlar yoziladi.
#
# .env'dagi har bir kalit deploy paytida funksiyaning OCHIQ MATNDAGI
# environment variable'iga aylanadi — ya'ni loyihaga o'qish huquqi bor
# har kim va har qanday `gcloud functions describe` chiqishi uni ko'radi.
# Maxfiy qiymatlar shuning uchun Secret Manager'da turadi va funksiyaga
# `runWith({ secrets: [...] })` orqali bog'lanadi; kodda o'qilishi
# o'zgarmaydi — baribir `process.env.NOM`.

# ─────────────────────────────────────────────────────────────────────
# MAXFIY EMAS — shu yerda qoladi
# ─────────────────────────────────────────────────────────────────────

# Telegram botning ommaviy nomi (@siz).
TELEGRAM_WALLET_BOT_USERNAME=

# ─────────────────────────────────────────────────────────────────────
# MAXFIY — Secret Manager'da, bu faylga YOZILMAYDI
# ─────────────────────────────────────────────────────────────────────
#
# Yaratish:
#   firebase functions:secrets:set <NOM>
# Ko'rish (faqat nomlar):
#   gcloud secrets list --project=master-taxi-gurlan --format="value(name)"
#
#   OPENAI_API_KEY                  → assistantChat, onAssistantMessageCreated
#   MAPS_STATIC_KEY                 → evStaticMap
#   TELEGRAM_WALLET_BOT_TOKEN       → telegramWalletBotWebhook,
#                                     requestWalletWithdraw,
#                                     adminReviewWalletTopUp,
#                                     adminReviewWalletWithdraw
#   TELEGRAM_WALLET_WEBHOOK_SECRET  → telegramWalletBotWebhook
#   R2_ACCESS_KEY_ID                → TV klip transcode + o'chirish
#   R2_SECRET_ACCESS_KEY            → TV klip transcode + o'chirish
#   CLOUDFLARE_API_TOKEN            → TV klip transcode + o'chirish
#
# Bir nom bir vaqtda ham .env'da, ham secret bo'lsa deploy YIQILADI —
# shuning uchun yuqoridagilarni bu faylga qaytarib qo'ymang.
#
# Emulator uchun (ixtiyoriy): qiymatlarni `.secret.local` fayliga qo'ying,
# u ham .gitignore'da.

# ─────────────────────────────────────────────────────────────────────
# Hali ishlatilmaydi (AVA ijtimoiy tarmoqlari; admin paneldagi
# settings/tv_social afzal). Ishlatilsa — Secret Manager'ga.
# ─────────────────────────────────────────────────────────────────────
# META_PAGE_ID
# META_PAGE_ACCESS_TOKEN
# INSTAGRAM_USER_ID
