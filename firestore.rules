rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // MOBIL (Flutter) + WEB (master-taxi-web) bir xil Firestore loyihasida.
    // Mobil: Phone Auth enabled — Firebase verifyPhoneNumber.
    // `marshrut_block` auth bilan. `users` profilini faqat egasi/admin yozadi.
    // (Eski web foydalanuvchi — Anonymous Auth + `users/{998...}` — 2026-06 dan
    // beri deploy qilinmagan; uning mehmon patch yo'li olib tashlandi.)
    // Web operator (admin.html): faqat PIN sessiyasi — Firestore `role` operator uchun emas.

    // ══════════════════════════════════════
    // ЁРДАМЧИ ФУНКЦИЯЛАР
    // ══════════════════════════════════════

    // Майдон ўзгармадими?
    function notChanged(field) {
      return !(field in request.resource.data)
          || request.resource.data[field] == resource.data[field];
    }

    // Клиент баланс майдонларини ўзгартира олмасин (фақат Cloud Functions)
    // assistantPaidUntil — пуллик Pro муддати, фақат assistantBuyPackage (сервер).
    // `realtyUnlocksLeft` — пулга сотиб олинган ахборот пакети қолдиғи,
    // `realtyOwnerKey` — очиқ эълондаги эга калити. Иккови ҳам фақат
    // Cloud Function (Admin SDK) томонидан ёзилади: клиент ўзига
    // текинга пакет ёзиб қўймасин ёки бошқанинг эълонини ўзиники
    // қилиб олмасин.
    // `accountId` — барқарор провайдер кимлиги (T-1a, D-TAXI-2): фақат
    // сервер беради (`requestCapability` → `ensureAccountId`), клиент
    // ҳеч қачон ўзгартирмайди — акс ҳолда бошқанинг starter даврини
    // ўзига олиш мумкин бўларди.
    // `payoutKycVerified` (payout KYC belgisi) va `security` (qurilma
    // ko'chirilgandan keyingi `deviceTrustMode: limited` cheklovi) — faqat
    // server: avval egasi o'ziga KYC belgisini qo'yib yoki cheklovni olib
    // tashlab pul yechishi mumkin edi (hamyon auditi O-17).
    function walletFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'bonusBalance', 'balanceUpdatedAt', 'assistantPaidUntil',
            'realtyUnlocksLeft', 'realtyOwnerKey',
            'realtyPro', 'realtyTeamOwner', 'accountId',
            'payoutKycVerified', 'security'
          ]);
    }

    // Токен телефони → `users` ҳужжати → `accountId`. 9/12 хонали икки
    // калит шакли ҳам қаралади (`isAdmin` билан бир хил наqш).
    function callerAccountId() {
      let uid = userDocIdFromPhoneToken();
      return uid == '' ? ''
          : exists(/databases/$(database)/documents/users/$(uid))
            ? string(get(/databases/$(database)/documents/users/$(uid)).data.get('accountId', ''))
          : (uid.size() == 12 && uid[0:3] == '998'
              && exists(/databases/$(database)/documents/users/$(uid[3:12])))
            ? string(get(/databases/$(database)/documents/users/$(uid[3:12])).data.get('accountId', ''))
          : (uid.size() == 9
              && exists(/databases/$(database)/documents/users/$('998' + uid)))
            ? string(get(/databases/$(database)/documents/users/$('998' + uid)).data.get('accountId', ''))
          : '';
    }

    // `provider_capabilities/{accountId}` эгасими.
    function isCapabilityOwner(accountId) {
      let mine = callerAccountId();
      return mine != '' && mine == accountId;
    }

    // Firebase Phone Auth
    function isAuth() {
      return request.auth != null;
    }

    // userId = phoneDigits (масалан: 998901234567); token.phone_number = '+998901234567'
    function isOwner(userId) {
      return isAuth()
          && phoneDocIdsMatch(
               userDocIdFromPhoneToken(),
               userId
             );
    }

    function phoneFromToken() {
      return isAuth()
          && request.auth.token.phone_number is string
          ? request.auth.token.phone_number.replace('\\+', '')
          : '';
    }

    function phoneDigits(phone) {
      return phone is string ? phone.replace('\\+', '') : '';
    }

    function userDocIdFromPhoneToken() {
      return phoneFromToken();
    }

    // Nasab daraxti — joriy foydalanuvchining komponenti (tree_persons read uchun).
    function myTreeComponent() {
      let uid = userDocIdFromPhoneToken();
      return uid != ''
          && exists(/databases/$(database)/documents/users/$(uid))
          ? get(/databases/$(database)/documents/users/$(uid)).data.treeComponentId
          : '';
    }

    function userHasAdminRole(userId) {
      return userId != ''
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.role
              in ['admin', 'superadmin', 'dispatcher'];
    }

    function isAdmin() {
      let uid = userDocIdFromPhoneToken();
      return uid != ''
          && (
            userHasAdminRole(uid)
            || (uid.size() == 12
                && uid[0:3] == '998'
                && userHasAdminRole(uid[3:uid.size()]))
            || (uid.size() == 9 && userHasAdminRole('998' + uid))
          );
    }

    // D-SERVICE-4 / D-CLEAN-1: `courier` ва `seller` бу ерда ЙЎҚ — улар
    // хизмат capability'лари (`provider_capabilities`), platform-level
    // роль эмас. Аввал рўйхатда эди ва ўзига ўзи бериладиган `role`
    // орқали staff ҳуқуқи олинарди.
    function isStaff() {
      let uid = userDocIdFromPhoneToken();
      return uid != ''
          && exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.role
              in ['admin', 'superadmin', 'dispatcher', 'staff'];
    }

    // Faqat superadmin (admin panel `_SectionAccess.superOnly` bo'limlari).
    function isSuperAdmin() {
      let uid = userDocIdFromPhoneToken();
      return uid != ''
          && (
            (exists(/databases/$(database)/documents/users/$(uid))
              && get(/databases/$(database)/documents/users/$(uid)).data.role == 'superadmin')
            || (uid.size() == 12 && uid[0:3] == '998'
              && exists(/databases/$(database)/documents/users/$(uid[3:uid.size()]))
              && get(/databases/$(database)/documents/users/$(uid[3:uid.size()])).data.role == 'superadmin')
          );
    }

    // Settlement Ledger / Finance Center o'qish huquqi (SoD).
    // Faqat finance, auditor, superadmin — oddiy admin ko'rmaydi.
    function isFinanceReader() {
      let uid = userDocIdFromPhoneToken();
      return uid != ''
          && exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.role
              in ['superadmin', 'finance', 'auditor'];
    }

    // `usersGuestProfilePatchOnly` ОЛИБ ТАШЛАНДИ (ҳамён аудити 2026-10-08):
    // `isOwner`сиз эди — ҳар қандай кирган сессия (аноним ҳам) ИСТАЛГАН
    // профилда `name/birthDate` (payout KYC), `fcmToken` (push ўғирлаш),
    // `blockedUntil/cancelCount` (бировни блоклаш) ни ўзгартира оларди.
    // Уни ишлатган аноним веб-клиент (`master-taxi-web`) 2026-06 дан бери
    // деплой қилинмаган; илова профилни эгаси (`isOwner`) сифатида ёзади,
    // блокни тозалаш — админ экранидан.

    // `usersWebLooseDriverPromotion` ОЛИБ ТАШЛАНДИ (ҳамён аудити 2026-10-07,
    // K-6): исталган сессия (аноним ҳам) ИСТАЛГАН `users` ҳужжатига
    // `role: 'driver'` ёза оларди, `creditChange` эса шу ролга ишонарди.
    // Клиент бу ёзувни 2026-06-14 (`a6a0ac3`) дан бери ишлатмайди —
    // ҳайдовчи ролини сервер (Admin SDK) тасдиқда беради.

    // `usersLeaveDriverDemotion` ОЛИБ ТАШЛАНДИ (эга, 2026-10-17): `role: 'driver'`
    // белгиси тизимдан чиқарилди (прод'да 0 та ҳужжат, сервер ёзмайди). Қоида
    // `isOwner` текширувисиз эди — бегона ҳужжатдаги `driver` ни `user` га тушира оларди.

    // Profil PIN — foydalanuvchi ↔ kuryer (faqat o'z hujjati).
    // `usersCourierRolePromotion` / `usersLeaveCourierDemotion` O'CHIRILDI
    // (D-SERVICE-4, D-CLEAN-1) — `role: 'courier'` endi ma'noga ega emas,
    // kuryerlik huquqi `provider_capabilities.courier` da.

    function usersCarInfoPatch() {
      return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['carModel', 'carColor', 'carPlate',
                    'carUpdatedAt']);
    }

    // schedules → intercity_drivers sync (Phone Auth yo'q; driverId = telefon raqami)
    function intercityDriverScheduleCreate() {
      return request.resource.data.keys().hasAll(['name', 'phone', 'isActive']);
    }

    function intercityDriverScheduleSync() {
      return request.resource.data.keys().hasAll(['name', 'phone', 'isActive'])
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'name', 'phone', 'phoneDigits', 'plate', 'car',
                'seatCapacity', 'seats', 'price', 'hour', 'scheduleDate',
                'isActive', 'isOnPanel',
                'parcel', 'rating', 'from', 'to', 'stops', 'routeLabel',
                'updatedAt'
              ]);
    }

    function intercityBookingParticipantRead() {
      return isAuth() && (
        isAdmin()
        || phoneDocIdsMatch(
            userDocIdFromPhoneToken(), resource.data.userPhone)
        || phoneDocIdsMatch(
            userDocIdFromPhoneToken(), resource.data.driverId)
      );
    }

    function intercityDriverPanelPatch() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isOnPanel', 'updatedAt']);
    }

    function intercityDriverAutoAcceptPatch() {
      return resource.exists
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['autoAcceptBookings', 'updatedAt'])
          && request.resource.data.autoAcceptBookings is bool;
    }

    function intercityDriverEntertainmentKeysOnly() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['entertainmentIds', 'updatedAt'])
          || changed.hasOnly(['entertainmentIds']);
    }

    // Admin web (PIN) — haydovchiga kino ruxsati (Phone Auth admin bo'lgach isAdmin ham ishlaydi).
    function intercityDriverEntertainmentAllowedPatch() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['entertainmentAllowed', 'updatedAt'])
          && request.resource.data.entertainmentAllowed is bool;
    }

    // Haydovchi film tanlash — faqat entertainmentAllowed=true; Phone Auth shart emas
    // (intercity schedule sync kabi; driverId = telefon raqami).
    function intercityDriverEntertainmentPatch() {
      return resource.exists
          && resource.data.get('entertainmentAllowed', false) == true
          && intercityDriverEntertainmentKeysOnly()
          && request.resource.data.entertainmentIds is list
          && request.resource.data.entertainmentIds.size() <= 5;
    }

    // Admin PIN: haydovchi hujjati yo'q bo'lsa ham faqat kino ruxsatini yozish.
    function intercityDriverEntertainmentAllowedCreate() {
      return !resource.exists
          && request.resource.data.keys()
              .hasOnly(['entertainmentAllowed', 'updatedAt'])
          && request.resource.data.entertainmentAllowed is bool;
    }

    // Admin web PIN — katalog (Phone Auth isAdmin bilan parallel).
    function entertainmentCatalogCreate() {
      return request.resource.data.keys().hasAll([
            'title', 'storagePath', 'downloadUrl', 'active'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.storagePath is string
          && request.resource.data.storagePath.matches('entertainment/[a-zA-Z0-9_-]+\\.mp4')
          && request.resource.data.downloadUrl is string
          && request.resource.data.downloadUrl.size() > 10
          && request.resource.data.active is bool;
    }

    function entertainmentCatalogActivePatch() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['active', 'updatedAt'])
          && request.resource.data.active is bool;
    }

    function intercityDriverListingEnd() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isActive', 'isOnPanel', 'updatedAt'])
          && request.resource.data.isActive == false;
    }

    function intercityTripStartPatch(driverId) {
      return phoneDocIdsMatch(
              userDocIdFromPhoneToken(), driverId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['tripStartedAt', 'tripStatus', 'updatedAt']);
    }

  function intercityClientStatsPatch() {
      // create: resource == null; update: diff(resource.data)
      return resource == null
          ? request.resource.data.keys()
              .hasAll(['userName', 'userPhoneRaw', 'bookingCount'])
          : request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'userName', 'userPhoneRaw', 'bookingCount', 'totalSpent',
                'lastBookingAt', 'lastBookingId', 'firstBookingAt', 'completedCount'
              ]);
    }

    function intercityBookingDriverConfirm() {
      return phoneDocIdsMatch(
              userDocIdFromPhoneToken(), resource.data.driverId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'confirmed'
          && notChanged('userPhone')
          && notChanged('driverId')
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'confirmedAt', 'updatedAt']);
    }

    function intercityBookingPassengerCancelPatch() {
      return resource.data.status in ['pending', 'confirmed']
          && request.resource.data.status == 'cancelled'
          && notChanged('userPhone')
          && notChanged('driverId')
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelReason', 'cancelledAt']);
    }

    function intercityBookingPickupPatch() {
      return resource.data.status in ['pending', 'confirmed']
          && notChanged('userPhone')
          && notChanged('driverId')
          && notChanged('status')
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pickupAddress', 'pickupLat', 'pickupLng', 'updatedAt']);
    }

    function intercityBookingPickedUpPatch() {
      return phoneDocIdsMatch(
              userDocIdFromPhoneToken(), resource.data.driverId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pickedUp', 'pickedUpAt', 'updatedAt']);
    }

    function intercityBookingCompletePatch() {
      return phoneDocIdsMatch(
              userDocIdFromPhoneToken(), resource.data.driverId)
          && resource.data.status == 'confirmed'
          && request.resource.data.status == 'completed'
          && notChanged('userPhone')
          && notChanged('driverId')
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'completedAt']);
    }

    function intercityBookingDriverArchivePatch() {
      return phoneDocIdsMatch(
              userDocIdFromPhoneToken(), resource.data.driverId)
          && notChanged('userPhone')
          && notChanged('driverId')
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['archivedByDriver']);
    }

    // createBooking transaction — faqat seats / vaqt maydonlari
    // 2026-09-24 QA: OLIB TASHLANDI (ataylab). Bu funksiya faqat o'zgargan
    // maydon NOMLARINI tekshirardi — qiymatni ham, kim yozayotganini ham
    // emas. Natijada istalgan (hatto anonim) klient istalgan haydovchining
    // `seats` ini 0 ga (sabotaj) yoki katta songa (overbooking) yozib
    // qo'ya olardi. `seats` endi faqat Admin SDK orqali o'zgaradi:
    // `intercityCreateBooking` / `intercityCancelBooking` /
    // `intercityCompleteBooking` callable'lari va `expirePendingTrips`.

    // ══════════════════════════════════════
    // TAKSI HUQUQI — CAPABILITY (R-7, D-TAXI-1…5, D-CLEAN-1, 2026-10-06)
    // ══════════════════════════════════════
    // Avval `drivers/{id}.approved` (admin tasdig'i) edi. Endi huquq
    // `provider_capabilities/{accountId}.status.taxi` da:
    //   starter | verification_required | verified  → ISHLAYDI (operate)
    //   starter | verified                          → YANGI PULLIK E'LON (publish)
    // `drivers/{id}` — faqat PROFIL (ism, mashina, raqam), huquq emas.
    //
    // Taksi turi — haydovchining o'z deklaratsiyasi:
    // `provider_capabilities.taxi.taxiTypes` (klient yozadi; ruxsat
    // emas, filtr). `alone` ↔ `local` — eski sinonim, saqlanadi.
    //
    // Narx: har tekshiruvda 2 ta hujjat (users + capability); rules bitta
    // baholashda bir hujjatni qayta o'qishni sanamaydi.
    function accountIdOfUid(uid) {
      return uid == '' ? ''
          : exists(/databases/$(database)/documents/users/$(uid))
            ? string(get(/databases/$(database)/documents/users/$(uid)).data.get('accountId', ''))
          : (uid.size() == 12 && uid[0:3] == '998'
              && exists(/databases/$(database)/documents/users/$(uid[3:12])))
            ? string(get(/databases/$(database)/documents/users/$(uid[3:12])).data.get('accountId', ''))
          : (uid.size() == 9
              && exists(/databases/$(database)/documents/users/$('998' + uid)))
            ? string(get(/databases/$(database)/documents/users/$('998' + uid)).data.get('accountId', ''))
          : '';
    }

    function taxiCapOf(uid) {
      let acc = accountIdOfUid(uid);
      return acc != '' && exists(/databases/$(database)/documents/provider_capabilities/$(acc))
          ? get(/databases/$(database)/documents/provider_capabilities/$(acc)).data
          : {};
    }

    function taxiStatusOf(uid) {
      return string(taxiCapOf(uid).get('status', {}).get('taxi', ''));
    }

    function taxiTypeDeclared(uid, taxiType) {
      let types = taxiCapOf(uid).get('taxi', {}).get('taxiTypes', []);
      return taxiType in types
          || (taxiType == 'alone' && 'local' in types)
          || (taxiType == 'local' && 'alone' in types);
    }

    // OPERATE: mavjud ishni davom ettirish (D-TAXI-5: verification_required ham).
    function approvedDriverForTaxi(driverId, taxiType) {
      return taxiStatusOf(driverId) in ['starter', 'verification_required', 'verified']
          && taxiTypeDeclared(driverId, taxiType);
    }

    // PUBLISH: yangi pullik e'lon — verification_required YO'Q (D-TAXI-5).
    function taxiCanPublish(driverId, taxiType) {
      return taxiStatusOf(driverId) in ['starter', 'verified']
          && taxiTypeDeclared(driverId, taxiType);
    }

    // HAYDOVCHI ISH HOLATI — BEGONA YOZUV (2026-10-08 topilma).
    //
    // Avval `driverWorkPatchOnly` / `marshrutDriverRegisterPatch` /
    // `scheduleLifecyclePatchOnly` / `queueGuestDispatchPatchOnly` faqat
    // MAQSAD haydovchining capability'sini va maydon NOMLARINI tekshirardi —
    // kim yozayotganini emas. Istalgan klient (hatto kirmagan) istalgan
    // haydovchini offline qilar, GPS'ini siljitar, o'rinlarini 0 qilar,
    // marshrut haydovchining telefoni/raqamini almashtirar edi.
    //
    // 2-BOSQICH (docs/vazifalar.md V-14): haydovchi hujjatlariga (drivers /
    // schedules / queue) faqat EGASI (`isOwner`) va admin yozadi. Marshrut
    // yo'lovchisining timeout / bekor yozuvlari serverga ko'chgan
    // (`marshrutPassengerCloseOffer`, `marshrutPassengerCancelAfterAccept`,
    // `expirePendingTrips`). 1-bosqichdagi `driverPassengerDispatchPatch` /
    // `schedulePassengerDispatchPatch` / `queueGuestDispatchPatchOnly` eski
    // ilovalar uchun edi — ular yangilangach olib tashlandi.
    // ⚠️ Faqat yangi ilova ~90% bo'lgandan keyin deploy: eski ilovada
    // yo'lovchining «qabuldan keyin bekor»i bitta tranzaksiyada haydovchi
    // hujjatlariga yozadi va butunlay yiqiladi.
    // Test: functions/test/driver_work_patch_rules.test.js

    // `marshrutDriverRegisterPatch()` va `marshrutDriverProfileGuestWriteOk()`
    // OLIB TASHLANDI (2026-10-08): ikkalasida ham auth yo'q edi. Ilovada
    // ularga tayanadigan begona yozuv YO'Q — ro'yxatdan o'tishni haydovchi
    // o'zi qiladi (`isOwner`). `driverProfiles` dagisi baribir hech qachon
    // ishlamasdi: `resource.exists` qoidalarda xato beradi.

    // 13.6.4 (0b) — `driverApprovalPatchOnly()` ОЛИБ ТАШЛАНДИ.
    //
    // У нима қиларди: ўзгарган майдонлар рўйхатдан чиқмаса ва натижада
    // `approved: true` бўлса — рухсат. ИЧИДА auth текшируви ЙЎҚ эди,
    // яъни ИСТАЛГАН киши (аутентификациясиз ҳам) `drivers/{ҳар қандай
    // id}` ҳужжатини `approved: true` қилиб қўйиши мумкин эди. Шундан
    // кейин `approvedDriverForTaxi()` (353-қатор) ўтади ва навбат,
    // жадвал, сафар оқимлари очилади.
    //
    // Нега олиб ташлаш ХАВФСИЗ — учта далил:
    //   1. Изоҳи эскирган эди: «Admin web PIN/session билан ишлаётгани
    //      учун request.auth йўқ» деб ёзилган, лекин админ панели
    //      аллақачон custom token билан Firebase Auth'га киради ва
    //      `phone_number` доимий claim сифатида қўйилади
    //      (`functions/index.js` → `adminWebSignIn`; ўша кодда айнан
    //      «isOwner()/isAdmin() token.phone_number'га таянади» деб
    //      ёзилган).
    //   2. Тасдиқлашни СЕРВЕР қилади: `functions/index.js:8431` да
    //      `drivers/{phone}` ҳужжатига `approved: true` Admin SDK билан
    //      ёзилади — Admin SDK қоидалардан ўтмайди.
    //   3. Иловада `approved`/`approvalStatus` ни ЁЗАДИГАН бирорта жой
    //      йўқ (lib бўйича текширилди — фақат ўқиш).
    //
    // Қайта қўшилмасин: бу функция ҳуқуқни клиентга беради (18 ва
    // 19-қоида). Тасдиқлаш фақат CF ёки админ орқали.
    // Тест: functions/test/self_approval_rules.test.js

    /**
     * Тасдиқлаш майдонларига ТЕГИЛДИМИ.
     *
     * Биринчи уриниш тестда қулади: `create`да фақат `phone`/`name`
     * борлиги текширилганди, яъни курьер ўз ҳужжатини ДАРҲОЛ
     * `approved: true` билан ЯРАТИБ қўя оларди. `update`да эса
     * `isOwner(driverId)` чекланмаган эди — эгаси ўзини кейин ҳам
     * тасдиқлаши мумкин эди.
     *
     * Иловада бу майдонларни ёзадиган жой ЙЎҚ (lib бўйича текширилди),
     * серверда эса Admin SDK ёзади — шунинг учун клиентга умуман
     * керак эмас.
     */
    function driverApprovalFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['approved', 'approvalStatus', 'approvedAt', 'approvedBy']);
    }


    function marshrutDispatchEventCreateOk() {
      return request.resource.data.keys().hasAll(['type', 'tripId', 'createdAt'])
          && request.resource.data.type is string
          && request.resource.data.tripId is string;
    }

    function marshrutStatePatchOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['tripId', 'sessionId', 'status', 'updatedAt']);
    }

    function marshrutStateCreateOk() {
      return request.resource.data.keys()
          .hasOnly(['tripId', 'sessionId', 'status', 'updatedAt'])
          && request.resource.data.tripId is string
          && request.resource.data.status is string;
    }

    function phoneDocIdsMatch(a, b) {
      return a == b
          || (b.size() == 9 && a == ('998' + b))
          || (a.size() == 9 && b == ('998' + a));
    }

    // AVAGram avto-tasdiq (admin «AVAGram» → АВТО/ҚЎЛДА). Ilova klipni
    // `active` qilib yozishdan oldin aynan shu maydonni o'qiydi.
    function tvAutoApproveOn() {
      return exists(/databases/$(database)/documents/settings/app)
          && get(/databases/$(database)/documents/settings/app)
              .data.get('tvAutoApprove', false) == true;
    }

    function tvClipLikeCountNow() {
      return ('likeCount' in resource.data && resource.data.likeCount is int)
          ? resource.data.likeCount
          : 0;
    }

    function tvClipLikeCountOnly() {
      return isAuth()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likeCount'])
          && request.resource.data.likeCount is int
          && request.resource.data.likeCount >= 0
          && (
            request.resource.data.likeCount == tvClipLikeCountNow() + 1
            || request.resource.data.likeCount == tvClipLikeCountNow() - 1
          );
    }

    function tvClipViewCountNow() {
      return ('viewCount' in resource.data && resource.data.viewCount is int)
          ? resource.data.viewCount
          : 0;
    }

    function tvClipCommentCountNow() {
      return ('commentCount' in resource.data
              && resource.data.commentCount is int)
          ? resource.data.commentCount : 0;
    }

    function tvClipCommentCountOnly() {
      return isAuth()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['commentCount'])
          && request.resource.data.commentCount is int
          && request.resource.data.commentCount == tvClipCommentCountNow() + 1;
    }

    function tvClipViewCountOnly() {
      return isAuth()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['viewCount'])
          && request.resource.data.viewCount is int
          && request.resource.data.viewCount == tvClipViewCountNow() + 1;
    }

    function tvClipPlaybackStatNow(name) {
      return ('playbackStats' in resource.data
              && resource.data.playbackStats is map
              && name in resource.data.playbackStats
              && resource.data.playbackStats[name] is int)
          ? resource.data.playbackStats[name]
          : 0;
    }

    // Faqat `playbackStats` mapi va faqat OSHISHI (client tomonda hammasi
    // `FieldValue.increment(>=0)`) — `tvClipViewCountOnly()`ning aynan
    // o'sha naqshi, lekin bu yerda qadam qat'iy +1 emas: `watchedMs`/
    // `bufferMs` har ko'rishda har xil qiymatga oshadi.
    //
    // Kerak, chunki `TvPlaybackAnalyticsRecorder` statistikani klip
    // EGASI bo'lmagan tomoshabin nomidan yozadi (ko'rishlarning aksariyati
    // shunday) — bu funksiyasiz Firestore yozuvni PERMISSION_DENIED bilan
    // rad etardi va `recordPlaybackStats()`dagi best-effort `catch (_)`
    // buni jimgina yutib yuborardi: metrika hech qachon yig'ilmagan.
    function tvClipPlaybackStatIncreasing(name) {
      return !(name in request.resource.data.playbackStats)
          || (request.resource.data.playbackStats[name] is int
              && request.resource.data.playbackStats[name]
                  >= tvClipPlaybackStatNow(name));
    }

    function tvClipPlaybackStatsOnly() {
      return isAuth()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['playbackStats'])
          && request.resource.data.playbackStats is map
          && request.resource.data.playbackStats.keys().hasOnly([
               'views', 'watchedMs', 'bufferMs', 'bufferEvents',
               'firstFrameMsSum', 'firstFrameSamples', 'completedViews',
               'skippedViews', 'errors', 'updatedAt'])
          && tvClipPlaybackStatIncreasing('views')
          && tvClipPlaybackStatIncreasing('watchedMs')
          && tvClipPlaybackStatIncreasing('bufferMs')
          && tvClipPlaybackStatIncreasing('bufferEvents')
          && tvClipPlaybackStatIncreasing('firstFrameMsSum')
          && tvClipPlaybackStatIncreasing('firstFrameSamples')
          && tvClipPlaybackStatIncreasing('completedViews')
          && tvClipPlaybackStatIncreasing('skippedViews')
          && tvClipPlaybackStatIncreasing('errors');
    }

    function tvPublicProfileTotalViewCountNow() {
      return ('totalViewCount' in resource.data
              && resource.data.totalViewCount is int)
          ? resource.data.totalViewCount
          : 0;
    }

    function tvPublicProfileFollowerCountNow() {
      return ('followerCount' in resource.data
              && resource.data.followerCount is int)
          ? resource.data.followerCount : 0;
    }

    function tvPublicProfileFollowerCountOnly() {
      return isAuth()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['followerCount'])
          && request.resource.data.followerCount is int
          && request.resource.data.followerCount >= 0
          && (
            request.resource.data.followerCount
                == tvPublicProfileFollowerCountNow() + 1
            || request.resource.data.followerCount
                == tvPublicProfileFollowerCountNow() - 1
          );
    }

    function tvPublicProfileViewCountOnly() {
      return isAuth()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['totalViewCount'])
          && request.resource.data.totalViewCount is int
          && request.resource.data.totalViewCount
              == tvPublicProfileTotalViewCountNow() + 1;
    }

    function tvPublicProfilePhotoOk() {
      return !('photoUrl' in request.resource.data)
          || (request.resource.data.photoUrl is string
              && request.resource.data.photoUrl.size() <= 500);
    }

    function tvShopOwnerFieldsLocked() {
      return notChanged('boostUntil')
          && notChanged('socialPostedAt')
          && notChanged('ownerPhone')
          && notChanged('viewCount');
    }

    function passengerDocIdMatches(userId, tripPhone) {
      return userId == tripPhone
          || (tripPhone.size() == 9 && userId == ('998' + tripPhone))
          || (userId.size() == 9 && tripPhone == ('998' + userId));
    }

    function isTripMarshrutDriver(trip, caller) {
      let accepted = trip.acceptedDriverId;
      let targeted = trip.targetDriverId;
      return phoneDocIdsMatch(caller, accepted)
          || phoneDocIdsMatch(caller, targeted);
    }

    function marshrutActiveTripId() {
      return (request.resource.data.tripId is string
              && request.resource.data.tripId.size() > 0)
          ? request.resource.data.tripId
          : resource.data.tripId;
    }

    // Haydovchi qabul/rad/yakun — yo'lovchi `marshrut_state/active` sync.
    function marshrutStateDriverSyncOk(userId) {
      let tripId = marshrutActiveTripId();
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      let caller = userDocIdFromPhoneToken();
      return tripId is string
          && tripId.size() > 0
          && isAuth()
          && trip.taxiType == 'marshrut'
          && passengerDocIdMatches(userId, trip.userPhone)
          && isTripMarshrutDriver(trip, caller)
          && (
            (!resource.exists && marshrutStateCreateOk())
            || (resource.exists && marshrutStatePatchOnly())
          );
    }

    // ══════════════════════════════════════
    // USERS — фойдаланувчилар
    // ══════════════════════════════════════
    match /users/{userId} {
      // Баланс ва профил — фақат эга ёки админ
      allow read: if isOwner(userId) || isAdmin();

      // create — FAQAT egasi va FAQAT kanonik id (token telefoni, `998…`).
      // Avval istalgan sessiya (anonim ham) istalgan id'li hujjat yarata
      // olardi: ro'yxatdagi foydalanuvchining 9 xonali dublikatiga o'z
      // `fcmToken`ini yozib push'ini olish, begona raqam uchun "identifikatsiya"
      // hujjati ochish (hamyon auditi O-16). Ilova hujjatni egasi sifatida
      // `canonicalPhoneId` bilan yaratadi; server yo'llari Admin SDK.
      // update — Phone Auth (`isOwner`) yoki admin (mehmon patch olib tashlandi).
      allow create: if isAuth()
          && userDocIdFromPhoneToken() != ''
          && userId == userDocIdFromPhoneToken()
          && request.resource.data.keys().hasAll(['phone'])
          && !request.resource.data.keys().hasAny([
               'bonusBalance', 'balanceUpdatedAt', 'assistantPaidUntil',
               'realtyUnlocksLeft', 'realtyOwnerKey',
               'realtyPro', 'realtyTeamOwner', 'accountId',
               'payoutKycVerified', 'security'
             ])
          && (!('role' in request.resource.data) || request.resource.data.role == 'user');

      allow update: if (
          walletFieldsUntouched()
          && (
            // `usersCourierRolePromotion`/`usersLeaveCourierDemotion` ОЛИБ
            // ТАШЛАНДИ (D-SERVICE-4, D-CLEAN-1): курьерлик — `role` эмас,
            // `provider_capabilities.courier`. Ўзига `role: 'courier'`
            // ёзиш 14 та callable'ни очарди (self_approval_rules.test.js).
            (isOwner(userId) && usersCarInfoPatch())
            // `role` клиентдан ўзгармайди — ҳатто админдан ҳам. Аввал
            // `(notChanged('role') || isAdmin())` эди: admin/dispatcher
            // тўғридан-тўғри ёзиб ҳар қандай ролни (шу жумладан ўзига
            // `superadmin`) бера оларди ва `setUserRoleByAdmin`даги SoD
            // («admin фақат seller/user бера олади») четлаб ўтиларди. Админ
            // панел ролни фақат шу CF орқали ўзгартиради
            // (`AdminRoleService`). Тест: functions/test/admin_panel_audit_rules.test.js
            || (
              notChanged('role')
              && (isOwner(userId) || isAdmin())
            )
          )
        );

      // Ҳисоб-китоб журнали — фақат эга ёки админ
      match /wallet_ledger/{txId} {
        allow read: if isAuth()
            && (userDocIdFromPhoneToken() == userId || isAdmin());
        allow create, update, delete: if false;
      }

      match /birthday_bonus_claims/{year} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /marshrut_state/{docId} {
        // Эгаликка боғлаб бўлмайди: ҲАЙДОВЧИ ЙЎЛОВЧИнинг ҳолатини
        // синхронлайди (пастдаги `marshrutStateDriverSyncOk` ва
        // `rides_repository.dart:1274`). Ўқиш ҳам шу сабабли кесишган.
        // Шунинг учун фақат `isAuth()`.
        //
        // Тест: functions/test/marshrut_misc_rules.test.js
        allow read: if isAuth();
        allow create: if (isOwner(userId) && marshrutStateCreateOk())
            || marshrutStateDriverSyncOk(userId);
        // Админ «Dispatch history» → «Якунланди» (`_completeMarshrutRide`)
        // сафарни ёпгандан кейин йўловчи ҳолатини тозалайди
        // (`_clearMarshrutActiveIfMatches`). Аввал админ бу ерга ёза
        // олмасди: сафар ёпилар, лекин экран «Хатолик» кўрсатар ва
        // йўловчида `accepted` қолиб кетарди.
        allow update: if (isOwner(userId) && marshrutStatePatchOnly())
            || marshrutStateDriverSyncOk(userId)
            || isAdmin();
        allow delete: if false;
      }

      // Moy almashtirish — mashinalar va tarix
      match /vehicles/{vehicleId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
        match /oil_history/{entryId} {
          allow read, create, update, delete: if isOwner(userId) || isAdmin();
        }
      }

      match /car_profile_bonus_claims/{claimId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      // AVA ёрдамчиси (assistant_chat.js) — фақат сервер ёзади, эга ўқийди.
      // Суҳбатлар (ChatGPT каби), ичида хабарлар; 365 кун TTL (expiresAt).
      match /assistant_conversations/{convId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
        match /assistant_messages/{msgId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update, delete: if false;
        }
      }
      // Хотира — аввалги суҳбатлардан фактлар (ўчириш — assistantDeleteMemory).
      match /assistant_memory/{memId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }
      match /assistant_usage/{dayKey} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }
      match /assistant_packages/{pkgId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /saved_tv_clips/{clipId} {
        allow read, create, delete: if isOwner(userId);
        allow update: if false;
      }
    }

    // USERS / driverProfiles — маршрут рўйхатдан ўтиш (подколлекция)
    match /users/{userId}/driverProfiles/{profileId} {
      // Фақат эгаси ўқийди: `getProfile(uid)` доим `prefs['user_phone']`
      // билан чақирилади (`push_navigation.dart:186, :338`). Йўловчига
      // кўринадиган ҳайдовчи маълумоти `drivers/{id}` да, бу ерда эмас.
      //
      // Тест: functions/test/marshrut_misc_rules.test.js
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // Birth date ўзгартириш сўровлари.
    //
    // Аввал `create`, `read` ва `update` — учаласи ҳам `if true` эди, яъни
    // ҳар ким барча сўровларни ўқий, бошқа фойдаланувчи номидан сўров
    // ярата ва сўровни ўзи «approved» деб белгилай оларди.
    //
    // Эски изоҳ «Admin web hozir PIN session bilan ishlaydi; Phone Auth
    // admin bo'lgach `isAdmin()`ga qaytaramiz» деган эди. Админ панел
    // аллақачон Phone Auth'да (`admin_auth_service.dart:114–122`), демак
    // шарт бажарилган ва изоҳ эскирган.
    //
    // Оқим (`lib/repositories/user_repository.dart`): :289 фойдаланувчи
    // ўзи учун яратади · :310 админ `status == 'pending'` кузатади ·
    // :325 админ тасдиқлайди (транзакция) · :348 админ рад этади
    // (`set(merge)`). Тасдиқлаш клиентдан бажарилади, CF эмас.
    //
    // Тест: functions/test/birthdate_requests_rules.test.js
    match /birthdate_change_requests/{id} {
      allow create: if isAdmin()
          || (isOwner(request.resource.data.userId)
              && request.resource.data.status == 'pending');
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // O'qish: admin web collection query (eski ID lar hali bo'lsa ham).
    // Yangi tizim faqat hash-doc ishlatadi; yozuv faqat Cloud Functions.
    // Admin kod (fake SMS) — mobil so'rov, admin kod yozadi, ilova stream kuzatadi.
    match /pending_codes/{phoneId} {
      // OTP kodlar faqat CF (Admin SDK) orqali yoziladi.
      // Klient o'qishi: token.phone_number ↔ phoneId (admin ham ko'radi).
      allow read: if isOwner(phoneId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /device_bindings/{hash} {
      // Аввал `read: if true` эди — яъни 557 та қурилма ↔ телефон
      // боғланишининг бутун рўйхатини ҳар ким юклаб ола оларди.
      //
      // `get` очиқ қолади: илова қурилма боғланганми йўқми деб ЎЗ hash'и
      // бўйича битта ҳужжатни ўқийди, ва буни AUTH'ДАН ОЛДИН қилади
      // (`device_binding_repository.dart:90, :105` — телефон тасдиқлашдан
      // олдинги қадам). `isAuth()` талаб қилинса onboarding бузилади.
      //
      // `list` эса фақат админга — энумерация ёпилади
      // (`users_devices_screen.dart:405`).
      //
      // Қоладиган хавф: кимдир бирор қурилманинг hash'ини билса, ўша
      // битта боғланишни ўқийди. Hash узун ва таxмин билан топилмайди,
      // ва қурилманинг ўзи уни калит сифатида ишлатади.
      //
      // Тест: functions/test/device_bindings_rules.test.js
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Anonymous Session + Account Merge (1-bosqich) — sessionId = Firebase
    // Anonymous Auth uid. device_bindings'ga tegilmaydi, mustaqil kolleksiya.
    match /anon_sessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == sessionId;
      allow create: if request.auth != null && request.auth.uid == sessionId
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
      // status'ni faqat CF (mergeAnonymousSession, Admin SDK) o'zgartiradi.
      allow update: if request.auth != null && request.auth.uid == sessionId
          && request.resource.data.status == resource.data.status;
      allow delete: if false;

      match /engagement/{eventId} {
        allow read: if request.auth != null && request.auth.uid == sessionId;
        allow create: if request.auth != null && request.auth.uid == sessionId;
        allow update, delete: if false;
      }
    }

    // Teskari indeks (like/save/view) — faqat CF (mergeAnonymousSession /
    // backfillEngagementIndex, Admin SDK) yozadi, xuddi device_bindings kabi.
    match /user_engagement_index/{userId} {
      allow read: if isOwner(userId)
          || (request.auth != null && request.auth.uid == userId)
          || isAdmin();
      allow create, update, delete: if false;
    }

    match /device_bindings_legacy/{legacyId} {
      // Клиент буни УМУМАН ўқимайди — фақат бир марталик миграция CF
      // тегади (`functions/index.js:6475, :6492`). Шунинг учун тўлиқ
      // админгa ёпилди. Тест: functions/test/device_bindings_rules.test.js
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /device_aliases/{phone} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /device_change_requests/{id} {
      allow create: if request.auth != null;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Peer device transfer (Faza 1) — yozish faqat CF; o‘qish: egasi yoki admin.
    match /device_transfer_requests/{id} {
      allow read: if isAdmin()
          || (isAuth() && resource.data.phone == phoneFromToken());
      allow create, update, delete: if false;
    }

    // Risk ҳодисалари.
    //
    // Аввал `create`, `read`, `update` — `if true` эди: ҳар ким (ҳатто
    // кирмаган) ҳодисаларни (телефон, туғилган кун, ҳамён суммалари)
    // ўқий, сохта ҳодиса ёза ва уни «resolved» қилиб ёпа оларди. «PIN
    // session» изоҳи `birthdate_change_requests`даги каби эскирган — админ
    // панел Phone Auth'да.
    //
    // Ёзувчилар: `UserRepository._addRiskEvent` (фойдаланувчи ЎЗИ учун,
    // туғилган кун ўзгартириш сўровида, `status: 'open'`) · `detectAnomaly`
    // CF (Admin SDK) · админ «Risk review» `resolveRiskEvent`.
    //
    // Тест: functions/test/admin_panel_audit_rules.test.js
    match /risk_events/{id} {
      allow create: if isAdmin()
          || (isOwner(request.resource.data.userId)
              && request.resource.data.status == 'open');
      allow read, update, delete: if isAdmin();
    }

    // Admin panel shaxsiy PIN xeshlari (`functions/admin_pin.js`) va admin
    // amallar auditi — FAQAT Admin SDK. Hech qanday klient (admin ham)
    // o'qiy/yoza olmaydi: xesh+salt offline brute-force uchun ham yopiq.
    match /admin_credentials/{docId} {
      allow read, write: if false;
    }
    match /admin_audit/{docId} {
      allow read, write: if false;
    }

    // ── «Барча буюртмалар» (D-ALL-5/6/9, 2026-10-11) ────────────────────
    // Superadmin доим кўради; бошқа панел ходими — фақат админ берган
    // `all_orders` бўлим рухсати билан. Рол олиб ташланса рухсат ҳам
    // ишламайди (иккаласи текширилади). Ёзувчи — фақат CF.
    function userRoleIn(userId, roles) {
      return userId != ''
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.role in roles;
    }

    function callerHasPanelRole() {
      let uid = userDocIdFromPhoneToken();
      let roles = ['admin', 'superadmin', 'dispatcher', 'finance', 'auditor'];
      return uid != ''
          && (userRoleIn(uid, roles)
              || (uid.size() == 12 && uid[0:3] == '998'
                  && userRoleIn(uid[3:uid.size()], roles)));
    }

    function callerHasSectionGrant(section) {
      let uid = userDocIdFromPhoneToken();
      return uid != ''
          && exists(/databases/$(database)/documents/admin_section_grants/$(uid))
          && section in get(/databases/$(database)/documents/admin_section_grants/$(uid)).data.sections;
    }

    function canViewAllOrders() {
      return isSuperAdmin()
          || (callerHasPanelRole() && callerHasSectionGrant('all_orders'));
    }

    match /order_index/{docId} {
      allow read: if canViewAllOrders();
      allow write: if false;
    }

    match /admin_section_grants/{userId} {
      allow get: if userDocIdFromPhoneToken() == userId || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Marshrut blok holati — faqat o'z telefon raqami yoki admin
    match /users/{userId}/marshrut_block/{doc} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Local taxi qidiruv bloki — фақат CF / admin
    match /users/{userId}/local_taxi_block/{doc} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════
    // DRIVERS — ҳайдовчилар
    // ══════════════════════════════════════
    match /drivers/{driverId} {
      // Аввал `read: if true` эди — яъни 16 ҳайдовчининг телефони ва
      // жонли GPS'и очиқ рўйхат сифатида юклаб олинарди. `couriers` билан
      // бир хил шакл, 5 баравар каттароқ.
      //
      // Йўловчи ўз ҳайдовчисини кўриши керак, лекин репо бўйича бу ДОИМ
      // битта ҳужжат, ID бўйича: `local_taxi_active_trip_screen.dart:109`,
      // `marshrut_taxi_screen.dart:217`. Рўйхатни эса фақат админ олади:
      // `marshrut_admin_screen.dart:88`. Шунинг учун get/list ажратилди.
      //
      // Эслатма: `create` да ҳамон auth йўқ — у алоҳида ўрганилади,
      // чунки update'даги уч ёрдамчи билан боғлиқ.
      //
      // Тест: functions/test/drivers_read_rules.test.js
      allow get: if isAuth();
      allow list: if isAdmin();

      // Яратиш — 13.6.4 (0b): аввал AUTH УМУМАН ЙЎҚ эди, яъни
      // аутентификациясиз ҳар ким исталган рақамга ҳайдовчи ҳужжати
      // ясаши мумкин эди. Ҳужжатни асосан CF яратади
      // (`index.js:8431`, Admin SDK — қоидалардан ўтмайди), шунинг
      // учун клиентга фақат ЎЗ ҳужжати қолдирилади.
      // `approved` ни ЯРАТИШ пайтида ҳам бериб бўлмайди: аввалги
      // уриниш айнан шу жойда тешик қолдирган эди.
      allow create: if (isOwner(driverId) || isAdmin())
          && request.resource.data.keys().hasAll(['phone', 'name'])
          && (
            isAdmin()
            || !request.resource.data.keys().hasAny([
                 'approved', 'approvalStatus', 'approvedAt', 'approvedBy'
               ])
          );

      // Ўз маълумотларини ёки admin ўзгартира олади.
      // Phone Auth тўлиқ жорий қилинмагунча, тасдиқланган ҳайдовчига фақат
      // ишга чиқиш/онлайн ҳолати майдонларини ўзгартиришга рухсат.
      //
      // `driverApprovalPatchOnly()` ОЛИБ ТАШЛАНДИ — 429-қатордаги
      // изоҳга қаранг. `driverWorkPatchOnly()` ва
      // `marshrutDriverRegisterPatch()` ҳам (2026-10-08): уларда auth йўқ
      // эди — ҳар ким исталган ҳайдовчини offline қилар, телефонини
      // алмаштирарди. 2-босқичда бегона ёзув умуман йўқ — 428-қатордаги
      // изоҳга қаранг (йўловчи ёзувлари серверда).
      allow update: if isAdmin()
          || (isOwner(driverId) && driverApprovalFieldsUntouched());

      // Ўчириш — йўқ
      allow delete: if false;
    }

    // Marshrut `trips` — kim qaysi o'tishni qila oladi (admin audit O-2,
    // 2026-10-08). Avval faqat maydon whitelist'i bor edi, auth/egalik YO'Q:
    // har kim (hatto kirmagan) istalgan marshrut safarining `status`,
    // `fare`, `cashPaid`, `acceptedDriverId`ini o'zgartira olardi.
    // Yozuvchilar — `lib/repositories/rides_repository.dart`; admin
    // («Dispatch history») — `isAdmin()` shoxchasi; CF — Admin SDK.
    // Test: functions/test/marshrut_trips_rules.test.js
    //
    // Yo'lovchi (`userPhone`): muddati o'tgan pending → expired;
    // pending/accepted → cancelled (o'zi, reroute'siz).
    function marshrutPaxUpdate(uid, d, prev, k) {
      return phoneDocIdsMatch(uid, phoneDigits(prev.get('userPhone', '')))
          && (
            (prev.status == 'pending' && d.status == 'expired'
                && k.hasOnly(['status', 'expiredAt']))
            || (prev.status in ['pending', 'accepted'] && d.status == 'cancelled'
                && d.get('cancelledBy', '') in ['user', 'passenger']
                && d.get('notifyPassengerReroute', false) == false
                && k.hasOnly(['status', 'cancelledBy', 'cancelledAt',
                              'cancelReason', 'notifyPassengerReroute']))
          );
    }

    // Haydovchi — o'ziga yo'naltirilgan (`targetDriverId`) pending taklif:
    // qabul (faqat o'zini `acceptedDriverId`), rad, joy yo'q, muddati o'tdi.
    function marshrutDriverOfferUpdate(uid, d, prev, k) {
      return phoneDocIdsMatch(uid, prev.get('targetDriverId', ''))
          && prev.status == 'pending'
          && (
            (d.status == 'accepted'
                && phoneDocIdsMatch(uid, d.get('acceptedDriverId', ''))
                && k.hasOnly(['status', 'acceptedDriverId', 'acceptedDriverName',
                              'acceptedDriverPhone', 'acceptedDriverCar',
                              'acceptedDriverPlate', 'acceptedAt']))
            || (d.status == 'rejected'
                && phoneDocIdsMatch(uid, d.get('rejectedBy', ''))
                && k.hasOnly(['status', 'rejectedBy', 'rejectedAt']))
            || (d.status == 'no_seats' && k.hasOnly(['status']))
            || (d.status == 'expired' && k.hasOnly(['status', 'expiredAt']))
          );
    }

    // Haydovchi — o'zi qabul qilgan (`acceptedDriverId`) safar: bekor yoki
    // yakunlash (+ `cashPaid`). `fare` o'zgarmaydi (faqat eski, fare'siz
    // safarda 0 yoziladi — `_completeMarshrutRide`).
    function marshrutDriverAcceptedUpdate(uid, d, prev, k) {
      return phoneDocIdsMatch(uid, prev.get('acceptedDriverId', ''))
          && prev.status == 'accepted'
          && (
            (d.status == 'cancelled' && d.get('cancelledBy', '') == 'driver'
                && phoneDocIdsMatch(uid, d.get('cancelledByPhone', uid))
                && k.hasOnly(['status', 'cancelledBy', 'cancelledByPhone',
                              'cancelReason', 'notifyPassengerReroute',
                              'cancelledAt']))
            || (d.status == 'completed'
                && phoneDocIdsMatch(uid, d.get('completedBy', ''))
                && d.get('cashPaid', 0) is int
                && d.get('cashPaid', 0) >= 0
                && k.hasOnly(['status', 'completedBy', 'completedAt',
                              'cashPaid', 'fare'])
                && (!k.hasAny(['fare'])
                    || (prev.get('fare', null) == null && d.fare == 0)))
          );
    }

    function marshrutTripLifecycleUpdate() {
      let uid = userDocIdFromPhoneToken();
      let d = request.resource.data;
      let prev = resource.data;
      let k = d.diff(prev).affectedKeys();
      return uid != ''
          && prev.get('taxiType', '') == 'marshrut'
          && (marshrutPaxUpdate(uid, d, prev, k)
              || marshrutDriverOfferUpdate(uid, d, prev, k)
              || marshrutDriverAcceptedUpdate(uid, d, prev, k));
    }

    // Marshrut haydovchisi o'ziga yo'naltirilgan / qabul qilgan safarlarni
    // ro'yxat so'rovi bilan o'qiydi (`watchPendingForDriver`,
    // `watchAcceptedForDriver` — `targetDriverId` / `acceptedDriverId`
    // bo'yicha). Avval faqat `driverPhone` tekshirilardi — rules filtr
    // emas, shuning uchun bu so'rovlar RAD etilardi (emulator, 2026-10-08).
    function tripMarshrutDriverRead() {
      let uid = userDocIdFromPhoneToken();
      return uid != ''
          && (resource.data.get('targetDriverId', '') == uid
              || resource.data.get('acceptedDriverId', '') == uid
              || phoneDocIdsMatch(uid, resource.data.get('targetDriverId', ''))
              || phoneDocIdsMatch(uid, resource.data.get('acceptedDriverId', '')));
    }

    function localTripPassengerPatchFields() {
      // status бу ерда ЙЎҚ — cancel алоҳида (isPassengerCancel).
      return [
        'targetDriverId', 'targetedAt',
        'radiusKm',
        'passengerWalletIntent', 'passengerWalletUpdatedAt',
      ];
    }

    function localTripPassengerCancelFields() {
      return [
        'status', 'cancelledBy', 'cancelReason', 'cancelledAt'
      ];
    }

    // Yo'lkira qulfi (lockedFare, toAddr, tariffVersion ...) — FAQAT server
    // (`createLocalTaxiTrip` / `lockLocalTripFare`), ega qarori 2026-10-07.
    // Avval yo'lovchi ham, haydovchi ham `lockedFare`ni istalgan qiymatga
    // yoza olardi (local_taxi_rules.test.js B5/B6).

    // Eski ilova to'g'ridan yaratadigan trip (rides_repository.createSearchRequest).
    // Pul/narx maydonlari YO'Q — bunday trip'da hamyon yechilmaydi (completeLocalTrip).
    function localTripLegacyCreateFields() {
      return [
        'status', 'userPhone', 'userName', 'userGender', 'userBirthDate',
        'fromAddr', 'toAddr', 'fromLat', 'fromLng', 'toLat', 'toLng',
        'geohash4', 'taxiType', 'radiusKm', 'driverId', 'driverName',
        'price', 'cancelCount', 'createdAt', 'expiresAt',
        'regionId', 'districtId', 'serviceAreaId'
      ];
    }

    function localTripDriverAcceptFields() {
      return [
        'status', 'acceptedDriverId', 'acceptedDriverName', 'acceptedDriverPhone',
        'acceptedDriverCar', 'acceptedDriverPlate', 'driverId', 'driverName',
        'driverPhone', 'acceptedAt'
      ];
    }

    function localTripDriverReleaseFields() {
      return [
        'status', 'acceptedDriverId', 'acceptedDriverName', 'acceptedDriverPhone',
        'acceptedDriverCar', 'acceptedDriverPlate', 'driverId', 'driverName',
        'driverPhone', 'reservedBy', 'reservedByName', 'reservedAt'
      ];
    }

    // Mahalliy taksi — passenger / broadcast accept / abandon / fare-lock.
    // Yakunlash faqat CF `completeLocalTrip` (client completed yozishi taqiqlangan).
    function localTripLifecycleUpdate() {
      let d = request.resource.data;
      let prev = resource.data;
      let uid = userDocIdFromPhoneToken();
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();

      // Status o'zgarmaydi — radius / wallet / legacy target maydonlari.
      let isPassengerPatch = uid == prev.userPhone
          && d.status == prev.status
          && prev.status in ['searching', 'accepted']
          && affectedKeys.hasOnly(localTripPassengerPatchFields());

      // Faqat cancelled; completed/expired/accepted yo'q.
      let isPassengerCancel = uid == prev.userPhone
          && prev.status in ['searching', 'pending', 'accepted']
          && d.status == 'cancelled'
          && d.cancelledBy in ['passenger', 'user']
          && d.keys().hasAll(['status', 'cancelledBy', 'cancelledAt'])
          && affectedKeys.hasOnly(localTripPassengerCancelFields());

      // Muddati o'tgan qidiruv qabul qilinmaydi (release'dan keyin — releasedAt+3m).
      let searchOpen = !('expiresAt' in prev)
          || prev.expiresAt > request.time
          || ('releasedAt' in prev && prev.releasedAt is timestamp
              && prev.releasedAt + duration.value(3, 'm') > request.time);

      // Haydovchi ≠ yo'lovchi (2026-10-08): avval haydovchi O'Z buyurtmasini
      // qabul qilib, `completeLocalTrip` orqali yakunlay olardi — hamyon
      // ko'chmaydi (CF tekshiradi), lekin yo'lovchi bekor-blokini
      // (`resetLocalTaxiCancelBlock`) va safar statistikasini soxtalashtirardi.
      let isBroadcastAccept = prev.status == 'searching'
          && searchOpen
          && d.status == 'accepted'
          && uid == d.acceptedDriverId
          && uid == d.driverId
          && !phoneDocIdsMatch(uid, phoneDigits(prev.get('userPhone', '')))
          && approvedDriverForTaxi(uid, prev.taxiType)
          && affectedKeys.hasOnly(localTripDriverAcceptFields());

      // «Етиб келдим» — фақат шу сафарга бириктирилган ҳайдовчи, фақат
      // `accepted` ҳолатида, фақат `arrivedAt` майдонини, ва фақат БИР
      // МАРТА (аввал бўш бўлса). Статус ўзгармайди — шунинг учун
      // якунлаш/бекор қилиш оқимларига таъсир қилмайди.
      let isDriverArrival = prev.status == 'accepted'
          && d.status == prev.status
          && (
            (prev.acceptedDriverId != '' && uid == prev.acceptedDriverId)
            || (prev.driverId != '' && uid == prev.driverId)
          )
          && !('arrivedAt' in prev)
          && affectedKeys.hasOnly(['arrivedAt'])
          && d.arrivedAt is timestamp;

      // Release'da `releasedAt` = server vaqti (ixtiyoriy). `expirePendingTrips`
      // qidiruv muddatini shundan +3 daqiqa hisoblaydi — aks holda eski
      // 3 daqiqalik `expiresAt` o'tgan bo'lib, trip darhol `expired` bo'lardi.
      let isDriverRelease = prev.status == 'accepted'
          && d.status == 'searching'
          && (
            (prev.acceptedDriverId != '' && uid == prev.acceptedDriverId)
            || (prev.driverId != '' && uid == prev.driverId)
          )
          && affectedKeys.hasOnly(
               localTripDriverReleaseFields().concat(['releasedAt', 'arrivedAt']))
          && (!('releasedAt' in affectedKeys) || d.releasedAt == request.time)
          // «Yetib keldim» — release'da faqat O'CHIRISH mumkin, qo'yish emas.
          && (!('arrivedAt' in affectedKeys) || !('arrivedAt' in d));

      return isAuth()
          && prev.taxiType in ['local', 'alone']
          && (
            isPassengerPatch
            || isPassengerCancel
            || isBroadcastAccept
            || isDriverArrival
            || isDriverRelease
          );
    }

    // TRIPS — taksi (Flutter + web mahalliy modul `taxiType: local` / marshrut).
    // Yaratishda Phone Auth talab qilinmaydi; yangilanishlar alohida shartlar bilan.
    function tripParticipantRead() {
      return isAuth()
          && phoneDocIdsMatch(
               userDocIdFromPhoneToken(),
               phoneDigits(resource.data.get('userPhone', '')));
    }

    function tripDriverRead() {
      return isAuth()
          && phoneDocIdsMatch(
               userDocIdFromPhoneToken(),
               phoneDigits(resource.data.get('driverPhone', '')));
    }

    // Broadcast offer: approved local/alone haydovchi searching trip'ni o'qishi mumkin.
    function tripLocalOfferRead() {
      return isAuth()
          && resource.data.status == 'searching'
          && resource.data.taxiType in ['local', 'alone']
          && approvedDriverForTaxi(
               userDocIdFromPhoneToken(), resource.data.taxiType);
    }

    match /trips/{tripId} {
      allow read: if isStaff()
          || tripParticipantRead()
          || tripDriverRead()
          || tripMarshrutDriverRead()
          || tripLocalOfferRead();

      // Яратиш. Yangi ilova mahalliy taksini CF `createLocalTaxiTrip` orqali
      // yaratadi (server narxi). Bu shoxcha — eski ilova uchun: faqat O'Z
      // telefoni nomidan va narx/hamyon maydonlarisiz (avval istalgan userPhone
      // + passengerWalletIntent bilan yaratib, begona hamyonni yechish mumkin edi).
      allow create: if isAuth() && (
          (
            request.resource.data.keys().hasAll(['userPhone', 'fromAddr', 'status', 'taxiType'])
            && request.resource.data.keys().hasOnly(localTripLegacyCreateFields())
            && request.resource.data.status == 'searching'
            && request.resource.data.taxiType in ['local', 'alone']
            && request.resource.data.get('driverId', '') == ''
            && userDocIdFromPhoneToken() != ''
            && phoneDocIdsMatch(
                 userDocIdFromPhoneToken(),
                 phoneDigits(request.resource.data.userPhone))
          )
          || (
            request.resource.data.keys().hasAll(['userPhone', 'pickupAddr', 'status', 'taxiType'])
            && request.resource.data.taxiType == 'marshrut'
            && request.resource.data.status in ['pending', 'searching']
            && request.resource.data.userPhone.matches('^[0-9]{9,15}$')
            // Faqat O'Z nomidan (avval begona `userPhone` bilan ham
            // yaratish mumkin edi; ilova buyurtmani faqat telefon
            // sessiyasidan keyin beradi — marshrut_waiting_controller).
            && userDocIdFromPhoneToken() != ''
            && phoneDocIdsMatch(
                 userDocIdFromPhoneToken(),
                 phoneDigits(request.resource.data.userPhone))
          )
      );

      // Янгилаш — marshrut whitelist + mahalliy eski qoidalar
      allow update: if isAdmin()
          || marshrutTripLifecycleUpdate()
          || localTripLifecycleUpdate();

      // Ўчириш — йўқ
      allow delete: if false;
    }

    // ══════════════════════════════════════
    // ORDERS — нон/овқат буюртмалар
    // ══════════════════════════════════════
    // Курьер ЎЗ ФАОЛ маршрутидаги буюртмани ўқийди (`courier_controller.dart`
    // → `getByIds(route.orderIds)`). `courier` — `isStaff()`да эмас
    // (D-SERVICE-4 / D-CLEAN-1), шунинг учун 2026-10-06 дан бери capability
    // курьер ўз маршрутини ҳам оча олмасди.
    //
    // Ишонч манбаи — сервер ёзган майдонлар: `courierId` ва `deliveryRouteId`
    // ни фақат `courierCreateRoute` / `courierRecoverOrphanRoute` ёзади
    // (клиент `update`и фақат staff'га), маршрутнинг `courierId`ни курьер
    // ўзгартира олмайди (`delivery_routes` қоидаси). Маршрут тугагач
    // (`completed`) ўқиш ёпилади — мижоз телефони/манзили курьерда абадий
    // очиқ қолмасин (40-қоида).
    //
    // `ready` РЎЙХАТИ бу ердан ОЧИЛМАЙДИ: қоида майдонларни кеса олмайди,
    // курьерга эса олишдан олдин фақат МФЙ ва координата керак —
    // `courierListReadyOrders` callable.
    //
    // Тест: functions/test/orders_courier_rules.test.js
    function isActiveRouteCourierOfOrder() {
      let me = userDocIdFromPhoneToken();
      let routeId = resource.data.get('deliveryRouteId', '');
      let routePath = /databases/$(database)/documents/delivery_routes/$(routeId);
      return me != ''
          && routeId is string && routeId != ''
          && phoneDocIdsMatch(me, string(resource.data.get('courierId', '')))
          && exists(routePath)
          && get(routePath).data.get('status', '') in ['ready', 'active']
          && phoneDocIdsMatch(me, string(get(routePath).data.get('courierId', '')));
    }

    // Ресторан а'зоси ўз ресторанининг буюртмаларини ўқийди (`type:
    // 'restaurant'`, restaurant_orders.js). get — `.get()` билан; list —
    // фақат тўғридан-тўғри майдон: сўров `where restaurantId == X` бўлиши
    // шарт (`.get()` default тузоғи — хотира). Тест: restaurant_rules.test.js
    function isRestaurantMemberOfOrderGet() {
      let rid = resource.data.get('restaurantId', '');
      return isAuth() && rid is string && rid != '' && isRestaurantMember(rid);
    }
    function isRestaurantMemberOfOrderList() {
      return isAuth()
          && resource.data.restaurantId is string
          && isRestaurantMember(resource.data.restaurantId);
    }

    // КУРЬЕРНИНГ ЖОНЛИ ЖОЙИ — буюртма бўйича (S6, эга 2026-10-19: мижоз ва ресторан эгаси курьерни кузатсин).
    // `order_courier_live/{orderId}`: ФАҚАТ шу буюртмага биринчи бўлиб тайинланган курьер ёзади ва ФАҚАТ
    // буюртма фаол ҳолатларда (қабул қилинган…етказиш), ўқийди — буюртма эгаси (мижоз), шу ресторан а'золари
    // ва админ. Курьернинг умумий жойлашуви (`provider_presence`) ҳамон ёпиқ: бу ерда фақат битта буюртма
    // давомидаги нуқта (40-қоида). Терминал ҳолатда сервер ҳужжатни ўчиради (+ соатлик супуриш).
    function liveOrderData(oid) {
      return get(/databases/$(database)/documents/orders/$(oid)).data;
    }
    function liveOrderActive(o) {
      return o.get('type', '') == 'restaurant'
          && o.get('restaurantStatus', '') in ['accepted', 'ready', 'picked', 'arrived'];
    }
    function liveIsCourierOf(o) {
      let me = userDocIdFromPhoneToken();
      return me != '' && phoneDocIdsMatch(me, string(o.get('courierId', '')));
    }
    function liveWriteOk(oid) {
      let d = request.resource.data;
      return exists(/databases/$(database)/documents/orders/$(oid))
          && liveOrderActive(liveOrderData(oid))
          && liveIsCourierOf(liveOrderData(oid))
          && d.keys().hasOnly(['orderId', 'courierId', 'lat', 'lng', 'heading', 'speed', 'accuracy', 'updatedAt'])
          && d.keys().hasAll(['orderId', 'lat', 'lng', 'updatedAt'])
          && d.orderId == oid
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && (!('heading' in d) || (d.heading is number && d.heading >= 0 && d.heading <= 360))
          && (!('speed' in d) || (d.speed is number && d.speed >= 0 && d.speed <= 100))
          && (!('accuracy' in d) || (d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100000))
          && (!('courierId' in d) || (d.courierId is string && phoneDocIdsMatch(userDocIdFromPhoneToken(), d.courierId)))
          && d.updatedAt == request.time;
    }
    match /order_courier_live/{oid} {
      allow get: if isAuth() && exists(/databases/$(database)/documents/orders/$(oid)) && (
          isAdmin()
          || phoneDocIdsMatch(phoneFromToken(), phoneDigits(liveOrderData(oid).get('userPhone', '')))
          || isRestaurantMember(liveOrderData(oid).get('restaurantId', '_'))
      );
      allow list: if false;
      allow create, update: if isAuth() && liveWriteOk(oid);
      allow delete: if isAuth() && (
          isAdmin()
          || (exists(/databases/$(database)/documents/orders/$(oid)) && liveIsCourierOf(liveOrderData(oid)))
      );
    }

    match /orders/{orderId} {
      allow get: if isAuth() && (
          isStaff()
          || phoneDocIdsMatch(phoneFromToken(), phoneDigits(resource.data.userPhone))
          || isActiveRouteCourierOfOrder()
          || isRestaurantMemberOfOrderGet()
      );
      // `list` — курьер йўли ЙЎҚ (юқорига қаранг).
      allow list: if isAuth() && (
          isStaff()
          || phoneDocIdsMatch(phoneFromToken(), phoneDigits(resource.data.userPhone))
          || isRestaurantMemberOfOrderList()
      );

      // Яратиш / бекор — фақат CF (placeOrderPostPaid / customerCancelOrder).
      allow create: if false;

      // Статус/курьер майдонлари — фақат staff (courier|seller|…) ёки админ.
      // Олдин authсиз update бўлган — чужой заказ «delivered» қилиш мумкин эди.
      allow update: if isAdmin()
          || (
            isStaff()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'deliveredAt', 'courierId', 'status', 'updatedAt',
                  'statusUpdatedAt', 'fulfillmentStatus'
                ])
          );

      allow delete: if false;

      match /payment_lines/{lineId} {
        allow read: if isAuth() && (
            isStaff()
            || phoneDocIdsMatch(phoneFromToken(), phoneDigits(resource.data.userPhone))
        );
        allow write: if false;
      }
      match /payment_events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // Ресторан буюртмаси ҳодисалари (append-only, CF) — эга, ресторан
      // а'зоси, staff. Ота ҳужжат бир марта `get()` қилинади.
      function restaurantOrderParent() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data;
      }
      match /order_events/{eventId} {
        allow read: if isAuth() && (
            isStaff()
            || phoneDocIdsMatch(phoneFromToken(),
                 phoneDigits(restaurantOrderParent().get('userPhone', '')))
            || (restaurantOrderParent().get('restaurantId', '') != ''
                && isRestaurantMember(restaurantOrderParent().get('restaurantId', '')))
        );
        allow write: if false;
      }
      // `private/secrets` — pickupCode: фақат ресторан (курьерга оғзаки
      // айтади) ва админ; мижоз ва курьер ўқимайди.
      match /private/{doc} {
        allow read: if isAdmin() || (
            isAuth()
            && restaurantOrderParent().get('restaurantId', '') != ''
            && isRestaurantMember(restaurantOrderParent().get('restaurantId', ''))
        );
        allow write: if false;
      }
    }

    // ══════════════════════════════════════
    // CARPET WASH — gilam yuvish buyurtmalari
    // ══════════════════════════════════════
    match /carpet_wash_orders/{orderId} {
      allow read: if isAuth() && (
          isStaff()
          || phoneDocIdsMatch(
              phoneFromToken(),
              phoneDigits(resource.data.customerPhone),
          )
      );
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════
    // AGRO PICKUP — sut qabul va h.k.
    // ══════════════════════════════════════
    match /agro_pickup_orders/{orderId} {
      allow read: if isAuth() && (
          isStaff()
          || phoneDocIdsMatch(
              phoneFromToken(),
              phoneDigits(resource.data.customerPhone),
          )
      );
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════
    // SCHEDULES — кундалик иш санаси
    // ══════════════════════════════════════
    match /schedules/{scheduleId} {
      allow read: if true;
      // R-7: yangi ish kuni = PUBLISH → `taxiCanPublish` (verification_required
      // da yo'q). Egalik ham tekshiriladi — avval yo'q edi: tasdiqlangan
      // haydovchi BOSHQA haydovchi nomidan jadval yaratishi mumkin edi.
      allow create: if request.resource.data.keys().hasAll(['driverId', 'taxiType', 'date', 'seats', 'isActive'])
          && (isOwner(request.resource.data.driverId) || isAdmin())
          && taxiCanPublish(request.resource.data.driverId, request.resource.data.taxiType);
      // Faqat egasi/admin (2-bosqich; avval `scheduleLifecyclePatchOnly()`
      // auth'siz jadvalni o'chirardi, 1-bosqichda yo'lovchi shakli qolgandi).
      allow update: if isAdmin() || isOwner(resource.data.driverId);
      allow delete: if false;
    }

    // ══════════════════════════════════════
    // RATINGS — рейтинглар (transaction учун)
    // ══════════════════════════════════════
    match /ratings/{ratingId} {
      allow read:   if true;
      allow create: if isAuth()
          && request.resource.data.keys().hasAll(['driverId', 'stars', 'userPhone']);
      allow update: if false;
      allow delete: if false;
    }

    // ══════════════════════════════════════
    // BREAD / EXTRA PRODUCTS / FOOD INVENTORY
    // ══════════════════════════════════════
    match /bread_products/{id} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /extra_products/{id} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // «Овқат» модули олиб ташланди (эга, 2026-10-11): ҳеч ким ёзолмайди.
    // Прод маълумоти 2026-10-11 да тозаланди (коллекция бўш). Ўқиш атайлаб
    // ОЧИҚ қолади: эски APK'лар (POS, захира) шу коллекцияни тинглайди —
    // блок олиб ташланса default deny permission хатоси беради. Эски APK'лар
    // тугагач бу блок ва `food_inventory` блоки олиб ташланади.
    match /food_catalog/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /platform_products/{id} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Глобал қидирув индекси — read:true; write фақат CF (Admin SDK).
    match /search_index/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // «Овқат» олиб ташланди (2026-10-11) — `food_catalog` изоҳига қаранг.
    match /food_inventory/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /procurement_products/{code} {
      allow read: if isAuth();
      allow create, update: if isAdmin()
          && request.resource.data.keys().hasAll([
            'code', 'label', 'unit', 'price', 'active', 'updatedAt'
          ])
          && request.resource.data.code is string
          && request.resource.data.label is string
          && request.resource.data.unit is string
          && request.resource.data.price is int
          && request.resource.data.price >= 0
          && request.resource.data.active is bool;
      allow delete: if false;
    }

    // ══════════════════════════════════════
    // SUPPORT CHAT
    // ══════════════════════════════════════
    // chatId == userPhone digits.
    //
    // ИЛДИЗ САБАБ: аввал бу ерда `request.auth.uid == chatId` ёзилган эди.
    // Лекин `chatId` — телефон рақами, `request.auth.uid` эса Phone Auth'да
    // Firebase берган тасодифий сатр. Яъни шарт оддий фойдаланувчи учун
    // ҳеч қачон бажарилмасди: у ўз чатининг ота ҳужжатини ўқий ҳам,
    // ёза ҳам олмасди (`sendMessage` → PERMISSION_DENIED). Шу сабабли
    // `messages` субколлекцияси бутунлай очиб қўйилган эди:
    // `read: if true` ва `update: if true` — яъни 18 та шахсий ёрдам
    // суҳбати ҳар кимга очиқ, ва ҳар ким исталган хабарни қайта ёза оларди.
    //
    // Тузатиш: `isOwner(chatId)` қўшилди. Эски `auth.uid == chatId` йўли
    // САҚЛАНДИ — агар бирор клиент шу шаклда ишлаётган бўлса, бузилмасин
    // (орқага мослик). Субколлекция ҳам шу эгаликка боғланди.
    //
    // Тест: functions/test/support_chat_rules.test.js
    match /support_chats/{chatId} {
      allow read: if isAuth()
          && (isOwner(chatId) || request.auth.uid == chatId || isAdmin());
      // `awaitingAdmin` / `awaitingAdminMsgAt` — «жавоб кутмоқда» (админ
      // badge'и), фақат CF `onSupportChatMessageCreate` ёзади (аудит O-5).
      allow create: if isAuth()
          && (isOwner(chatId) || request.auth.uid == chatId)
          && !request.resource.data.keys()
              .hasAny(['awaitingAdmin', 'awaitingAdminMsgAt']);
      allow update: if isAuth()
          && (isOwner(chatId) || request.auth.uid == chatId || isAdmin())
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['awaitingAdmin', 'awaitingAdminMsgAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuth()
            && (isOwner(chatId) || request.auth.uid == chatId || isAdmin());
        // Клиент fromAdmin: true ёза олмайди (faqat Admin SDK / CF).
        // fromAdmin майдони йўқ ёки false — рухсат (веб admin.html ҳам шу форматда ёзади).
        allow create: if isAuth()
            && (isOwner(chatId) || request.auth.uid == chatId || isAdmin())
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000
            && (
              !request.resource.data.keys().hasAny(['fromAdmin'])
              || request.resource.data.fromAdmin == false
            );
        allow update: if isAuth()
            && (isOwner(chatId) || request.auth.uid == chatId || isAdmin());
        allow delete: if false;
      }
    }

    // ══════════════════════════════════════
    // ADMIN_NEWS — админ томонидан фойдаланувчиларга юбориладиган хабарлар
    // ══════════════════════════════════════
    //
    // Аввалги изоҳ «Firebase Auth йўқ, admin role'ни rules'да текшира
    // олмаймиз» дерди — эскирган: админ панел ва мобил кириш token'га
    // `phone_number` claim қўяди, `isAdmin()` ишлайди. Create/update'да
    // ҳеч қандай auth йўқ эди: ҳар ким (ҳатто кирмаган) хабар яратиб,
    // `onAdminNewsCreate` орқали БАРЧА фойдаланувчига push юбора олар,
    // `pushResendAt`ни ўзгартириб push'ни қайта-қайта жўнатарди.
    //
    // Ёзувчилар: админ «Хабарлар» compose (`NewsRepository.create`) ва
    // «Push qayta yuborish» (`requestPushResend`); буюртма чеклари ва
    // ҳолат хабарлари — CF (Admin SDK, rules'дан ташқари).
    //
    // ⚠ Ўқиш ҳали `if true`: CF шахсий чекларни (`targetUserId`, манзил,
    // сумма) ҳам шу ерга ёзади. Ёпиш учун илова сўровини
    // (`NewsRepository` — `orderBy createdAt limit 50`) аввал янги версияда
    // ўзгартириш керак (ҳозирги сўров ёпиқ қоидада бутунлай рад бўлади).
    //
    // Тест: functions/test/admin_panel_audit_rules.test.js
    match /admin_news/{newsId} {
      // Ўқиш — барча фойдаланувчилар (фильтр client-side).
      allow read: if true;

      // Яратиш — фақат админ; мажбурий майдонлар ва типлар тeкширилaди.
      // category ва audience aniq qiymatlardан bo'lsin.
      allow create: if isAdmin()
          && request.resource.data.keys()
              .hasAll(['title', 'body', 'category', 'audience', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.category in
              ['info', 'update', 'promo', 'warning', 'emergency']
          && request.resource.data.audience in
              ['all', 'user', 'driver', 'courier'];

      // Янгилаш — фақат админ; `createdAt` ўзгармасин, title/body
      // размeри чегаралaнсин.
      allow update: if isAdmin()
          && notChanged('createdAt')
          && (
            !('title' in request.resource.data)
            || request.resource.data.title.size() <= 120
          )
          && (
            !('body' in request.resource.data)
            || request.resource.data.body.size() <= 2000
          );

      // Ўчириш — вақтинча тақиқланди. Phone Auth + isAdmin() бўлгач очилади.
      allow delete: if false;
    }

    // ══════════════════════════════════════
    // NOTIFICATIONS — FCM орқали хабар (илова listener + update sent)
    // ══════════════════════════════════════
    match /intercity_booking_locks/{lockId} {
      // Аввал `read: if true` ва `create, update: if true` эди — яъни ҳар
      // ким янги қулф яратиб ҳайдовчининг ўриндиқларини банд қила оларди
      // ёки бошқа йўловчининг қулфини ўзгартира оларди.
      //
      // Репо бўйича текширилди: Flutter иловаси бу коллекцияга УМУМАН
      // тегмайди (`lib/` да битта ҳам ҳавола йўқ). Ёзувчи — Cloud
      // Functions (`functions/index.js:9920, :10120`), Admin SDK орқали,
      // яъни қоидалардан ўтмайди.
      //
      // `delete` ўзгартирилмади — у аллақачон auth ва эгалик билан
      // ҳимояланган.
      //
      // Тест: functions/test/booking_locks_rules.test.js
      allow read: if isAdmin();
      allow create, update: if false;
      // cancelBooking — mijoz yoki haydovchi o'z qulfini ochadi (delete CF/admin);
      // mijoz cancel: bookingId tozalash (update if true) — delete auth talab qiladi
      allow delete: if isAuth() && (
          phoneDocIdsMatch(userDocIdFromPhoneToken(), resource.data.userKey)
          || isOwner(resource.data.driverId)
      );
    }

    match /intercity_passenger_locks/{userPhone} {
      allow read: if request.auth != null
          && phoneDocIdsMatch(
               userDocIdFromPhoneToken(), userPhone);
      allow create, update: if request.auth != null
          && phoneDocIdsMatch(
               userDocIdFromPhoneToken(), userPhone);
      allow delete: if request.auth != null
          && (phoneDocIdsMatch(
                userDocIdFromPhoneToken(), userPhone)
              || isAdmin()
              || (isAuth()
                  && resource.data.driverId != null
                  && phoneDocIdsMatch(
                       userDocIdFromPhoneToken(),
                       resource.data.driverId)));
    }

    match /notifications/{notificationId} {
      // Аввал `read: if true` ва `create` да auth умуман йўқ эди.
      // Иккинчиси жиддийроқ: `onNotificationCreate` бу ёзувни кўриб
      // ҳақиқий push юборади, яъни ташқаридан ҳар ким исталган рақамга
      // ихтиёрий матнли push жўната оларди (спам/фишинг йўли).
      //
      // `create` бутунлай ёпилмайди: клиентнинг БОШҚА фойдаланувчига
      // хабар ёзиши — маҳсулот оқими (`NotificationDelivery.write()`,
      // lib/services/notification_delivery.dart:181). Шунинг учун
      // минимал қаттиқлаштириш: `isAuth()`. Тезлик чегараси қоидада
      // ифодаланмайди — у CF вазифаси.
      //
      // Ўқиш/янгилаш эгасига боғланади. Клиент айнан шундай сўрайди:
      //   fcm_service.dart:92 · driver_force_leave_service.dart:82
      //   where targetPhone == alias && sent == false
      // `phoneAliases()` 9 ва 12 хонали шаклни беради, `isOwner()`
      // иккаласини ҳам қабул қилади.
      //
      // Тест: functions/test/notifications_rules.test.js
      allow read: if isAdmin() || isOwner(resource.data.targetPhone);
      // Яратишда: барча майдонлар бўлсин + sent мажбурий false
      allow create: if isAuth()
          && request.resource.data.keys().hasAll(['targetPhone', 'title', 'body', 'sent'])
          && request.resource.data.sent == false;
      // Янгилашда: фақат qabul qiluvchi (yoki admin) `sent`ни true qiladi.
      allow update: if (isAdmin() || isOwner(resource.data.targetPhone))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sent'])
          && request.resource.data.sent == true;
      allow delete: if false;
    }

    // ══════════════════════════════════════
    // CONFIG — yo'lovchi blok qoidalari va boshqa server sozlamalar
    // (shu jumladan `config/module_defaults` — global modul baseline)
    // ══════════════════════════════════════
    match /config/{docId} {
      allow read: if true;
      // `module_defaults` — фақат `adminSaveModuleConfig` (сервер: ўзгарган
      // катаклар, конфликт текшируви, `admin_audit`; эга, 2026-10-08).
      // Клиентдан тўғридан-тўғри ёзиш аудитни четлаб ўтарди.
      allow write: if isAdmin() && docId != 'module_defaults';
    }

    // ══════════════════════════════════════
    // GEO IERARXIYA + MODUL KONFIGI (configuration-driven platform)
    //   geo_regions / geo_districts / service_areas — ierarxiya
    //   geo_district_modules — tuman (region) override
    //   service_area_modules — MFY bo'yicha modul override
    // Hammaga o'qish ochiq (Home dinamik qurish + onboarding kaskadi),
    // yozish faqat admin.
    // ══════════════════════════════════════
    match /geo_regions/{regionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /geo_districts/{districtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /service_areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // МФЙ ва туман модул override'и — фақат `adminSaveModuleConfig` (аудит
    // билан, эга 2026-10-08); клиент ёзуви ёпиқ.
    match /service_area_modules/{areaId} {
      allow read: if true;
      allow write: if false;
    }

    match /geo_district_modules/{districtId} {
      allow read: if true;
      allow write: if false;
    }

    // ══════════════════════════════════════
    // SETTINGS — нархлар ва бошқа созламалар
    // ══════════════════════════════════════
    match /settings/{docId} {
      // `wallet_bot` (депозит картаси, авто-тасдиқ, ечиш лимити) — фақат
      // CF (`adminGet/SetWalletBotSettings`, finance/superadmin). Аввал ҳар
      // ким ўқий, ҳар қандай админ роли (dispatcher ҳам) тўғридан-тўғри
      // ёзиб депозитни бошқа картага йўналтира оларди. Илова бу ҳужжатни
      // умуман ўқимайди. Тест: functions/test/admin_panel_audit_rules.test.js
      allow read: if docId != 'courier' && docId != 'tv_social'
          && docId != 'wallet_bot';
      // prices/app/anomaly — фақат isAdmin (олдин очиқ update бўлган).
      // `prices` ичидаги маҳаллий такси тарифи — фақат CF
      // `adminSetLocalTaxiPrices` (версия + тарих, эга қарори 2026-10-07);
      // нон нархлари (bread_repository.updatePrices) аввалгидек.
      // `anomaly_settings` — панелдаги каби фақат superadmin.
      // `restaurant_delivery` (кафе-ресторан етказиш тарифи) — фақат CF
      // `adminSetRestaurantDeliveryPrices` (версия + тарих + audit, 9/41-банд).
      // `all_orders_stuck` («Барча буюртмалар» чегаралари) — фақат CF/Admin
      // SDK: ўзгариш audit'сиз бўлмасин (41-банд).
      allow create, update: if isAdmin() && docId != 'tv_social'
          && docId != 'wallet_bot'
          && docId != 'restaurant_delivery'
          && docId != 'restaurant_sections'
          && docId != 'restaurant_bookings'
          && docId != 'restaurant_seasons'
          && docId != 'restaurant_ramadan'
          && docId != 'all_orders_stuck'
          && (docId != 'anomaly_settings' || isSuperAdmin())
          && (
            docId != 'prices'
            || !request.resource.data.diff(
                 resource == null ? {} : resource.data).affectedKeys()
                 .hasAny(['local_base', 'local_per_km', 'local_coef', 'regions',
                          'local_night_coef', 'local_night_start', 'local_night_end',
                          'local_road_factor',
                          'localTariffVersion', 'localTariffUpdatedAt',
                          'localTariffUpdatedBy'])
          );
      allow delete: if false;
    }

    // Маҳаллий такси тариф тарихи — ўзгармас, фақат CF ёзади.
    match /local_taxi_tariffs/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Кафе-ресторан етказиш тарифи тарихи (`v{n}`) — ўзгармас, фақат CF
    // (`adminSetRestaurantDeliveryPrices`). Тест: restaurant_rules.test.js
    match /restaurant_delivery_tariffs/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Кафе-ресторан бўлимлари созламаси (`settings/restaurant_sections`) тарихи (`v{n}`) —
    // ўзгармас, фақат CF (`adminSetRestaurantSections`, версия + audit, 9/41-банд).
    match /restaurant_sections_history/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Кафе-ресторан стол бронь созламаси (`settings/restaurant_bookings`) тарихи (`v{n}`) —
    // ўзгармас, фақат CF (`adminSetRestaurantBookings`, версия + audit, 9/41-банд).
    match /restaurant_bookings_history/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Мавсумий бўлимлар (`settings/restaurant_seasons`) ва Рамазон жадвали (`settings/restaurant_ramadan`) тарихи (`v{n}`) —
    // ўзгармас, фақат CF (`adminSetRestaurantSeasons`, `adminSetRestaurantRamadan`, `ensureRestaurantSeasons`; версия + audit).
    match /restaurant_seasons_history/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /restaurant_ramadan_history/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Yo'l koeffitsienti — haftalik CF hisobi (joriy + runs tarixi).
    match /local_taxi_calibration/{doc=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Page/IG токенлари — фақат Cloud Functions (Admin SDK).
    match /settings/tv_social {
      allow read, write: if false;
    }

    match /settings/courier {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Moy almashtirish — punktlar va bronlar
    match /oil_change_services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /oil_change_bookings/{bookingId} {
      allow read: if isAuth() && (
        isAdmin()
        || resource.data.uid == userDocIdFromPhoneToken()
      );
      allow create: if isAuth()
          && request.resource.data.uid == userDocIdFromPhoneToken()
          && request.resource.data.keys().hasAll([
            'uid', 'vehicleId', 'packageId', 'servicePointId', 'slotAt', 'status'
          ])
          && request.resource.data.status == 'new';
      allow update: if isAdmin()
          || (
            isAuth()
            && resource.data.uid == userDocIdFromPhoneToken()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'cancelled'
          );
      allow delete: if false;
    }

    // Moy/filtr katalogi (admin write, hammaga read)
    match /oil_change_catalog/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bosh ekran begushchaya qator — admin web (PIN) to'g'ridan yozadi.
    function homeTickerAdPayloadOk() {
      return (
            !('text' in request.resource.data)
            || (
              request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 500
            )
          )
          && (
            !('audience' in request.resource.data)
            || request.resource.data.audience in
                ['all', 'user', 'driver', 'courier', 'admin']
          )
          && (
            !('module' in request.resource.data)
            || request.resource.data.module in ['home_search']
          )
          && (
            !('durationSec' in request.resource.data)
            || (
              request.resource.data.durationSec is int
              && request.resource.data.durationSec >= 5
              && request.resource.data.durationSec <= 120
            )
          )
          && (
            !('scrollSpeed' in request.resource.data)
            || (
              request.resource.data.scrollSpeed is int
              && request.resource.data.scrollSpeed >= 15
              && request.resource.data.scrollSpeed <= 120
            )
          )
          && (
            !('priority' in request.resource.data)
            || request.resource.data.priority is int
          )
          && (
            !('active' in request.resource.data)
            || request.resource.data.active is bool
          )
          && (
            !('activeFrom' in request.resource.data)
            || request.resource.data.activeFrom is timestamp
          )
          && (
            !('activeTo' in request.resource.data)
            || request.resource.data.activeTo is timestamp
          )
          && (
            !('animationStyle' in request.resource.data)
            || request.resource.data.animationStyle in
                [
                  'auto', 'marquee', 'typewriter', 'cascade', 'fade_in', 'slide_in',
                  'fit_fade', 'fit_lines', 'fit_words', 'fit_pulse', 'fit_pop'
                ]
          )
          && (
            !('fontSize' in request.resource.data)
            || (
              request.resource.data.fontSize is int
              && request.resource.data.fontSize >= 10
              && request.resource.data.fontSize <= 24
            )
          );
    }

    match /home_ticker_ads/{adId} {
      allow read: if true;
      allow create: if isAdmin()
          && homeTickerAdPayloadOk()
          && request.resource.data.keys().hasAll([
            'text', 'audience', 'active', 'priority',
            'durationSec', 'scrollSpeed', 'animationStyle', 'fontSize',
            'createdAt', 'updatedAt'
          ]);
      allow update: if isAdmin()
          && homeTickerAdPayloadOk()
          && notChanged('createdAt');
      allow delete: if isAdmin();
    }

    // Мобил ариза — marshrut/intercity маршрут майдонлари билан.
    function driverRequestGuestPatchKeys() {
      return [
        'name', 'phone', 'car', 'plate', 'taxiType', 'updatedAt',
        'routeFrom', 'routeTo', 'routeStops', 'routeLabel',
        'status', 'rejectedAt', 'rejectedReason', 'rejectedBy',
      ];
    }

    function driverRequestGuestPendingUpdateOk(id) {
      return resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.uid == id
          && request.resource.data.taxiType in ['intercity', 'marshrut', 'alone', 'local']
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(driverRequestGuestPatchKeys());
    }

    function driverRequestGuestResubmitOk(id) {
      return resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && request.resource.data.uid == id
          && request.resource.data.taxiType in ['intercity', 'marshrut', 'alone', 'local']
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(driverRequestGuestPatchKeys());
    }

    // ══════════════════════════════════════
    // DRIVER_REQUESTS / QUEUE — админ ва ҳайдовчи панели
    // ══════════════════════════════════════
    match /driver_requests/{id} {
      // 13.6.4 (0c) — аввал `isAdmin() || true` эди, яъни АМАЛДА
      // ҲАММАГА ОЧИҚ: ҳар ким барча аризачиларнинг исми, телефони ва
      // такси турини рўйхат сифатида юклаб олиши мумкин эди (40-қоида).
      //
      // `get` очиқ қолдирилади: аризачи ўз ҳолатини Phone Auth'дан
      // ОЛДИН ҳам текширади (`driver_repository.dart:227`,
      // `marshrut_driver_repository.dart:176`) — иккаласи ҳам ID
      // бўйича, `where` сўрови эмас. Рақамни билган одам фақат ўша
      // битта ҳужжатни кўради, рўйхатни эса — йўқ.
      //
      // `list` фақат админда: рўйхат сўровлари фақат админ
      // экранларида (`admin_shell.dart:955`,
      // `driver_applications_screen.dart:172`) ва аналитикада.
      // `isStaff()` ишлатилмайди — унинг рўйхатида `courier` ва
      // `seller` бор, улар эса ҳозир ўзига ўзи берилиши мумкин
      // (D-12 дан кейин бу ҳам тозаланади).
      //
      // Тест: functions/test/self_approval_rules.test.js
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
          || (
            isAuth()
            && request.resource.data.uid == id
            && request.resource.data.status == 'pending'
            && request.resource.data.taxiType in ['intercity', 'marshrut', 'alone', 'local']
            && request.resource.data.keys()
                .hasAll(['uid', 'name', 'phone', 'taxiType', 'status'])
          );
      allow update: if isAdmin()
          || driverRequestGuestPendingUpdateOk(id)
          || driverRequestGuestResubmitOk(id);
      allow delete: if false;
    }

    match /queue/{driverId} {
      // Эгаликка боғлаб бўлмайди: ЙЎЛОВЧИ рўйхат сўрайди
      // (`marshrut_search_controller.dart:366` — `where taxiType == 'marshrut'`)
      // ва бошқа ҳайдовчининг ҳужжатини ўқийди
      // (`rides_repository.dart:580`). Шунинг учун фақат `isAuth()` —
      // авторизациясиз скрейпинг ёпилади.
      //
      // ⚠️ ОЧИҚ ҚОЛДИ: ҳужжатда `driverPhone` бор ва у ҳар бир йўловчига
      // кўринади. Буни қоида ҳал қилмайди — маълумот модели ўзгариши
      // керак (телефон алоҳида, фақат фаол сафарда очиладиган жойга).
      //
      // Тест: functions/test/marshrut_misc_rules.test.js
      allow read: if isAuth();
      // R-7: navbatga kirish = PUBLISH (`taxiCanPublish`). `isOwner` yo'li
      // ham capability talab qiladi — aks holda huquqsiz odam o'z nomiga
      // navbat hujjati yaratib qo'yardi.
      allow create: if isAdmin()
          || (
            isOwner(driverId)
            && request.resource.data.driverId == driverId
            && taxiCanPublish(driverId, request.resource.data.taxiType)
          );
      // Oxirgi shoxcha OLIB TASHLANDI (2026-10-08): `driverId` o'zgarmasa
      // va capability bo'lsa — auth'siz HAR QANDAY maydon (driverPhone ham,
      // yo'lovchi aynan shu raqamga qo'ng'iroq qiladi). 2-bosqichda begona
      // yozuv yo'q — dispatch hisobi serverda (`closeMarshrutPendingOffer`).
      allow update: if isOwner(driverId) || isAdmin();
      allow delete: if false;
    }

    // ══════════════════════════════════════
    // INTERCITY / LOCAL TAXI / JOB
    // ══════════════════════════════════════
    // E'lon yoqilayotgan bo'lsa (`isActive: true`) `billingTripId` shart.
    function intercityPublishGateOk() {
      return request.resource.data.get('isActive', false) != true
          || (
            request.resource.data.get('billingTripId', '') is string
            && request.resource.data.get('billingTripId', '') != ''
          );
    }

    match /intercity_drivers/{id} {
      allow read: if true;
      // Haydovchi profili — admin / Phone Auth owner; anonim: schedule sync yoki seat patch
      // 2026-09-24 QA (ega qarori): e'lonni faqat EGASI (`isOwner(id)`,
      // id = haydovchi telefoni), admin yoki Admin SDK (CF) yozadi.
      //
      // Avval bu yerda auth/egalik talab qilmaydigan bir nechta yo'l bor edi
      // (`intercityDriverScheduleCreate/ScheduleSync/PanelPatch/
      // AutoAcceptPatch/ListingEnd`). `allow` — ILI-zanjir bo'lgani uchun
      // ulardan bittasi o'tsa yetardi: emulator testida begona (hatto anonim)
      // klient boshqa haydovchining `seats`, `price`, `from/to`, `stops`,
      // `routeLabel` ini qayta yozdi va `isActive: false` bilan reysini
      // o'chirdi. `isOwner(id)` haydovchining o'z "ishga chiqish" oqimini
      // to'liq qoplaydi (uchala chaqiruv ham o'z telefonini beradi), shuning
      // uchun o'sha yo'llar keraksiz — olib tashlandi.
      //
      // Faqat kino (entertainment) yo'llari qoldi: ular admin-web PIN
      // sirtidan keladi va `entertainmentAllowed`/`entertainmentIds` dan
      // boshqasiga tegmaydi.
      // D-TAXI-13 + D-CLEAN-1 (R-1 hard gate): egasi e'lonni (`isActive:
      // true`) FAQAT server bergan `billingTripId` bilan yoqadi — ya'ni
      // komissiya to'langan/`published` reys. Eski client-side publish
      // flow saqlanmaydi (ega qarori). `isActive: false` (yopish) va
      // boshqa maydonlar — erkin. Admin SDK (CF) qoidadan o'tmaydi.
      // Kino RUXSATI (`entertainmentAllowed`) — faqat admin: avvalgi
      // «admin-web PIN» yo'llari (`intercityDriverEntertainmentAllowed
      // Create/Patch`) auth talab qilmasdi — har kim istalgan haydovchiga
      // ruxsat yoqib/o'chira olardi. Admin web endi Phone Auth'da
      // (`isAdmin()`), yagona chaqiruvchi — Shaharlararo → Haydovchilar →
      // Kino switch (`EntertainmentRepository.setDriverEntertainmentAllowed`).
      allow create: if isAdmin()
          || (isOwner(id) && intercityPublishGateOk());
      allow update: if isAdmin()
          || (isOwner(id) && intercityPublishGateOk())
          || intercityDriverEntertainmentPatch();
      allow delete: if false;

      // Doimiy mijоз aggregation — bron transaction'ida
      match /clients/{phone} {
        // Bron transaction: faqat o'z telefonidagi client doc o'qiladi
        allow read: if isAdmin() || isOwner(id)
            || phoneDocIdsMatch(userDocIdFromPhoneToken(), phone);
        allow create, update: if intercityClientStatsPatch()
            || isAdmin()
            || isOwner(id);
        allow delete: if false;
      }
    }

    // ══════════════════════════════════════
    // ENTERTAINMENT — safar kino katalogi (B variant)
    // ══════════════════════════════════════
    // Avval `|| entertainmentCatalogCreate()` / `ActivePatch()` («admin web
    // PIN») auth talab qilmasdi: har kim (hatto kirmagan) istalgan
    // `downloadUrl` bilan film qo'sha yoki filmlarni yoqib/o'chira olardi.
    // Yagona yozuvchi — admin web «Kino katalogi» tabi (Phone Auth, `isAdmin()`).
    match /entertainment_catalog/{videoId} {
      allow read: if true;
      allow create: if isAdmin() && entertainmentCatalogCreate();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ══════════════════════════════════════
    // INTERCITY BOOKINGS — шаҳарлараро ишончли бронлар
    // ══════════════════════════════════════
    match /intercity_bookings/{bookingId} {
      allow read: if intercityBookingParticipantRead();

      // Яратиш — 2026-09-24 QA: client endi TO'G'RIDAN-TO'G'RI create QILA
      // OLMAYDI. Faqat `intercityCreateBooking` callable (Admin SDK) yoki
      // admin. Sabab: eski qoida `status: 'confirmed'` ga ruxsat berardi —
      // yo'lovchi haydovchi tasdig'ini aylanib o'ta olardi; bundan tashqari
      // bron bilan birga `intercity_drivers.seats` ni ham client yozardi
      // (qarang: intercity_drivers update izohi).
      allow create: if isAdmin();

      // Янгилаш — bekor qilish (cancel) va yakunlash (complete) ham serverga
      // ko'chdi (`intercityCancelBooking` / `intercityCompleteBooking`),
      // chunki ular `seats` ni o'zgartiradi. Client'da faqat seat'ga
      // tegmaydigan patch'lar qoldi: haydovchi tasdig'i, pickup manzili,
      // arxiv va "olib ketildi" belgisi.
      allow update: if isAuth()
          && (
            (
              phoneDocIdsMatch(
                  userDocIdFromPhoneToken(), resource.data.userPhone)
              && intercityBookingPickupPatch()
            )
            || (
              phoneDocIdsMatch(
                  userDocIdFromPhoneToken(), resource.data.driverId)
              && (
                intercityBookingDriverConfirm()
                || intercityBookingDriverArchivePatch()
                || intercityBookingPickedUpPatch()
              )
            )
            || isAdmin()
          );

      allow delete: if false;
    }

  // Legacy — faqat tarixiy o'qish (admin/staff). App `intercity_drivers` ishlatadi.
    match /intercity_trips/{id} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /ride_requests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    match /marshrut_coordinates/{routeKey} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.confirmCount == 1;
      allow update: if request.auth != null
          && resource.data.isLocked == false
          && request.resource.data.confirmCount
             <= resource.data.confirmCount + 1;
    }

    match /marshrut_dispatch_events/{id} {
      // Клиент бу коллекцияни фақат ЯРАТАДИ (`rides_repository.dart:619`).
      // Ягона ўқиш йўли — `watchRecentMarshrutDispatchEvents()` (:175),
      // лекин уни ҳеч ким чақирмайди: ўлик код. Шунинг учун ўқиш
      // админгa ёпилди. `create` қоидасига тегилмади.
      //
      // Тест: functions/test/marshrut_misc_rules.test.js
      allow read: if isAdmin();
      allow create: if marshrutDispatchEventCreateOk();
      allow update, delete: if false;
    }

    // Marshrut yo'nalish narxi — faqat CF yozadi (birinchi haydovchi seed,
    // admin tahrir). Client faqat o'qiydi (yo'lovchi + haydovchi ko'rsatish).
    match /marshrut_route_prices/{routeKey} {
      allow read: if true;
      allow write: if false;
    }

    // ══════════════════════════════════════
    // MENING YAQINLARIM — Circle (Davra) dvigateli (MVP: sinfdoshlar)
    // ══════════════════════════════════════
    function circleUserId() {
      return userDocIdFromPhoneToken();
    }
    function isCircleMember(circleId) {
      let uid = circleUserId();
      return uid != ''
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(uid));
    }
    function isCircleOwner(circleId) {
      let uid = circleUserId();
      return uid != ''
          && get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == uid;
    }

    // collectionGroup('members') so'rovi (watchMyCircleIds: a'zo bo'lgan
    // davralarimni topish) FAQAT rekursiv wildcard orqali avtorizatsiya bo'ladi —
    // ichki `/circles/{id}/members/{mid}` qoidasi collectionGroup'ga tatbiq
    // etilmaydi. Faqat o'z a'zolik hujjatlarini (userId == o'zim) o'qishga ruxsat.
    match /{path=**}/members/{memberId} {
      allow read: if resource.data.userId == circleUserId();
    }

    match /circles/{circleId} {
      // Metadata (maktab/yil/sanoq) maxfiy emas — qidiruv/taklif uchun authed o'qiydi.
      allow read: if isAuth();

      // Yaratish — avto-qo'shilish: umumiy dvigatel tiplari, yaratuvchi owner, sanoq=1.
      allow create: if isAuth()
          && request.resource.data.type in ['classmates', 'coursemates', 'colleagues']
          && request.resource.data.ownerId == circleUserId()
          && request.resource.data.memberCount == 1;

      // Yangilash: owner meta'ni; har qanday a'zo faqat sanoq/vaqtni (join/leave).
      allow update: if isAuth() && (
            isCircleOwner(circleId)
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['memberCount', 'updatedAt', 'subgroupsEnabled'])
          );

      allow delete: if isCircleOwner(circleId) || isAdmin();

      // ── A'zolar (userId = canonicalPhoneId) ──
      match /members/{memberId} {
        allow read: if memberId == circleUserId()
            || isCircleMember(circleId)
            || isAdmin();
        // Faqat o'zini yozadi (avto-qo'shilish / profil yangilash).
        allow create, update: if memberId == circleUserId()
            && request.resource.data.userId == memberId;
        allow delete: if memberId == circleUserId()
            || isCircleOwner(circleId)
            || isAdmin();
      }

      // ── Lenta / e'lon ──
      match /posts/{postId} {
        allow read: if isCircleMember(circleId) || isAdmin();
        allow create: if isCircleMember(circleId)
            && request.resource.data.authorId == circleUserId();
        allow update: if resource.data.authorId == circleUserId()
            || isCircleOwner(circleId);
        allow delete: if resource.data.authorId == circleUserId()
            || isCircleOwner(circleId)
            || isAdmin();
      }

      // ── Uchrashuvlar (RSVP: attendees) ──
      match /events/{eventId} {
        allow read: if isCircleMember(circleId) || isAdmin();
        allow create: if isCircleMember(circleId)
            && request.resource.data.createdBy == circleUserId();
        // Yaratuvchi/owner — to'liq; har qanday a'zo — faqat o'z RSVP'sini.
        allow update: if isCircleMember(circleId) && (
              resource.data.createdBy == circleUserId()
              || isCircleOwner(circleId)
              || request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['attendees'])
            );
        allow delete: if resource.data.createdBy == circleUserId()
            || isCircleOwner(circleId)
            || isAdmin();
      }

      // ── Fotoalbom ──
      match /album/{photoId} {
        allow read: if isCircleMember(circleId) || isAdmin();
        allow create: if isCircleMember(circleId)
            && request.resource.data.uploaderId == circleUserId();
        allow update: if false;
        allow delete: if resource.data.uploaderId == circleUserId()
            || isCircleOwner(circleId)
            || isAdmin();
      }

      // ── Guruh chat ──
      match /chat/{msgId} {
        allow read: if isCircleMember(circleId) || isAdmin();
        allow create: if isCircleMember(circleId)
            && request.resource.data.senderId == circleUserId();
        allow update: if false;
        allow delete: if resource.data.senderId == circleUserId()
            || isCircleOwner(circleId)
            || isAdmin();
      }

      // ── Kichik-guruhlar (sinf) — keyingi faza uchun rezerv ──
      match /subgroups/{subId} {
        allow read: if isCircleMember(circleId) || isAdmin();
        allow write: if isCircleOwner(circleId) || isAdmin();
      }
    }

    // Shikoyatlar — dating/market CF orqali; boshqa turlar client yaratishi mumkin.
    match /reports/{reportId} {
      allow create: if isAuth()
          && request.resource.data.get('type', '') != 'dating_profile'
          && request.resource.data.get('type', '') != 'market_ad';
      allow read, update, delete: if isAdmin();
    }

    // ── Tanishuv (Dating) ──────────────────────────────────────────
    // Profil yozuvlari faqat Cloud Functions orqali (saveDatingProfile /
    // adminModerateDatingProfile).

    // To'liq profilni (foto, shahar, "haqida", ish...) faqat O'ZINING
    // profili tasdiqlangan foydalanuvchi ko'ra oladi. Ilgari istalgan
    // ro'yxatdan o'tgan foydalanuvchi butun kolleksiyani o'qiy olardi.
    function datingViewerApproved() {
      let me = userDocIdFromPhoneToken();
      return isAuth()
          && exists(/databases/$(database)/documents/dating_profiles/$(me))
          && get(/databases/$(database)/documents/dating_profiles/$(me))
               .data.status == 'approved';
    }

    match /dating_profiles/{uid} {
      allow read: if isOwner(uid)
          || isAdmin()
          || (resource.data.status == 'approved' && datingViewerApproved());
      allow write: if false;
    }

    // Bosh sahifadagi 9-bo'lim uchun ochiq ko'chirma — FAQAT ism, jins va
    // tug'ilgan yil. Uni CF `onDatingProfileWriteSyncPublic` yuritadi;
    // shuning uchun bu yerda foto yoki manzil bo'lishi mumkin emas.
    match /dating_profiles_public/{uid} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Qiziqishlar — yozuv CF orqali; o'qish faqat tegishli taraflar.
    match /dating_interests/{interestId} {
      allow read: if isAuth()
          && (resource.data.fromId == userDocIdFromPhoneToken()
              || resource.data.toId == userDocIdFromPhoneToken()
              || isAdmin());
      allow write: if false;
    }

    // Match — yaratish CF orqali; o'qish faqat ishtirokchilar.
    // Yangilash: ishtirokchi faqat lastMessage/lastMessageAt patch qila oladi.
    match /dating_matches/{matchId} {
      allow read: if isAuth()
          && (userDocIdFromPhoneToken() in resource.data.users || isAdmin());
      allow update: if isAuth()
          && userDocIdFromPhoneToken() in resource.data.users
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastMessage', 'lastMessageAt']);
      allow create, delete: if false;

      // Chat — faqat match ishtirokchilari.
      match /messages/{msgId} {
        allow read: if isAuth()
            && userDocIdFromPhoneToken() in
               get(/databases/$(database)/documents/dating_matches/$(matchId)).data.users;
        allow create: if isAuth()
            && request.resource.data.senderId == userDocIdFromPhoneToken()
            && userDocIdFromPhoneToken() in
               get(/databases/$(database)/documents/dating_matches/$(matchId)).data.users
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // Bloklash — har kim o'z ro'yxatini boshqaradi.
    match /dating_blocks/{uid}/list/{targetId} {
      allow read, write: if isOwner(uid);
    }

    // ── Nasab daraxti — global graf (Faza 1) ───────────────────────
    // O'qish: o'z komponentidagi tugunlar (yoki ega/claim/admin).
    // Yozish: faqat Cloud Functions (Admin SDK). Mijoz to'g'ridan yozmaydi.
    match /tree_persons/{personId} {
      allow read: if isAuth()
          && (resource.data.componentId == myTreeComponent()
              || resource.data.ownerUid == userDocIdFromPhoneToken()
              || resource.data.claimedBy == userDocIdFromPhoneToken()
              || isAdmin());
      allow write: if false;
    }

    // Ulash takliflari — faqat tegishli taraflar o'qiydi; yozish faqat CF.
    match /tree_link_invites/{id} {
      allow read: if isAuth()
          && (resource.data.fromUid == userDocIdFromPhoneToken()
              || resource.data.toUid == userDocIdFromPhoneToken()
              || isAdmin());
      allow write: if false;
    }

    // Merge redirectlari (eski id → omon qolgan id) — CF yozadi.
    match /tree_redirects/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Daraxt tarixi (audit + undo) — komponent a'zolari o'qiydi; CF yozadi.
    match /tree_history/{id} {
      allow read: if isAuth()
          && (resource.data.componentId == myTreeComponent() || isAdmin());
      allow write: if false;
    }

    // Qarindoshlarim — SHAXSIY (ulashilmaydi). Faqat egasi (userId = phone).
    match /relative_phone_watchers/{phone} {
      allow read, write: if false;
      match /entries/{entryId} {
        allow read, write: if false;
      }
    }

    match /users/{userId}/relative_join_alerts/{alertId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /relatives/{userId}/people/{personId} {
      allow read: if isOwner(userId);
      // isSelf maydoni klient yozuvida bo'lmasa ham yangi qarindosh ruxsat —
      // `field != true` yo'q maydon uchun false berishi mumkin (audit regressiyasi).
      allow create: if isOwner(userId)
          && (!('isSelf' in request.resource.data)
              || request.resource.data.isSelf != true);
      allow update: if isOwner(userId)
          && (!request.resource.data.keys().hasAny(['isSelf'])
              || request.resource.data.isSelf == resource.data.isSelf);
      // O'chirish faqat deleteRelativePerson CF orqali (Admin SDK).
      allow delete: if false;
    }

    // Qarindosh sanalari / uchrashuvlari — SHAXSIY. Faqat egasi.
    match /relatives/{userId}/events/{eventId} {
      allow read, write: if isOwner(userId);
    }

    // Qarindosh fotoalbomi — SHAXSIY. Faqat egasi.
    match /relatives/{userId}/people/{personId}/photos/{photoId} {
      allow read, write: if isOwner(userId);
    }

    match /requests/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    function isJobsBoardAdData(d) {
      let t = d.get('type', '');
      return t != 'cheap_product'
          && (t in ['work', 'service', 'ad', 'announcement']
              || t == ''
              || !('type' in d));
    }

    function adAuthorImmutable() {
      return request.resource.data.authorPhone == resource.data.authorPhone
          && request.resource.data.authorName == resource.data.authorName;
    }

    function adAuthorIsCaller() {
      return isAuth()
          && phoneDocIdsMatch(
               userDocIdFromPhoneToken(),
               phoneDigits(resource.data.get('authorPhone', ''))
             );
    }

    function adOwnerPatchOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isJobsBoardAdData(resource.data)
          && adAuthorIsCaller()
          && adAuthorImmutable()
          && changed.hasOnly([
            'text', 'title', 'priceText', 'isUrgent', 'type', 'editedAt'
          ]);
    }

    function adModerationPatchOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
          && isJobsBoardAdData(resource.data)
          && adAuthorImmutable()
          && (
            changed.hasOnly([
                  'text', 'title', 'priceText', 'isUrgent', 'type', 'status',
                  'address', 'expiresAt', 'adminNote', 'moderatedBy',
                  'editedAt', 'moderatedAt'
                ])
            || changed.hasOnly(['status', 'moderatedAt', 'editedAt'])
            || changed.hasOnly(['status', 'moderatedAt', 'editedAt', 'moderatedBy'])
          )
          && (!changed.hasAny(['status'])
              || request.resource.data.status in [
                'pending', 'active', 'completed', 'blocked'
              ]);
    }

    function adJobsBoardDeleteOk() {
      return isJobsBoardAdData(resource.data)
          && (adAuthorIsCaller() || isAdmin());
    }

    function isCheapProductAdData(d) {
      return d.get('type', '') == 'cheap_product';
    }

    function cheapProductOwnerIsCaller() {
      return isAuth()
          && phoneDocIdsMatch(
               userDocIdFromPhoneToken(),
               phoneDigits(resource.data.get('ownerId', '')));
    }

    // Owner may edit content / hide / re-submit for moderation — never set active.
    // phone ўзгармайди (токенга боғланган).
    function cheapProductOwnerUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return cheapProductOwnerIsCaller()
          && isCheapProductAdData(resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.type == resource.data.type
          && request.resource.data.phone == resource.data.phone
          && request.resource.data.price is int
          && request.resource.data.price > 0
          && request.resource.data.price <= 100000000
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 3
          && request.resource.data.description.size() <= 2000
          && request.resource.data.imageUrls is list
          && request.resource.data.imageUrls.size() >= 1
          // 1..7 (эга қарори, 2026-10-17; аввал 1..5). Эски илова ≤5 юборади — мос.
          && request.resource.data.imageUrls.size() <= 7
          // `districtId`/`regionId` — эга МАҲСУЛОТ ҳудудини тузата олиши
          // учун (аудит, 2026-09-27). Мавжудлиги `geo_districts` бўйича
          // текширилади: ёлғон id ёзилса эълон ҳеч кимнинг лентасида
          // кўринмай қоларди.
          && changed.hasOnly([
                'title', 'titleLower', 'searchTokens', 'description', 'price',
                'sellerName', 'imageUrls', 'status', 'updatedAt',
                'districtId', 'regionId'
              ])
          && (!changed.hasAny(['districtId'])
              || (request.resource.data.districtId is string
                  && exists(/databases/$(database)/documents/geo_districts/$(request.resource.data.districtId))))
          && (!('searchTokens' in request.resource.data)
              || (request.resource.data.searchTokens is list
                  && request.resource.data.searchTokens.size() <= 64))
          && (!changed.hasAny(['status'])
              || (
                (request.resource.data.status == 'inactive'
                    && resource.data.status in ['active', 'pending'])
                // Админ рад этган/яширган эълонни (`adminRejected`,
                // `adminUpdateMarketAd[Status]` CF) эга қайта
                // жойлаштира олмайди — аввал «Қайта жойлаштириш» +
                // авто-тасдиқ рад этилган эълонни дарҳол яна очарди.
                // Муддати ўзи тугагани (`autoExpiredAt`) — мумкин.
                || (request.resource.data.status == 'pending'
                    && resource.data.status in ['inactive', 'active']
                    && resource.data.get('adminRejected', false) != true)
              ));
    }

    function cheapProductViewIncrementOk() {
      return isAuth()
          && isCheapProductAdData(resource.data)
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views is int
          && request.resource.data.views == resource.data.views + 1;
    }

    function cheapProductAdminPatchOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
          && isCheapProductAdData(resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.type == resource.data.type
          && changed.hasOnly([
                'title', 'titleLower', 'searchTokens', 'description', 'price',
                'phone', 'sellerName', 'status', 'adminNote', 'moderatedBy',
                'moderatedAt', 'updatedAt', 'publishedAt'
              ])
          && (!changed.hasAny(['status'])
              || request.resource.data.status in ['active', 'inactive']);
    }

    function cheapProductAdminDeleteOk() {
      return isAdmin() && isCheapProductAdData(resource.data);
    }

    // `ads` ўқишдаги эгалик шохи: [phone] — эълондаги телефон майдони.
    // Токендаги телефон '' бўлса (бўш `phone_number` claim) эгаси йўқ
    // эълон учун `phoneDocIdsMatch('', '')` true берарди — шунинг учун
    // камида 9 рақам. (Claim'сиз аноним токенда ифода хато → рад.)
    function adReaderIsPhone(phone) {
      let me = userDocIdFromPhoneToken();
      return me.size() >= 9 && phoneDocIdsMatch(me, phoneDigits(phone));
    }

    match /ads/{id} {
      // Jobs board: барча; cheap_product: active/owner; admin — барча BOZOR.
      // Create — фақат CF (`submitJobAd` / `submitMarketAd`).
      //
      // ЎҚИШ get/list га бўлинган (2026-10-08). Аввал битта `allow read`
      // эди ва рўйхат сўровида `resource.data.get('type', '')` сўровда
      // чекланмаган майдон учун '' берарди → `!isCheapProductAdData` true
      // → ФИЛТРСИЗ сўров (ҳатто кирмаган) бозорнинг pending/рад этилган
      // эълонларини эгасининг телефони билан қайтарарди. Шунинг учун
      // `list` да фақат тўғридан-тўғри майдон (`resource.data.X`):
      // сўров фильтри уни исботлай олмаса шох хато → false.
      // `.get(field, default)` фақат `get` да (битта ҳужжат).
      //
      // 2026-10-18 (аудит A5): Иш топ эълонлари ҳам ЭНДИ статус бўйича
      // чекланади — `pending` / `blocked` / `completed` фақат эгасига ва
      // админга. Аввал `!isCheapProductAdData` (ёки `type != cheap_product`)
      // шохи ҳар қандай статусдаги Иш топ эълонини, `authorPhone` билан,
      // КИРМАГАН клиентга ҳам очиб қўйган эди.
      allow get: if isAdmin()
          || resource.data.get('status', '') == 'active'
          || adReaderIsPhone(resource.data.get('ownerId', ''))
          || adReaderIsPhone(resource.data.get('authorPhone', ''));
      // Ҳар шох иловадаги сўровга мос (functions/test/ads_list_rules.test.js):
      // тур фильтри (Иш топ лентаси) · `status == active` (лента, қидирув) ·
      // `ownerId` (бозор «Менинг эълонларим», лимит) · `authorPhone`
      // (Иш топ «Менинг эълонларим», кунлик лимит — тур фильтри йўқ).
      allow list: if isAdmin()
          || resource.data.status == 'active'
          || adReaderIsPhone(resource.data.ownerId)
          || adReaderIsPhone(resource.data.authorPhone);
      allow create: if false;
      allow update: if adOwnerPatchOk()
          || adModerationPatchOk()
          || cheapProductOwnerUpdateOk()
          || cheapProductAdminPatchOk()
          || cheapProductViewIncrementOk();
      allow delete: if adJobsBoardDeleteOk()
          || cheapProductAdminDeleteOk()
          || (isAuth()
              && isCheapProductAdData(resource.data)
              && phoneDocIdsMatch(
                   userDocIdFromPhoneToken(),
                   phoneDigits(resource.data.get('ownerId', ''))));
    }

    // ─── Улгуржи/кичик улгуржи бозор (Cloud Function йўқ — ҳаммаси шу
    // ерда Rules орқали чекланади). Сотувчи ҳужжат ID = каноник телефон.
    //
    // АВТО/ҚЎЛДА тасдиқ — admin панелдаги `settings/app.wholesaleSellerAutoApprove`
    // / `wholesaleProductAutoApprove` (`ads`/`jobs`даги auto-approve
    // андозасига мос, лекин CF ўрнига шу ерда, Rules'нинг ўзида текширилади).
    function wholesaleSellerAutoApproveOn() {
      return exists(/databases/$(database)/documents/settings/app)
          && get(/databases/$(database)/documents/settings/app)
               .data.get('wholesaleSellerAutoApprove', false) == true;
    }

    function wholesaleProductAutoApproveOn() {
      return exists(/databases/$(database)/documents/settings/app)
          && get(/databases/$(database)/documents/settings/app)
               .data.get('wholesaleProductAutoApprove', false) == true;
    }

    // Жўнатиш манзили (У1, 2026-10-09): етказиш ҳақи зонаси `districtId`
    // бўйича (relay матрицаси). Ихтиёрий — эски сотувчиларда йўқ; бор
    // бўлса шакли текширилади (ID сатр, манзил ≤300, координата диапазон).
    function wholesaleSellerShipFromOk() {
      let d = request.resource.data;
      return d.get('regionId', '') is string && d.get('regionId', '').size() <= 40
          && d.get('districtId', '') is string && d.get('districtId', '').size() <= 60
          && (d.get('districtId', '') == '' || d.get('regionId', '') != '')
          && d.get('address', '') is string && d.get('address', '').size() <= 300
          && (!('lat' in d) || (d.lat is number && d.lat >= -90 && d.lat <= 90))
          && (!('lng' in d) || (d.lng is number && d.lng >= -180 && d.lng <= 180))
          && (('lat' in d) == ('lng' in d));
    }

    function wholesaleSellerCreateOk(phone) {
      return isAuth()
          && isOwner(phone)
          && request.resource.data.keys().hasAll(['phone', 'companyName'])
          && request.resource.data.phone == phone
          && request.resource.data.companyName is string
          && request.resource.data.companyName.size() >= 2
          && request.resource.data.companyName.size() <= 200
          && (
            request.resource.data.approvalStatus == 'pending'
            || (request.resource.data.approvalStatus == 'approved'
                && wholesaleSellerAutoApproveOn())
          )
          && request.resource.data.get('sellerType', '')
              in ['', 'manufacturer', 'wholesaler', 'yatt']
          && wholesaleSellerShipFromOk()
          // Жўнатиш манзили МАЖБУРИЙ (эга, D-GEO-14, 2026-10-11): товар
          // ҳудуди шундан олинади (`wholesale_geo.js`).
          && request.resource.data.get('regionId', '') != ''
          && request.resource.data.get('districtId', '') != ''
          && request.resource.data.keys().hasOnly([
                'phone', 'companyName', 'ownerName', 'sellerType',
                'approvalStatus', 'createdAt', 'approvedAt', 'approvedBy',
                'regionId', 'districtId', 'address', 'lat', 'lng', 'updatedAt'
              ]);
    }

    // Эга — компания/эга исми ва жўнатиш манзилини ўзгартиради, ҳеч қачон
    // ўзини тасдиқлай олмайди (`approvalStatus` шу функцияда йўқ).
    function wholesaleSellerOwnerUpdateOk(phone) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(phone)
          && request.resource.data.phone == resource.data.phone
          && changed.hasOnly([
                'companyName', 'ownerName', 'sellerType', 'updatedAt',
                'regionId', 'districtId', 'address', 'lat', 'lng'
              ])
          && request.resource.data.get('sellerType', '')
              in ['', 'manufacturer', 'wholesaler', 'yatt']
          && request.resource.data.companyName is string
          && request.resource.data.companyName.size() >= 2
          && request.resource.data.companyName.size() <= 200
          && wholesaleSellerShipFromOk()
          // Киритилган манзилни бўшатиб бўлмайди (D-GEO-14); эски манзилсиз
          // сотувчи эса профилини аввалгидек таҳрирлай олади.
          && (resource.data.get('districtId', '') == ''
              || request.resource.data.get('districtId', '') != '');
    }

    // Фақат admin (isAdmin() шу ердаги мажбурий шарт — эга/бошқа ҳеч ким
    // ушбу whitelist билан ёза олмайди).
    function wholesaleSellerApprovalPatchOnly() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
          && changed.hasOnly(['approvalStatus', 'approvedAt', 'approvedBy', 'adminNote'])
          && request.resource.data.approvalStatus in ['pending', 'approved', 'rejected'];
    }

    match /wholesale_sellers/{phone} {
      allow read: if true;
      allow create: if wholesaleSellerCreateOk(phone);
      allow update: if wholesaleSellerOwnerUpdateOk(phone) || wholesaleSellerApprovalPatchOnly();
      allow delete: if false;
    }

    function wholesaleProductSellerApproved(sellerId) {
      return exists(/databases/$(database)/documents/wholesale_sellers/$(sellerId))
          && get(/databases/$(database)/documents/wholesale_sellers/$(sellerId))
               .data.approvalStatus == 'approved';
    }

    // Манзилсиз сотувчи товар қўша олмайди (D-GEO-14) — товар ҳудуди
    // сотувчи манзилидан (`wholesale_geo.js`).
    function wholesaleProductSellerHasShipFrom(sellerId) {
      return get(/databases/$(database)/documents/wholesale_sellers/$(sellerId))
               .data.get('districtId', '') != '';
    }

    function wholesaleProductOwnerIsCaller() {
      return isAuth() && isOwner(resource.data.get('sellerId', ''));
    }

    // Етказиш маълумоти (У1, 2026-10-09): бир дона вазни (грамм, бутун,
    // ≤10 т) ва ўлчами (см, бутун, 1..1000, фақат l/w/h). Ихтиёрий —
    // эски товарларда йўқ; бор бўлса шакли шу. Паритет:
    // lib/features/wholesale/models/shipping_dims.dart (kMaxUnitWeightG, kMaxDimCm).
    function wholesaleProductShippingOk() {
      let d = request.resource.data;
      return (!('unitWeightG' in d)
              || (d.unitWeightG is int && d.unitWeightG >= 1 && d.unitWeightG <= 10000000))
          && (!('unitDims' in d)
              || (d.unitDims is map
                  && d.unitDims.keys().hasOnly(['l', 'w', 'h'])
                  && d.unitDims.keys().hasAll(['l', 'w', 'h'])
                  && d.unitDims.l is int && d.unitDims.l >= 1 && d.unitDims.l <= 1000
                  && d.unitDims.w is int && d.unitDims.w >= 1 && d.unitDims.w <= 1000
                  && d.unitDims.h is int && d.unitDims.h >= 1 && d.unitDims.h <= 1000));
    }

    // Яратиш — фақат тасдиқланган сотувчи; ҳолат `pending`, ёки
    // `wholesaleProductAutoApprove` ёқиқ бўлса — тўғридан-тўғри `active`.
    function wholesaleProductCreateOk() {
      return isAuth()
          && isOwner(request.resource.data.get('sellerId', ''))
          && wholesaleProductSellerApproved(request.resource.data.sellerId)
          && wholesaleProductSellerHasShipFrom(request.resource.data.sellerId)
          && (
            request.resource.data.status == 'pending'
            || (request.resource.data.status == 'active'
                && wholesaleProductAutoApproveOn())
          )
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 3
          && request.resource.data.description.size() <= 2000
          && request.resource.data.priceTiers is list
          && request.resource.data.priceTiers.size() >= 1
          && request.resource.data.priceTiers.size() <= 5
          && request.resource.data.imageUrls is list
          && request.resource.data.imageUrls.size() >= 1
          && request.resource.data.imageUrls.size() <= 7
          && request.resource.data.get('views', 0) == 0
          && request.resource.data.get('videoClipIds', []).size() == 0
          // `market` — қайси бозор: 'wholesale' (улгуржи) ёки 'china'
          // (Хитой). Хитой бозорида валюта ва етказиш муддати ҳам бор.
          && request.resource.data.get('market', 'wholesale')
               in ['wholesale', 'china']
          // `createdAt` — МАЖБУРИЙ ва фақат СЕРВЕР вақти (2026-10-09).
          // Илова `FieldValue.serverTimestamp()` юборади (модулнинг биринчи
          // версияси b361a1c, 2026-09-21 дан бери) — у `request.time`га тенг.
          // Майдонсиз ҳужжат админ рўйхатида (`orderBy('createdAt')`)
          // кўринмай қоларди; телефон вақти ёки ўзбошимча сана эса уни
          // рўйхат бошига/охирига суриб қўярди. Кейин ўзгармайди: ҳеч бир
          // update йўлининг `hasOnly` рўйхатида `createdAt` йўқ.
          // Тест: functions/test/wholesale_products_rules.test.js
          && request.resource.data.createdAt == request.time
          && wholesaleProductShippingOk()
          && request.resource.data.keys().hasOnly([
                'sellerId', 'sellerCompanyName', 'title', 'titleLower',
                'searchTokens', 'description', 'priceTiers', 'unit',
                'imageUrls', 'status', 'views', 'videoClipIds',
                'createdAt', 'updatedAt', 'publishedAt', 'moderatedAt',
                'moderatedBy',
                'market', 'currency', 'deliveryDays',
                'unitWeightG', 'unitDims'
              ]);
    }

    // Эга — контент таҳрири (қайта `pending`га тушади) ёки фақат
    // яшириш (`inactive`) — ҳеч қачон ўзини `active` қилолмайди.
    // Нарх поғоналари (`priceTiers`) — ҳар бир элемент таркиби клиентда
    // (Dart модел) шаклланади; `imageUrls`даги каби бу ерда фақат
    // рўйхат ҳажми текширилади (per-item schema Rules'да текширилмайди).
    function wholesaleProductOwnerUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return wholesaleProductOwnerIsCaller()
          && request.resource.data.sellerId == resource.data.sellerId
          // `market` бу ерда ЙЎҚ — эга маҳсулотни бир бозордан
          // бошқасига кўчира олмайди (у фақат яратишда белгиланади).
          && changed.hasOnly([
                'title', 'titleLower', 'searchTokens', 'description',
                'priceTiers', 'unit', 'imageUrls', 'status', 'updatedAt',
                'currency', 'deliveryDays', 'unitWeightG', 'unitDims'
              ])
          && wholesaleProductShippingOk()
          && request.resource.data.priceTiers is list
          && request.resource.data.priceTiers.size() >= 1
          && request.resource.data.priceTiers.size() <= 5
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 120
          && request.resource.data.description.size() >= 3
          && request.resource.data.description.size() <= 2000
          && request.resource.data.imageUrls.size() >= 1
          && request.resource.data.imageUrls.size() <= 7
          && (!changed.hasAny(['status'])
              || (
                (request.resource.data.status == 'inactive'
                    && resource.data.status in ['active', 'pending'])
                || (request.resource.data.status == 'pending'
                    && resource.data.status in ['inactive', 'active'])
              ));
    }

    function wholesaleProductAdminPatchOnly() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
          && request.resource.data.sellerId == resource.data.sellerId
          && changed.hasOnly([
                'status', 'adminNote', 'moderatedAt', 'moderatedBy',
                'publishedAt', 'updatedAt'
              ])
          && (!changed.hasAny(['status'])
              || request.resource.data.status in ['active', 'inactive']);
    }

    function wholesaleProductViewIncrementOk() {
      return isAuth()
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views is int
          && request.resource.data.views == resource.data.views + 1;
    }

    // Эга — видеообзор/пуллик реклама клипини (AVAGram'да алоҳида
    // нашр қилинган) маҳсулотга боғлаш/олиб ташлаш.
    function wholesaleProductVideoLinkOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return wholesaleProductOwnerIsCaller()
          && request.resource.data.sellerId == resource.data.sellerId
          && changed.hasOnly(['videoClipIds', 'updatedAt'])
          && request.resource.data.videoClipIds is list
          && request.resource.data.videoClipIds.size() <= 5;
    }

    match /wholesale_products/{id} {
      allow read: if isAdmin()
          || resource.data.status == 'active'
          || (isAuth() && isOwner(resource.data.get('sellerId', '')));
      allow create: if wholesaleProductCreateOk();
      allow update: if wholesaleProductOwnerUpdateOk()
          || wholesaleProductAdminPatchOnly()
          || wholesaleProductViewIncrementOk()
          || wholesaleProductVideoLinkOk();
      allow delete: if isAdmin() || wholesaleProductOwnerIsCaller();
    }

    // ══════════════════════════════════════════════════════════════════
    // КАФЕ-РЕСТОРАНЛАР (D-REST-1…14, 2026-10-08; functions/restaurant_orders.js)
    // ══════════════════════════════════════════════════════════════════
    // `restaurants/{rid}` фақат CF яратади (`restaurantRegister`): `status`,
    // `ownerUid`, `walletUserDocId`, рейтинг, `timeoutStreak` — server-only.
    // А'зо (`members/{uid}`, CF ёзади) профил ва менюни тўғридан-тўғри ёзади
    // (улгуржи намунаси); нарх `int` — буюртма нархи барибир серверда
    // менюдан қайта ҳисобланади (18-қоида). Буюртмалар — `orders`
    // (`type: 'restaurant'`), яратиш/ўтишлар фақат CF.
    // Тест: functions/test/restaurant_rules.test.js
    function isRestaurantMember(rid) {
      let me = userDocIdFromPhoneToken();
      return me != ''
          && exists(/databases/$(database)/documents/restaurants/$(rid)/members/$(me));
    }

    function restaurantApproved(rid) {
      return exists(/databases/$(database)/documents/restaurants/$(rid))
          && get(/databases/$(database)/documents/restaurants/$(rid))
               .data.get('status', '') == 'approved';
    }

    // Профил — фақат а'зо ўзгартира оладиган майдонлар (whitelist).
    function restaurantProfilePatchOk() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly([
            'name', 'description', 'cuisineTags', 'address', 'contactPhone',
            'lat', 'lng', 'geohash', 'logoUrl', 'coverUrl', 'announcement',
            'openingHours', 'prepTimeMin', 'minOrderAmount', 'maxQtyPerItem', 'acceptsPreorder', 'delivery',
            'acceptsBookings', 'bookingSeats', 'bookingNote',
            'payment', 'pausedUntil', 'updatedAt'
          ])
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
          && d.prepTimeMin is int && d.prepTimeMin >= 5 && d.prepTimeMin <= 180
          && d.minOrderAmount is int && d.minOrderAmount >= 0
          // D-REST-26: бир таомдан энг кўпи; шип 500 — functions/restaurant_orders.js
          // `MAX_QTY_CEILING` ва клиент `Restaurant.maxQtyPerItemCeiling` билан бир хил.
          && (!('maxQtyPerItem' in d)
              || (d.maxQtyPerItem is int && d.maxQtyPerItem >= 1 && d.maxQtyPerItem <= 500))
          // S4b: «олдиндан буюртма оламан» белгиси; вақт чегаралари (60 дақиқа…7 кун) — серверда.
          && (!('acceptsPreorder' in d) || d.acceptsPreorder is bool)
          // S5 (D-REST-23): стол бронь белгиси, бир слотдаги ўринлар сони ва закалат матни. Бекор қилиш лимитидан
          // (`bookingCancels`, `bookingsDisabledReason` — фақат CF) автомат ўчирилган бўлса, а'зо ўзи қайта ёқа олмайди.
          && (!('acceptsBookings' in d) || d.acceptsBookings is bool)
          && (!('bookingSeats' in d) || (d.bookingSeats is int && d.bookingSeats >= 1 && d.bookingSeats <= 500))
          && (!('bookingNote' in d) || (d.bookingNote is string && d.bookingNote.size() <= 300))
          && (!changed.hasAny(['acceptsBookings'])
              || d.get('acceptsBookings', false) == false
              || resource.data.get('bookingsDisabledReason', '') == '')
          && d.delivery is map
          && d.delivery.get('mode', 'none') in ['ava_courier', 'own_courier', 'none']
          && d.payment is map;
    }

    function restaurantMenuItemOk() {
      let d = request.resource.data;
      return d.keys().hasOnly([
            'name', 'description', 'photoUrl', 'price', 'packagingFee',
            'categoryId', 'sort', 'available', 'stopUntil', 'saleHours',
            'servings', 'weightG', 'kcal', 'protein', 'fat', 'carbs',
            'cuisineGroup', 'cuisineId', 'tags', 'qtyTiers',
            'createdAt', 'updatedAt'
          ])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
          && d.price is int && d.price > 0 && d.price <= 50000000
          && (!('packagingFee' in d)
              || (d.packagingFee is int && d.packagingFee >= 0 && d.packagingFee <= 50000000))
          && (!('available' in d) || d.available is bool)
          && (!('description' in d)
              || (d.description is string && d.description.size() <= 500))
          && (!('photoUrl' in d) || (d.photoUrl is string && d.photoUrl.size() <= 500))
          && (!('stopUntil' in d) || d.stopUntil == null || d.stopUntil is timestamp)
          && dishFactsOk(d)
          && qtyTiersOk(d);
    }
    // Миқдорга чегирма (D-REST-25): `qtyTiers: [{minQty, price}]`, ≤ 3 та. Биринчи поғона: minQty ≥ 2 ва
    // нархи АСОСИЙ нархдан кам; кейингилар: minQty катта (≤ 500), нархи олдингисидан кам (≥ 1). Чегирма
    // нархдан ПАСТГА тушади, юқорига эмас — шунинг учун бузилган ҳужжат орқали нарх оширилмайди.
    // Мантиқ `functions/restaurant_qty_tiers.js` (`sanitizeTiers`) билан бир хил (сервер ишонмайди).
    function qtyTierOk(t, prevMin, prevPrice) {
      return t is map && t.keys().hasOnly(['minQty', 'price'])
          && t.minQty is int && t.minQty > prevMin && t.minQty <= 500
          && t.price is int && t.price >= 1 && t.price < prevPrice;
    }
    function qtyTiersOk(d) {
      return !('qtyTiers' in d)
          || (d.qtyTiers is list && d.qtyTiers.size() <= 3
              && (d.qtyTiers.size() < 1 || qtyTierOk(d.qtyTiers[0], 1, d.price))
              && (d.qtyTiers.size() < 2 || qtyTierOk(d.qtyTiers[1], d.qtyTiers[0].minQty, d.qtyTiers[0].price))
              && (d.qtyTiers.size() < 3 || qtyTierOk(d.qtyTiers[2], d.qtyTiers[1].minQty, d.qtyTiers[1].price)));
    }

    // Таом маълумотлари (D-REST-16/17/24; docs/kafe_restoran_taklifi_uz.md §10.1).
    // ҲАММАСИ ИХТИЁРИЙ: майдон йўқ — рад этилмайди (таом бўлимга маълумоти
    // тўлиқлиги билан киради). Мавжуд бўлса — тип ва чегара қатъий (null ҳам рад:
    // клиент йўқ майдонни ўчиради). Чегаралар клиентдаги `DishFacts` билан бир хил.
    function dishIntIn(d, f, lo, hi) {
      return !(f in d) || (d[f] is int && d[f] >= lo && d[f] <= hi);
    }

    // КБЖУ: ё тўртталаси ҳам йўқ, ё тўртталаси ҳам бор ва калория мос.
    function dishNutritionOk(d) {
      return !d.keys().hasAny(['kcal', 'protein', 'fat', 'carbs'])
          || (d.keys().hasAll(['kcal', 'protein', 'fat', 'carbs'])
              && dishIntIn(d, 'kcal', 0, 5000)
              && dishIntIn(d, 'protein', 0, 500)
              && dishIntIn(d, 'fat', 0, 500)
              && dishIntIn(d, 'carbs', 0, 500)
              && dishKcalConsistent(d));
    }

    // Калория ≈ 4·оқсил + 4·углевод + 9·ёғ; фарқ ≤ 20 ккал ёки ≤ 15 % (PROPOSED).
    function dishKcalConsistent(d) {
      let calc = 4 * d.protein + 4 * d.carbs + 9 * d.fat;
      let diff = d.kcal > calc ? d.kcal - calc : calc - d.kcal;
      return diff <= 20 || diff * 100 <= calc * 15;
    }

    // Кухна: ё иккаласи ҳам йўқ, ё `restaurant_cuisines/{id}` мавжуд ва гуруҳи мос.
    function dishCuisineOk(d) {
      return (!('cuisineId' in d) && !('cuisineGroup' in d))
          || ('cuisineId' in d && 'cuisineGroup' in d
              && d.cuisineId is string && d.cuisineId.size() >= 1 && d.cuisineId.size() <= 80
              && d.cuisineGroup in ['national', 'world']
              && get(/databases/$(database)/documents/restaurant_cuisines/$(d.cuisineId))
                   .data.group == d.cuisineGroup);
    }

    function dishFactsOk(d) {
      return dishIntIn(d, 'servings', 1, 50)
          && dishIntIn(d, 'weightG', 10, 5000)
          && dishNutritionOk(d)
          && dishCuisineOk(d)
          && (!('tags' in d)
              || (d.tags is list && d.tags.size() <= 4
                  && d.tags.hasOnly([
                    'kids', 'breakfast', 'night', 'light', 'dastarxon',
                    'ramadan', 'navruz', 'qurbon', 'newyear', 'wedding'
                  ])));
    }

    function restaurantMenuCategoryOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'sort', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 60;
    }

    function restaurantPrivatePatchOk(doc) {
      let d = request.resource.data;
      return (doc == 'payment'
              && d.keys().hasOnly(['cardNumber', 'cardHolder', 'qrImageUrl', 'updatedAt'])
              && (!('cardNumber' in d)
                  || (d.cardNumber is string && d.cardNumber.size() <= 16)))
          || (doc == 'legal'
              && d.keys().hasOnly(['tin', 'pinfl', 'docs', 'updatedAt']));
    }

    match /restaurants/{rid} {
      // get: тасдиқланган — ҳамма (логинсиз ҳам, меню кўриш); а'зо/админ —
      // ҳар қандай ҳолат.
      allow get: if resource.data.get('status', '') == 'approved'
          || isAdmin()
          || (isAuth() && isRestaurantMember(rid));
      // list: фақат тўғридан-тўғри майдон (`.get()` default тузоғи):
      // `where status == 'approved'` ёки эга `where ownerUid == мен`.
      allow list: if resource.data.status == 'approved'
          || isAdmin()
          || (isAuth() && resource.data.ownerUid == userDocIdFromPhoneToken());
      allow create: if false;
      allow update: if isAuth() && isRestaurantMember(rid) && restaurantProfilePatchOk();
      allow delete: if false;

      match /members/{uid} {
        allow read: if isAdmin() || (isAuth() && isRestaurantMember(rid));
        allow write: if false;
      }

      // Реквизит (карта/QR) ва юридик ҳужжатлар — оммавий эмас.
      match /private/{doc} {
        allow read: if isAdmin() || isFinanceReader()
            || (isAuth() && isRestaurantMember(rid));
        allow create, update: if isAuth() && isRestaurantMember(rid)
            && restaurantPrivatePatchOk(doc);
        allow delete: if false;
      }

      match /menu_categories/{cid} {
        allow read: if isAdmin() || restaurantApproved(rid)
            || (isAuth() && isRestaurantMember(rid));
        allow create, update: if isAuth() && isRestaurantMember(rid)
            && restaurantMenuCategoryOk();
        allow delete: if isAuth() && isRestaurantMember(rid);
      }

      match /menu_items/{iid} {
        allow read: if isAdmin() || restaurantApproved(rid)
            || (isAuth() && isRestaurantMember(rid));
        allow create, update: if isAuth() && isRestaurantMember(rid)
            && restaurantMenuItemOk();
        allow delete: if isAuth() && isRestaurantMember(rid);
      }

      // Таом баҳоси агрегати (D-REST-18): `ratingSum`/`ratingCount` — фақат CF
      // (`submitDishRatings`). Менюдан АЛОҲИДА: `menu_items` қоидаси `hasOnly`, а'зо
      // ўз таомининг рейтингини ёза олмаслиги керак (20-қоида).
      match /menu_item_stats/{iid} {
        allow read: if isAdmin() || restaurantApproved(rid)
            || (isAuth() && isRestaurantMember(rid));
        allow write: if false;
      }
    }

    // Бўлимлар индекси (S3, D-REST-33): таомнинг тайёр кўриниши (`functions/restaurant_dish_index.js`).
    // Ҳужжат фақат ТАСДИҚЛАНГАН ресторан таомлари учун мавжуд (бошқасида ўчирилади), PII йўқ — ҳамма
    // ўқийди (меню ва ресторан рўйхати каби). Ёзув — фақат CF: клиент ўз таомини «Арзон»га ёки
    // рейтингини ўзгартириб қўя олмасин (20-қоида).
    match /restaurant_dish_index/{ixId} {
      allow read: if true;
      allow write: if false;
    }

    // Стол бронь (S5, D-REST-23/38; functions/restaurant_bookings.js): ҳужжат ва ҳодисалар ФАҚАТ CF ёзади
    // (ҳолат ўтишлари, ҳақ ечиш, сиғим — клиентга ишонилмайди, 18-қоида). Ўқийди: мижоз (ўз броннинг),
    // шу ресторан а'золари ва админ. `list` — тўғридан-тўғри майдонлар (`.get()` default тузоғи йўқ).
    match /restaurant_bookings/{bid} {
      allow get: if isAuth() && (
          isAdmin()
          || phoneDocIdsMatch(phoneFromToken(), phoneDigits(resource.data.userPhone))
          || isRestaurantMember(resource.data.restaurantId)
      );
      allow list: if isAuth() && (
          isAdmin()
          || phoneDocIdsMatch(phoneFromToken(), phoneDigits(resource.data.userPhone))
          || isRestaurantMember(resource.data.restaurantId)
      );
      allow write: if false;

      match /events/{eid} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
    // Алоҳида баҳолар (кимнинг баҳоси — PII): фақат админ ўқийди, ёзув — фақат CF.
    match /restaurant_dish_ratings/{ratingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Кухналар рўйхати (D-REST-24): оммавий ўқилади (PII йўқ); ёзув фақат CF
    // (`restaurantAddCuisine` — дубликатсиз, кунлик лимит билан; скрытие — админ CF).
    match /restaurant_cuisines/{cid} {
      allow read: if true;
      allow write: if false;
    }

    // Мижоз strike/буюртма сони ва курьер выкуп созламаси — фақат CF ёзади.
    match /restaurant_customer_stats/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if false;
    }
    match /restaurant_courier_prefs/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if false;
    }

    // Шикоят — фақат CF `submitJobComplaint` (client create: false).
    function complaintCreateOk() {
      return false;
    }

    function complaintAdminResolveOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
          && changed.hasOnly(['resolved', 'resolvedAt', 'resolvedBy'])
          && request.resource.data.resolved == true
          && request.resource.data.resolvedAt is timestamp
          && request.resource.data.resolvedBy is string;
    }

    match /complaints/{id} {
      allow read: if isAdmin();
      allow create: if complaintCreateOk();
      allow update: if complaintAdminResolveOk();
      allow delete: if false;
    }

    // Сотиш таклифлари — фойдаланувчи юборadi; админ/оператор кўради.
    function sellSubmissionOwnerRead() {
      return isAuth()
          && (phoneDocIdsMatch(
                  userDocIdFromPhoneToken(),
                  phoneDigits(resource.data.get('userId', '')))
              || phoneDocIdsMatch(
                  userDocIdFromPhoneToken(),
                  phoneDigits(resource.data.get('userPhone', ''))));
    }

    function sellSubmissionForwardedRead() {
      let uid = userDocIdFromPhoneToken();
      return isAuth()
          && (
            (resource.data.get('forwardAudience', '') == 'all')
            || (resource.data.get('forwardAudience', '') == 'selected'
                && resource.data.get('visibleToUserIds', []).hasAny([uid]))
          );
    }

    function isCollectionTaskCourier() {
      return isAuth()
          && phoneDocIdsMatch(
               userDocIdFromPhoneToken(),
               resource.data.courierId
             );
    }

    function isCollectionTaskCustomer() {
      return isOwner(resource.data.customerUid)
          || isOwner(resource.data.customerPhone);
    }

    match /sell_submissions/{id} {
      allow read: if isAdmin()
          || sellSubmissionOwnerRead()
          || sellSubmissionForwardedRead();
      allow create: if false;
      allow update, delete: if false;
    }

    match /collection_tasks/{id} {
      allow read: if isAdmin()
          || isCollectionTaskCourier()
          || isCollectionTaskCustomer();
      allow create, update, delete: if false;
    }

    // Омбор қолдиғи — фақат CF ёзади (courierFinalizeCollection).
    match /warehouse_stock/{code} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════
    // WEB mahalliy taksi: docId = Firebase Anonymous UID; trips esa Flutter bilan umumiy.
    // ══════════════════════════════════════
    match /local_taxi_drivers/{driverDocId} {
      allow read: if true;
      allow create: if request.auth != null
          && request.auth.uid == driverDocId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.keys().hasAll(['phone', 'name', 'status', 'updatedAt']);
      allow update: if request.auth != null
          && request.auth.uid == driverDocId
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    // Eski web — yozuv yo'q, faqat tarixiy o'qish
    match /local_taxi_requests/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════
    // COURIER
    // ══════════════════════════════════════
    // Legacy `courier_orders` — faqat tarixiy o'qish (CF va client yozuvi o'chirildi).
    match /courier_orders/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /delivery_routes/{id} {
      // S1: аввал `update` шарти `request.resource.data.keys().hasAny([...])`
      // эди. `request.resource.data` — ёзишдан КЕЙИНГИ тўлиқ ҳужжат, рейсда
      // бу майдонлар доим мавжуд, яъни шарт ҲАР ДОИМ `true` бўларди.
      // Амалда тизимга кирмаган одам ҳам исталган рейсни ўзгартира оларди:
      // тугатилган деб белгилаш, бошқа курьерга ўтказиш, ҳатто `orders`ни
      // алмаштириш. Тўғри шакл — `hasAny` эмас, ўзгарган майдонлар бўйича
      // `diff(resource.data).affectedKeys().hasOnly([...])`.
      //
      // Курьер оқими (`delivery_routes_repository.dart`):
      //   startRoute ready→active · advanceIndex · completeRoute
      // Курьер эгасиз рейсни эгалламайди — `courier_controller.dart:168`
      // аввал `getActiveForCourier(uid)` чақиради, яъни рейс унга
      // аллақачон тайинланган бўлади.
      //
      // Тест: functions/test/delivery_routes_rules.test.js
      allow read: if isAdmin() || isOwner(resource.data.get('courierId', ''));
      // Reys yaratish — admin / dispatcher
      allow create: if isAdmin();
      allow update: if isAdmin()
          || (
               isOwner(resource.data.get('courierId', ''))
               && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'currentIndex', 'startedAt',
                             'completedAt', 'courierId'])
               // Курьер рейсни ўзгача бировга ўтказа олмайди.
               && request.resource.data.get('courierId', '')
                  == resource.data.get('courierId', '')
             );
      allow delete: if false;
    }

    match /couriers/{id} {
      // S2 — учта тешик бир жойда эди:
      //   1. `read: if true` — ҳар ким ҳар бир курьернинг телефони ва
      //      ЖОНЛИ координатасини ўқий оларди (ЗРУ-547);
      //   2. `create` фақат майдон борлигини текширарди, auth йўқ;
      //   3. `update` да майдон рўйхати тўғри эди, лекин ЭГАЛИК йўқ —
      //      исталган одам бировнинг `fcmToken`ини алмаштириб, push'ини
      //      ўғирлаши мумкин эди.
      //
      // Ҳужжат ID — телефон рақами, 9 ва 12 хонали икки шаклда учрайди.
      // `isOwner()` → `phoneDocIdsMatch()` иккаласини ҳам тўғри
      // таққослайди, шунинг учун ID миграцияси кутилмайди.
      //
      // Клиент оқимлари: `couriers_repository.dart` (GPS heartbeat,
      // goOffline), админ панел (яратиш/ўчириш/рўйхат). CF admin SDK
      // орқали ёзади — қоидалардан ўтмайди.
      //
      // 13.6.4 (0a) — ЯРАТИШ ФАҚАТ АДМИНДА.
      //
      // Сабаб S2 да эътибордан четда қолган: `couriers` ҳужжатининг
      // МАВЖУДЛИГИ `functions/index.js:2399` →
      // `resolveAuthorizedCourierUid` да ҲУҚУҚ сифатида ишлатилади ва у
      // 14 та callable'ни очади (`courierCreateRoute`,
      // `courierGetCustomerWalletBalance` ва бошқалар). Яъни «ўзига
      // ҳужжат яратиш» = «ўзига курьерлик ҳуқуқини бериш» (19-қоида:
      // authentication ≠ authorization).
      //
      // S2 да қоида «аутентификациясиз ҳар ким» дан «ўзи ёки админ»га
      // торайтирилган эди — яхшиланиш, лекин етарли эмас.
      //
      // Реестрни админ яратади (`courier_management_screen.dart:47`),
      // админ панели эса custom token билан Firebase Auth'га киради ва
      // токенида `phone_number` доимий claim бор
      // (`functions/index.js` → `adminWebSignIn`), шунинг учун
      // `isAdmin()` у ерда ИШЛАЙДИ.
      //
      // Жонли ҳолат (`isOnline`/GPS) эгаси томонидан МАВЖУД ҳужжатда
      // янгиланади — пастдаги `update` да, ва у ҳуқуқ бермайди.
      //
      // Тест: functions/test/couriers_rules.test.js
      //       functions/test/self_approval_rules.test.js
      allow read: if isAdmin() || isOwner(id);
      allow create: if isAdmin()
          && request.resource.data.keys().hasAll(['isOnline', 'name', 'phone']);
      allow update: if (isAdmin() || isOwner(id))
          && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'isOnline', 'lat', 'lng', 'name', 'phone', 'fcmToken',
            'updatedAt', 'lastSeen'
          ]);
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════
    // PAYOUT REQUESTS — мижоз нақд чиқариш (ёзувлар асосан Functions)
    // ══════════════════════════════════════
    match /payout_requests/{id} {
      // S3: аввал `read: if true` эди — ҳар ким, ҳатто тизимга кирмаган
      // одам ҳам барча пул чиқариш сўровларини (`userPhone` + `amount`)
      // ўқий оларди. Ҳужжат CF (`requestPayout`) томонидан яратилади,
      // шакли: userPhone · amount · status · createdAt.
      //
      // Ўқийдиганлар (репо бўйича текширилган):
      //   admin_web/payout_management_screen.dart, admin_shell.dart
      //   analytics_repository.dart (pending саноғи)
      //   сўров эгаси — ўзиникини
      //
      // Тест: functions/test/payout_requests_rules.test.js
      allow read: if isFinanceReader()
          || isAdmin()
          || isOwner(resource.data.userPhone);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Telegram wallet bot — top-up / withdraw (CF-only write).
    match /wallet_topup_requests/{id} {
      // Хабарлар → Wallet таб суммалари учун admin/dispatcher ҳам ўқийди.
      allow read: if isFinanceReader() || isAdmin()
          || (isAuth() && phoneDocIdsMatch(
                userDocIdFromPhoneToken(), resource.data.uid));
      allow create, update, delete: if false;
    }
    match /wallet_withdraw_requests/{id} {
      allow read: if isFinanceReader()
          || (isAuth() && phoneDocIdsMatch(
                userDocIdFromPhoneToken(), resource.data.uid));
      allow create, update, delete: if false;
    }
    match /telegram_links/{tgId} {
      allow read: if isFinanceReader()
          || (isAuth() && phoneDocIdsMatch(
                userDocIdFromPhoneToken(), resource.data.uid));
      allow create, update, delete: if false;
    }
    match /telegram_link_codes/{code} {
      allow read, write: if false;
    }
    match /telegram_bot_sessions/{tgId} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════
    // DAILY_REPORTS — кунлик ҳисоботлар (Analytics Center + Cloud Functions)
    // ══════════════════════════════════════
    //
    // Document ID — sana (`YYYY-MM-DD`).
    // Client-side admin'lar `regenerateTodayReport()` орqали қайта-ясaши учун.
    // Кейин Phone Auth + admin tekshiruvига ўрнатилaди.
    match /daily_reports/{dateKey} {
      allow read: if isAdmin();
      allow create, update: if false; // CF (Admin SDK) only
      allow delete: if false;
    }

    // ANALYTICS_DAILY — Monitoring Center Dashboard period aggregates.
    // Additive (SUM): users.new, content.new*, commerce.*.
    // Stock (last day): users.total, content.total*. Unique DAU is NOT stored.
    match /analytics_daily/{dateKey} {
      allow read: if isAdmin() || isFinanceReader();
      allow create, update, delete: if false; // CF (Admin SDK) only
    }

    match /analytics_backfill_jobs/{jobId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // CF (Admin SDK) only
    }

    // ══════════════════════════════════════
    // SETTLEMENT LEDGER — double-entry buxgalteriya yadrosi (V1)
    //
    // Barcha yozuvlar FAQAT Cloud Functions (Admin SDK) orqali — klient
    // hech qachon yoza olmaydi (allow write: if false). Admin SDK security
    // rules'ni chetlab o'tadi, shu sababli CF muammosiz yozadi.
    //
    // journal_entries — APPEND-ONLY: yaratilgandan keyin O'ZGARMAS.
    // Tuzatish faqat kompensatsiya (storno) yozuvi orqali.
    // To'liq dizayn: docs/settlement_ledger_v1_uz.md
    // ══════════════════════════════════════

    // O'zgarmas jurnal (append-only). Hatto finance ham tahrirlay olmaydi.
    match /journal_entries/{entryId} {
      allow read: if isFinanceReader();
      allow create, update, delete: if false; // CF (Admin SDK) only
    }

    // Materialized balanslar — faqat post() (CF) yangilaydi.
    match /ledger_accounts/{accountId} {
      allow read: if isFinanceReader();
      allow create, update, delete: if false; // CF (Admin SDK) only
    }

    // Trip settlement holati (state machine) — CF boshqaradi.
    // O'qish: finance YOKI shu settlement tarafi (yo'lovchi/haydovchi) —
    // ilovada ko'rib tasdiqlash uchun. Yozuv faqat CF (confirm/cancel CF orqali).
    match /settlements/{settlementId} {
      allow read: if isFinanceReader()
          || (isAuth() && (
                phoneDocIdsMatch(userDocIdFromPhoneToken(), resource.data.passengerUid)
                || phoneDocIdsMatch(userDocIdFromPhoneToken(), resource.data.driverUid)
              ));
      allow create, update, delete: if false; // CF (Admin SDK) only
    }

    // Davr qulfi (Daily Closing) — CF yozadi, hech kim o'chira olmaydi.
    match /period_closings/{periodId} {
      allow read: if isFinanceReader();
      allow create, update, delete: if false; // CF (Admin SDK) only
    }

    // Deferred (offline-lite) istisnolari — muddati o'tgan manfiy floatlar.
    // settlementDeferredWatch (CF) yozadi, finance ko'radi.
    match /ledger_exceptions/{exceptionId} {
      allow read: if isFinanceReader();
      allow create, update, delete: if false; // CF (Admin SDK) only
    }

    // ─── Юк биржаси (умумий эълонлар) ─────────────────────────────────
    function yukListingCreateOk() {
      let d = request.resource.data;
      return isAuth()
          && phoneDocIdsMatch(userDocIdFromPhoneToken(), d.ownerId)
          && d.status == 'active'
          && d.type in ['cargo', 'truck']
          && d.from is string && d.from.size() > 0
          && d.to is string && d.to.size() > 0
          && d.vehicleType is string
          && d.ownerName is string
          && d.phone is string
          && d.createdAt is timestamp
          && d.expiresAt is timestamp
          // 2026-10-11 (ega: 5 sutka): muddatni klient yozadi — yuqori
          // chegara 6 sutka (5 sutka + telefon soati farqi zaxirasi).
          // Eski APK 48 soat yozadi — o'tadi.
          && d.expiresAt < request.time + duration.value(6, 'd')
          && yukDepartDateOk(d);
    }

    // `departDate` — ixtiyoriy, `YYYY-MM-DD` (eski e'lonlarda yo'q).
    function yukDepartDateOk(d) {
      return !('departDate' in d)
          || (d.departDate is string && d.departDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function yukListingOwnerUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAuth()
          && phoneDocIdsMatch(userDocIdFromPhoneToken(), resource.data.ownerId)
          && notChanged('ownerId')
          && notChanged('createdAt')
          && notChanged('expiresAt')
          && notChanged('type')
          && notChanged('stars')
          && changed.hasOnly([
            'from', 'to', 'stops', 'vehicleType', 'cargo', 'weight',
            'capacity', 'freeSpace', 'price', 'comment', 'status',
            'updatedAt', 'closedAt', 'ownerName', 'phone', 'departDate'
          ])
          && yukDepartDateOk(request.resource.data)
          && request.resource.data.status in ['active', 'closed'];
    }

    match /yuk_listings/{id} {
      allow read: if isAuth();
      allow create: if yukListingCreateOk();
      allow update: if isAdmin() || yukListingOwnerUpdateOk();
      allow delete: if isAdmin();
    }

    // ─── Туман ичида юк (live машиналар) ───────────────────────────────
    // Эгалик faqat `ownerId` бўйича — ҳужжат ID'си auto-ID (бир рақам остида
    // бир нечта эълон). Эски телефон-ID ҳужжатларда ҳам `ownerId` бор,
    // шунинг учун улар ҳам ишлашда давом этади.
    // Туман ичида: жойлашув + иш вақти + TTL. Онлайн/heartbeat йўқ.
    function yukLocalDriverCreateOk() {
      let d = request.resource.data;
      return isAuth()
          && phoneDocIdsMatch(userDocIdFromPhoneToken(), d.ownerId)
          && d.vehicleType is string
          && d.phone is string
          && d.ownerName is string
          && d.lat is number
          && d.lng is number
          && d.workStartMinutes is int
          && d.workEndMinutes is int
          && d.loadStatus in ['empty', 'busy', 'offline'];
    }

    function yukLocalDriverOwnerUpdateOk() {
      return isAuth()
          && phoneDocIdsMatch(userDocIdFromPhoneToken(), resource.data.ownerId)
          && notChanged('ownerId')
          && notChanged('rating')
          && notChanged('completedLoads')
          && notChanged('createdAt')
          && notChanged('expiresAt');
    }

    match /yuk_local_drivers/{driverId} {
      allow read: if isAuth();
      allow create: if yukLocalDriverCreateOk();
      allow update: if isAdmin() || yukLocalDriverOwnerUpdateOk();
      allow delete: if isAdmin()
          || (isAuth()
              && phoneDocIdsMatch(userDocIdFromPhoneToken(), resource.data.ownerId));
    }

    // Биринчи эълон TTL (60 кун) учун тарихий белги.
    match /yuk_local_owner_meta/{ownerId} {
      allow read: if isAuth()
          && phoneDocIdsMatch(userDocIdFromPhoneToken(), ownerId);
      allow create, update: if isAuth()
          && phoneDocIdsMatch(userDocIdFromPhoneToken(), ownerId)
          && request.resource.data.ownerId == ownerId
          && request.resource.data.everPublished == true;
    }

    // Ресторан видеоси (`linkKind == 'restaurant'`, `linkId` = ресторан id)
    // фақат ШУ рестораннинг а'золари (эга ёки ходим — `members`) томонидан
    // боғланади. Аввал боғлаш клип ҳужжатида эркин эди ва ҳимоя фақат
    // кўрсатишда `ownerPhone == эга` деб текширилар эди — шу туфайли ходим
    // юклаган видео кўринмасди. Энди ваколат ЯРАТИШ/ЎЗГАРТИРИШда қоида
    // билан кафолатланади, мижоз томонида эгалик талаб қилинмайди.
    // Бошқа `linkKind`лар (ad, service, market_ad, wholesale_product) —
    // ўзгармайди.
    //
    // Таом видеоси (linkKind == 'restaurant_item', 2026-10-19): linkId — ресторан id (ваколат ШУ
    // рестораннинг а'золигидан), linkItemId — таом id; таом ШУ ресторанда МАВЖУД бўлиши шарт (бошқа
    // рестораннинг таомига ёки ўйлаб топилган id'га боғлаб бўлмайди).
    function tvClipRestaurantLinkOk(d) {
      let kind = d.get('linkKind', '');
      return !(kind == 'restaurant' || kind == 'restaurant_item')
          || (d.get('linkId', '') is string
              && d.get('linkId', '') != ''
              && isRestaurantMember(d.get('linkId', ''))
              && (kind == 'restaurant'
                  || (d.get('linkItemId', '') is string
                      && d.get('linkItemId', '') != ''
                      && d.get('linkItemId', '').size() <= 64
                      && exists(/databases/$(database)/documents/restaurants/$(d.get('linkId', ''))/menu_items/$(d.get('linkItemId', ''))))));
    }

    // Ўзгартириш: боғлаш ўзгармаса (ёки ресторанга боғланмаса) — хавфсиз;
    // янги/бошқа ресторанга кўчириш — фақат шу рестораннинг а'зоси.
    function tvClipRestaurantLinkUpdateOk() {
      let a = request.resource.data;
      let b = resource.data;
      return !(a.get('linkKind', '') == 'restaurant' || a.get('linkKind', '') == 'restaurant_item')
          || (b.get('linkKind', '') == a.get('linkKind', '')
              && b.get('linkId', '') == a.get('linkId', '')
              && b.get('linkItemId', '') == a.get('linkItemId', ''))
          || tvClipRestaurantLinkOk(a);
    }

    // TV Market клиплари — ўқиш ҳаммага; ёзиш authed.
    match /tv_clips/{clipId} {
      allow read: if true;
      // 'ad' — faqat CF (publishTvAd, Admin SDK) yozadi: to'lov wallet'dan
      // shu yerda debit qilinadi, klient to'g'ridan-to'g'ri yozsa to'lovsiz
      // reklama joylab qo'yishi mumkin bo'lardi.
      //
      // Moderatsiya (admin «AVAGram» bo'limi): avval `status` tekshirilmasdi —
      // klient `tvAutoApprove`ni O'ZI o'qib `active`/`pending` tanlardi,
      // o'zgartirilgan klient QO'LDA rejimda ham `active` yozib moderatsiyani
      // chetlab o'tardi, `onTvClipSocialPublish` esa uni darhol AVA rasmiy
      // Instagram/Facebook/YouTube/Telegram sahifalariga joylardi. Endi
      // `active` faqat `settings/app.tvAutoApprove == true` bo'lsa (ilova
      // aynan shu shartda `active` yozadi — eski versiya buzilmaydi).
      // Egasi — faqat token egasi (avval begona `ownerPhone` bilan ham
      // yaratish mumkin edi). Ijtimoiy tarmoq natija maydonlari — faqat CF.
      allow create: if isAuth()
          && request.resource.data.category != 'ad'
          && (isAdmin()
              || (phoneDocIdsMatch(userDocIdFromPhoneToken(),
                      request.resource.data.ownerPhone)
                  && (request.resource.data.status == 'pending'
                      || (request.resource.data.status == 'active'
                          && tvAutoApproveOn()))
                  && !request.resource.data.keys().hasAny([
                      'socialPost', 'socialPostedAt', 'socialRetryAt',
                      'socialVideoUrl'])
                  && tvClipRestaurantLinkOk(request.resource.data)));
      // Egasi `socialRetryAt`ni o'zgartirsa trigger `force` bilan qayta
      // joylardi — AVA sahifalariga takroriy post. Endi faqat admin/CF.
      allow update: if isAdmin()
          || (isAuth()
              && phoneDocIdsMatch(userDocIdFromPhoneToken(), resource.data.ownerPhone)
              && !(request.resource.data.category == 'ad' && resource.data.category != 'ad')
              && tvClipRestaurantLinkUpdateOk()
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['expiresAt', 'adDurationDays', 'adTier', 'adScope',
                           'regionId', 'status', 'rejectReason',
                           'socialPost', 'socialPostedAt', 'socialRetryAt',
                           'socialVideoUrl']))
          || tvClipLikeCountOnly()
          || tvClipViewCountOnly()
          || tvClipCommentCountOnly()
          || tvClipPlaybackStatsOnly();
      allow delete: if isAdmin()
          || (isAuth()
              && phoneDocIdsMatch(userDocIdFromPhoneToken(), resource.data.ownerPhone));

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth()
            && phoneDocIdsMatch(userDocIdFromPhoneToken(), request.resource.data.authorPhone)
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() <= 80
            && (
              (request.resource.data.type == 'quick'
                && request.resource.data.key in ['price', 'location', 'delivery'])
              || (request.resource.data.type == 'text'
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.text.size() <= 140)
            );
        allow update: if false;
        allow delete: if isAdmin()
            || (isAuth()
                && phoneDocIdsMatch(userDocIdFromPhoneToken(), resource.data.authorPhone));
      }

      match /likes/{likerId} {
        allow read: if isAuth();
        allow create: if isAuth()
            && phoneDocIdsMatch(userDocIdFromPhoneToken(), likerId);
        allow update: if false;
        allow delete: if isAuth()
            && phoneDocIdsMatch(userDocIdFromPhoneToken(), likerId);
      }

      match /views/{viewerId} {
        allow read: if isAdmin();
        allow create: if isAuth()
            && phoneDocIdsMatch(userDocIdFromPhoneToken(), viewerId)
            && request.resource.data.keys().hasOnly(['viewedAt']);
        allow update: if isAuth()
            && phoneDocIdsMatch(userDocIdFromPhoneToken(), viewerId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['viewedAt']);
        allow delete: if false;
      }
    }

    // TV жойлаштирувчи исми — `users` оммавий эмас; роликдаги исм бўш бўлса шу ердан.
    match /tv_public_profiles/{ownerPhone} {
      allow read: if true;
      allow create: if isAuth()
          && phoneDocIdsMatch(userDocIdFromPhoneToken(), ownerPhone)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && tvPublicProfilePhotoOk();
      allow update: if tvPublicProfileViewCountOnly()
          || tvPublicProfileFollowerCountOnly()
          || (isAuth()
              && phoneDocIdsMatch(userDocIdFromPhoneToken(), ownerPhone)
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.name.size() <= 80
              && tvPublicProfilePhotoOk());
      allow delete: if isAdmin()
          || (isAuth()
              && phoneDocIdsMatch(userDocIdFromPhoneToken(), ownerPhone));

      match /followers/{followerId} {
        allow read: if isAuth();
        allow create: if isAuth()
            && phoneDocIdsMatch(userDocIdFromPhoneToken(), followerId)
            && !phoneDocIdsMatch(followerId, ownerPhone);
        allow update: if false;
        allow delete: if isAuth()
            && phoneDocIdsMatch(userDocIdFromPhoneToken(), followerId);
      }
    }

    match /tv_shops/{ownerPhone} {
      allow read: if true;
      allow create: if isAuth()
          && phoneDocIdsMatch(userDocIdFromPhoneToken(), ownerPhone);
      allow update, delete: if isAdmin()
          || (isAuth()
              && phoneDocIdsMatch(userDocIdFromPhoneToken(), ownerPhone));
    }

    match /tv_shop_items/{itemId} {
      allow read: if true;
      allow create: if isAuth()
          && phoneDocIdsMatch(userDocIdFromPhoneToken(), request.resource.data.ownerPhone);
      allow update: if isAdmin()
          || (isAuth()
              && phoneDocIdsMatch(userDocIdFromPhoneToken(), resource.data.ownerPhone)
              && tvShopOwnerFieldsLocked());
      allow delete: if isAdmin()
          || (isAuth()
              && phoneDocIdsMatch(userDocIdFromPhoneToken(), resource.data.ownerPhone));
    }

    // ══════════════════════════════════════
    // EV CHARGING — ⚡ Электромобил зарядлаш нуқталари (жамоа харитаси)
    //   ev_charging_stations — асосий коллекция (координата мажбурий).
    //   confirmations/{userId} — "Ҳа, шу ерда" (idempotent, docId = userId).
    //   reports/{reportId} — "Йўқ, нуқта йўқ" / хато хабар (лимит — config'дан).
    //   reportLimits/{userId} — counter-document, фақат Cloud Function (Admin
    //   SDK) ёзади, клиент фақат ўзиникини ўқийди.
    //   Фақат рўйхатдан ўтган (телефон claim бор) фойдаланувчилар — anon session
    //   'phone_number' claim'сиз бўлади, шу сабабли phoneFromToken() != ''
    //   аниlanadigan "registered" tekshiruvi.
    //   verificationStatus/confirmationCount/reportCount/status — клиент
    //   яратишда фақат default қиймат билан, кейин фақат isAdmin() ёки Admin
    //   SDK (Cloud Function) орқали ўзгартирилади.
    //   ЯНГИ станция қўшиш — ПУЛЛИК (эга қарори, 2026-09-22): клиент энди
    //   тўғридан-тўғри `create` қила олмайди — фақат
    //   `payAndCreateEvStation` callable (Admin SDK, ҳамёндан тўлов билан
    //   бирга) орқали. Мавжуд ҳужжатни таҳрирлаш (`evStationCommunityPatch`)
    //   ҳамон бепул ва ўзгармади.
    // ══════════════════════════════════════
    function evStationCommunityPatch() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'chargingTypes', 'connectors', 'powerKw', 'price',
            'operatorName', 'note', 'updatedAt'
          ]);
    }

    // «Банд / Бўш» — жамоа хабари. Фақат шу иккита майдон, фақат икки
    // қиймат. `status` (ишлайди/ишламайди) га тегмайди — у бошқа нарса.
    function evStationOccupancyPatch() {
      let d = request.resource.data;
      return isAuth()
          && phoneFromToken() != ''
          && d.diff(resource.data).affectedKeys()
               .hasOnly(['occupancy', 'occupancyAt'])
          && d.occupancy in ['free', 'busy']
          && d.occupancyAt is timestamp;
    }

    // Лимит қиймати `config/ev_charging.maxReportsPerUserPerStation`дан —
    // hardcode emas (7-band); hujjat/maydon bo'lmasa 3 — kod fallback.
    function evMaxReportsPerStation() {
      let cfgPath = /databases/$(database)/documents/config/ev_charging;
      return exists(cfgPath) && ('maxReportsPerUserPerStation' in get(cfgPath).data)
          ? get(cfgPath).data.maxReportsPerUserPerStation
          : 3;
    }

    function evReportLimitOk(stationId, userId) {
      let limitPath = /databases/$(database)/documents/ev_charging_stations/$(stationId)/reportLimits/$(userId);
      return !exists(limitPath) || get(limitPath).data.count < evMaxReportsPerStation();
    }

    match /ev_charging_stations/{stationId} {
      allow read: if isAuth() && phoneFromToken() != '';
      // Клиент тўғридан-тўғри яратолмайди — пуллик (payAndCreateEvStation,
      // Admin SDK) ёки очиқ манба импорти (Admin SDK) орқали.
      allow create: if isAdmin();
      allow update: if isAdmin()
          || (
            isAuth() && phoneFromToken() != ''
            && evStationCommunityPatch()
          )
          || evStationOccupancyPatch();
      allow delete: if isAdmin();

      match /confirmations/{userId} {
        allow read: if isAuth() && phoneFromToken() != '';
        allow create, update: if isOwner(userId)
            && request.resource.data.userId == userId;
        allow delete: if false;
      }

      match /reports/{reportId} {
        allow read: if isAdmin();
        allow create: if isOwner(request.resource.data.reporterId)
            && request.resource.data.reason in [
                 'wrong_location', 'station_not_found', 'not_working',
                 'wrong_connector', 'wrong_power', 'wrong_price', 'other'
               ]
            && evReportLimitOk(stationId, request.resource.data.reporterId);
        allow update: if isAdmin();
        allow delete: if false;
      }

      match /reportLimits/{userId} {
        allow read: if isAdmin() || isOwner(userId);
        allow write: if false; // фақат Cloud Function (Admin SDK)
      }
    }

    // ══════════════════════════════════════
    // 🏠 КЎЧМАС МУЛК КЛАСТЕРИ — `realty_listings`
    //
    //   ЁЗУВ ИККИГА АЖРАТИЛГАН — бу шу бўлимнинг асосий хавфсизлик
    //   қарори. Концепция (4-бўлим) объект ҳақидаги АХБОРОТНИ сотади.
    //   Агар аниқ координата ва алоқа рақами очиқ ҳужжатда турса,
    //   ҳар қандай фойдаланувчи уларни базадан пакетсиз ўқиб олар,
    //   ахборот пакетининг маъноси қолмас эди. Шунинг учун:
    //     • очиқ ҳужжат — тавсиф, нарх, расм ва ТАХМИНИЙ ҳудуд
    //       (`areaLat`/`areaLng` = geohash4 катакчаси маркази, ≈20 км);
    //       эга ҳам телефон билан эмас, тасодифий `ownerKey` билан;
    //     • `private/detail` — АНИҚ координата ва телефон; уни фақат
    //       эга, админ ёки шу объектни пакетидан очган харидор ўқийди.
    //
    //   Ўқиш: лентани МЕҲМОН ҳам кўра олади (концепция, 9-бўлим) —
    //   шунинг учун очиқ ҳужжатга `isAuth()` кифоя.
    //
    //   Ёзиш: клиент тўғридан-тўғри яратмайди — фақат
    //   `submitRealtyListing` (Admin SDK) орқали. Сабаби: бепул лимит
    //   (2 та объект), ҳудуд тамғаси ва муддат серверда ҳисобланади
    //   (`ev_charging_stations` билан бир хил қоида).
    // ══════════════════════════════════════
    function realtyOwnerKey() {
      let uid = userDocIdFromPhoneToken();
      return uid != ''
          && exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid))
            .data.get('realtyOwnerKey', '')
        : '';
    }

    function realtyListingIsMine(listingId) {
      let key = realtyOwnerKey();
      return key != ''
          && get(/databases/$(database)/documents/realty_listings/$(listingId))
               .data.get('ownerKey', '') == key;
    }

    // Пакетдан очилган объект — `unlockRealtyListing` CF яратади.
    function realtyUnlockedByMe(listingId) {
      let uid = userDocIdFromPhoneToken();
      return uid != ''
          && exists(/databases/$(database)/documents/users/$(uid)/realty_unlocked/$(listingId));
    }

    match /realty_listings/{listingId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();

      match /private/{docId} {
        allow read: if isAdmin()
            || realtyListingIsMine(listingId)
            || realtyUnlockedByMe(listingId);
        allow write: if false; // фақат Cloud Function (Admin SDK)
      }
    }

    // Очилган объектлар рўйхати — эга ўзиникини кўради, ёзув фақат CF.
    match /users/{userId}/realty_unlocked/{listingId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // Риэлтор воситалари (концепция, 5-бўлим) — пул билан боғлиқ эмас,
    // фақат эгасининг ўз қулайлиги. Шунинг учун клиент ўзи ёзади.
    //   realty_places — «сақланган уйлар»: тез-тез ишлатиладиган уй ва
    //     турар-жой мажмуалари нуқтаси билан.
    //   realty_prefs/template — компаниянинг стандарт матни ва шартлари.
    match /users/{userId}/realty_places/{placeId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/realty_prefs/{docId} {
      allow read, write: if isOwner(userId);
    }

    // ИЖАРА / СОТУВ ХАБАРНОМАСИ — «шундай уй чиқса, хабар бер» (эга
    // қарори 2026-10-08, `functions/realty_alerts.js`). Ёзиш ФАҚАТ CF:
    // текширув, лимит ва муддат серверда (18-қоида). Эгаси ўзиникини
    // ўқийди (`where('ownerId', ==, телефон)`).
    // Тест: functions/test/realty_alerts_rules.test.js
    match /realty_alerts/{alertId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow write: if false;
    }
    // Idempotency ёзуви (`{alertId}_{listingId}`) — клиентга керак эмас.
    match /realty_alert_hits/{hitId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Ижарачининг «мос эълонлар» рўйхати. Фақат очиқ маълумот (рақам,
    // манзил, аниқ нуқта ЙЎҚ). Эгаси фақат `seen` белгисини ўзгартиради
    // ва ўчира олади; яратиш — фақат CF.
    match /users/{userId}/realty_matches/{listingId} {
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['seen']);
      allow delete: if isOwner(userId);
      allow create: if false;
    }
    // Кунлик push саноғи — фақат сервер (транзакция).
    match /users/{userId}/realty_alert_meta/{docId} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // ТАЛАБ → ТАКЛИФ ЯДРОСИ (13.3.1, 13.3.2)
    // Ҳужжат: docs/talab_taklif_yadrosi_uz.md
    //
    // АСОСИЙ ҚОИДА: клиент `demands`, `provider_stats`, `demand_matches`
    // ва `trust_events`га ҲЕЧ ҚАЧОН тўғридан-тўғри ёзмайди. Барча муҳим
    // амаллар callable функциялар орқали (`functions_demand/api/*`).
    //
    // ДИҚҚАТ — Т-2: концепциядаги қоидалар `request.auth.uid`ни
    // ишлатган. Бу лойиҳада фойдаланувчи ID = телефон рақами
    // (`token.phone_number`), шунинг учун ҳамма жойда мавжуд `isOwner()`
    // ва `phoneDocIdsMatch()` ёрдамчилари ишлатилади.
    // ═══════════════════════════════════════════════════════════════════

    // Талабнинг тўлиқ нусхаси — аниқ манзил ва контакт билан.
    // Фақат эгаси ўқийди. Таклифчи буни ҲЕЧ ҚАЧОН кўрмайди — у
    // `demand_matches` проекциясини ўқийди.
    match /demands/{demandId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow write: if false; // createDemand, cancelDemand, acceptOffer

      // Т-8: аниқ `matchedCount` МИЖОЗГА ҲАМ кўринмайди.
      // Сабаб: харидорнинг ўзи рақобатчи бўлиши мумкин ва мос
      // сотувчилар сонини йиғиши мумкин. Шунинг учун ҳужжатда фақат
      // `matching.matchedBucket` («30+»), аниқ рақам эса шу ерда.
      match /private/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // Битта таклифчидан битта таклиф. ID = providerId.
      //
      // `ownerId` ҳужжатга денормаллаштирилган (Т-2.2): акс ҳолда ҳар
      // бир таклифни ўқишда ота `demands` ҳужжатига `get()` керак
      // бўларди — бу ҳар рўйхат учун қўшимча ўқиш ва секинлик.
      //
      // Таклифчилар бир-бирининг нархини КЎРМАЙДИ (тасдиқланган қарор).
      match /offers/{providerId} {
        allow read: if isOwner(providerId)
                    || isOwner(resource.data.ownerId)
                    || isAdmin();
        allow write: if false; // submitOffer, withdrawOffer, acceptOffer
      }
    }

    // ТАКЛИФЧИ УЧУН ПРОЕКЦИЯ — у кўрадиган ЯГОНА манба.
    //
    // Калит `{demandId}_{providerId}`, лекин қоида КАЛИТГА ТАЯНМАЙДИ:
    // `providerId` ҳужжат ичида майдон сифатида ҳам сақланади ва
    // текширув айни шу майдон бўйича кетади (Т-2.1). Сабаб: 9/12 хонали
    // телефон шакллари сабабли калитни бўлиб таққослаш ишончсиз.
    //
    // Клиент ҳар доим `where('providerId','==', <ўз ID>)` фильтри билан
    // сўров беради — фильтрсиз сўров rules томонидан рад этилади.
    match /demand_matches/{matchKey} {
      allow read: if isOwner(resource.data.providerId) || isAdmin();
      allow write: if false; // runMatching

      // Таклифчи «кўрдим» белгисини қўйиши — ягона рухсат этилган ёзув.
      // Фақат `status` ва `seenAt` майдонлари, бошқа ҳеч нарса.
      allow update: if isOwner(resource.data.providerId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'seenAt'])
                    && request.resource.data.status in ['new', 'seen', 'skipped'];
    }

    // ══════════════════════════════════════
    // CAPABILITY — «нимага рухсати бор» (D-12…D-16, 2026-10-06)
    // ══════════════════════════════════════
    //
    // Шакл (эга қарори): БИТТА uid = БИТТА ҳужжат, ичида хизматлар.
    //
    //   provider_capabilities/{uid}
    //     courier: { active: true, regionIds: [...] }   ← КЛИЕНТ
    //     taxi:    { active: true, ... }                ← КЛИЕНТ
    //     status:  { courier: 'trial', taxi: 'approved' } ← ФАҚАТ СЕРВЕР
    //     trial:   { courier: { endsAt, graceEndsAt } }   ← ФАҚАТ СЕРВЕР
    //     review:  { courier: { submittedAt, reviewedBy } } ← ФАҚАТ СЕРВЕР
    //
    // Capability'лар бир-бирини ИСТИСНО ҚИЛМАЙДИ: бир одам ҳам курьер,
    // ҳам ҳайдовчи, ҳам сотувчи бўлиши мумкин (D-13). Шунинг учун
    // `users.role` эмас — у аккаунтнинг тизим роли (D-12).
    //
    // ── D-14 ИККИ ҚАТОРДА ──────────────────────────────────────────────
    // «Фойдаланувчи ўзига ўзи `approved` беролмасин.» `status` хизмат
    // map'и ИЧИДА эмас, АЛОҲИДА юқори даражадаги калитда — чунки
    // `affectedKeys()` фақат юқори даражадаги калитларни қайтаради.
    // Ички map бўлганда «клиент `courier.regionIds`ни ўзгартирдими ёки
    // `courier.status`ни?» деган саволга қоида жавоб бера олмасди ва
    // ҳар бир хизматни қўлда санаш керак бўларди — янги хизмат
    // қўшилганда тешик ЖИМГИНА очиларди.
    //
    // Рўйхат `functions_demand/core/capabilities.js` → `SERVER_KEYS`
    // билан бир хил бўлиши ШАРТ (тест билан қулфланган).
    //
    // Статусни фақат callable'лар ўзгартиради (Admin SDK):
    //   `requestCapability` · `submitCapabilityDocument` ·
    //   `approveCapability` · `rejectCapability` · `suspendCapability`.
    //
    // Тест: functions/test/provider_capabilities_rules.test.js
    function capabilityServerKeysUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['identity', 'status', 'window', 'review', 'suspend', 'debt']);
    }

    // КАЛИТ — барқарор `accountId` (T-1a), телефон эмас. Эгалик
    // `users/{токен телефони}.accountId` орқали текширилади
    // (`isCapabilityOwner`, 1 ўқиш). `identity.primaryUid` — сервер
    // ёзган канон телефон; matching шу билан ишлайди.
    //
    // ЯРАТИШ — фақат сервер (`requestCapability`): ҳужжат `identity` ва
    // `status` билан бирга туғилади, клиент ярата олмайди. Клиент фақат
    // МАВЖУД ҳужжатда ўз хизмат map'ини янгилайди.
    match /provider_capabilities/{accountId} {
      allow read: if isCapabilityOwner(accountId) || isAdmin();

      allow create: if isAdmin();

      allow update: if isAdmin()
                    || (
                      isCapabilityOwner(accountId)
                      && capabilityServerKeysUntouched()
                      // Статистика ва trust — `provider_stats` да.
                      // `affectedKeys` ишлатилади: `keys()` билан
                      // ёзилса, сервер бир марта ёзгандан кейин
                      // клиентнинг ҲАР БИР ёзуви рад этиларди.
                      && !request.resource.data.diff(resource.data)
                           .affectedKeys().hasAny([
                             'trustScore', 'rating', 'stats',
                             'completedCount', 'todayOrders',
                             'matchingBlocked', 'debtBlocked'
                           ])
                    );

      // Ўчириш — фақат админ: `suspended` ёзувини ўчириб ташлаб
      // тарихни йўқотиш мумкин бўлмасин (16-қоида).
      allow delete: if isAdmin();
    }

    // Хизмат келишувлари (D-SERVICE-2, D-TAXI-24) — фақат сервер ёзади
    // (`acceptServiceAgreement`), эгаси ва админ ўқийди.
    match /service_agreements/{accountId} {
      allow read: if isCapabilityOwner(accountId) || isAdmin();
      allow write: if false;
    }

    // Admin capability амаллари журнали — append-only, фақат админ ўқийди
    // (41-қоида).
    match /capability_audit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ══════════════════════════════════════
    // TAXI BILLING (D-TAXI-13…23) — ҳаммасини ФАҚАТ сервер ёзади
    // ══════════════════════════════════════
    // Рейс billing snapshot'и (D-TAXI-21): ҳайдовчи ўзиникини ўқийди.
    match /taxi_trips/{tripId} {
      allow read: if isAdmin() || isOwner(resource.data.driverUid);
      allow write: if false;
    }
    // Нарх ўзгаришлари audit'и (D-TAXI-12).
    match /taxi_price_changes/{id} {
      allow read: if isAdmin() || isOwner(resource.data.uid);
      allow write: if false;
    }
    // Anti-fraud ҳолатлари (D-TAXI-16…19) — фақат админ.
    match /taxi_fraud_cases/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ══════════════════════════════════════
    // AVA LOGISTICS (RELAY) — D-3…D-11 (relay hujjati 7.7)
    // ══════════════════════════════════════
    // ҲАММАСИНИ ФАҚАТ СЕРВЕР ЁЗАДИ (`createLogisticsOrder`, `acceptLeg`,
    // `scanHandover`, `confirmDelivery`, eskrou triggerlari). `delivery_routes`
    // ва `couriers` намунаси ТАКРОРЛАНМАЙДИ. LEG'лар — `demands`да (юқорида).
    //
    // ORDER — мижознинг буюртмаси: қабул қилувчи телефони ФАҚАТ шу ерда,
    // фақат эгаси ўқийди (40-банд).
    match /logistics_orders/{orderId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerId);
      allow write: if false;
    }
    // SHIPMENT — эгаси, админ ва шу жўнатмага тайинланган ижрочилар
    // (`assignedProviderIds` — сервер ёзади, канон 12 хонали). Ижрочи
    // чекланган маълумотни кўради: телефон йўқ, ички нарх қатлами йўқ.
    match /shipments/{shipmentId} {
      allow read: if isAdmin()
                  || isOwner(resource.data.ownerId)
                  || (isAuth()
                      && 'assignedProviderIds' in resource.data
                      && userDocIdFromPhoneToken() in resource.data.assignedProviderIds);
      allow write: if false;
      // Сирлар (QR, кодлар — D-6) ва ИЧКИ нарх қатлами (14-банд):
      // клиент ҲЕЧ ҚАЧОН ўқимайди, фақат callable беради.
      match /private/{docId} {
        allow read, write: if false;
      }
    }
    // CUSTODY — ўзгармас тарих (15, 16-банд): эгаси, админ, икки томон.
    match /custody_events/{eventId} {
      allow read: if isAdmin()
                  || isOwner(resource.data.ownerId)
                  || (isAuth()
                      && (resource.data.from.id == userDocIdFromPhoneToken()
                          || resource.data.to.id == userDocIdFromPhoneToken()));
      allow write: if false;
    }
    // Маршрут режалари (D-9, версияланган) — ички, фақат админ.
    match /route_plans/{shipmentId} {
      allow read: if isAdmin();
      allow write: if false;
      match /versions/{version} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
    // Тариф (версияли, D-2/D-8) — `module_tariffs/logistics*` қоидаси
    // умумий `module_tariffs` блокида (пастда): бир йўлга иккита `match`
    // тушса ҳар қандай `allow` етарли бўлгани учун истисно ўша ерда.
    // Тариф/маршрут admin амаллари журнали (41-банд) ва tracking ҳисоблагичи.
    match /logistics_audit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /logistics_counters/{id} {
      allow read, write: if false;
    }

    // Trust, public rating, бугунги буюртма ва даромад.
    // Эгаси ўқийди, ҲЕЧ КИМ ёзмайди (фақат `recomputeTrust`).
    match /provider_stats/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Онлайн ҳолати ва GPS. Фақат ўзи ёзади.
    //
    // Концепция `allow read: if false` деган эди, лекин курьернинг ўзи
    // ва админ панели ўз ҳолатини кўриши керак (Т-2.3).
    //
    // 13.6.3 — ЁЗУВЧИ ва SWEEP ШАРТНОМАСИ. Коллекция янги (продакшнда 0
    // ҳужжат), шунинг учун чекловлар дарҳол қўйилади — эски ёзувларни
    // бузиш хавфи йўқ.
    function presenceClientFieldsOk(uid) {
      return
        // 1. ВАҚТНИ СЕРВЕР ҚЎЯДИ. Акс ҳолда курьер КЕЛАЖАК вақтни ёзиб
        //    доимо «ҳозир шу ерда» бўлиб туради: sweep уни ҳеч қачон
        //    offline қилмайди (`maintenance.makePresenceSweeper`),
        //    matching фильтри ҳам тутмайди (`sources/presence_geo.js`),
        //    ва GPS янгилиги бонусини доимо тўлиқ олади
        //    (`adapters/courier.js` → `score`). Клиент
        //    `FieldValue.serverTimestamp()` ишлатиши ШАРТ.
        // `in` текшируви: rules мавжуд бўлмаган калитга мурожаатни
        // evaluation error деб ҳисоблайди. Rules ифодани ТЎЛИҚ
        // ҳисоблайди (short-circuit йўқ), шунинг учун `in` хатонинг
        // ЛОГга тушишини тўхтатмайди — лекин натижа аниқ `false`
        // бўлишини кафолатлайди (`false && <error>` = `false`).
        // Текширилган: 29/29, `provider_presence_rules.test.js`.
        'updatedAt' in request.resource.data
        && request.resource.data.updatedAt == request.time
        // 2. КИМЛИК — калит билан мос ва МАЖБУРИЙ. Сервер таклифчи
        //    кимлигини КАЛИТдан олади (`sources/presence_geo.js`),
        //    лекин ҳужжат ичидаги ёлғон майдон админ панелини
        //    чалғитмаслиги керак. Намуна: `provider_capabilities`
        //    (3216-қатор).
        && 'providerId' in request.resource.data
        && request.resource.data.providerId is string
        && phoneDocIdsMatch(request.resource.data.providerId, uid)
        && !request.resource.data.keys().hasAny([
             'trustScore', 'rating', 'matchingBlocked'
           ]);
    }

    match /provider_presence/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid) && presenceClientFieldsOk(uid);

      // 3. `offlineAt`/`offlineReason` — ФАҚАТ sweep ёзади (Admin SDK
      //    қоидаларни четлаб ўтади). Бу текширув `affectedKeys()`
      //    бўйича: `keys().hasAny()` билан ёзилганда, sweep бир марта
      //    ёзгандан кейин курьернинг ҲАР БИР heartbeat'и рад этиларди —
      //    чунки `request.resource.data` ўзгармаган майдонларни ҳам
      //    ўз ичига олади.
      allow update: if isOwner(uid) && presenceClientFieldsOk(uid)
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['offlineAt', 'offlineReason']);

      // Оффлайн бўлиш = `isOnline: false`, ўчириш ЭМАС. Лекин ўз
      // жойлашув маълумотини бутунлай ўчириш ҳуқуқи қолдирилади
      // (40-қоида: PII минимал сақланади). Аввал `allow write` ичида
      // эди, яъни delete'да `request.resource` бўлмагани учун
      // амалда ишламай турган эди.
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Шаҳарлараро сафар — «Йўлим устида» модели (P2).
    //
    // ДИҚҚАТ: `trips` НОМИ ИШЛАТИЛМАЙДИ — у production'да маҳаллий
    // такси сафарлари учун банд (`taxiType`, `fromLat`, `driverId`).
    // 2026-10-03 аудитида тасдиқланган.
    match /provider_trips/{tripId} {
      allow read: if isAuth();
      allow create, update: if isOwner(request.resource.data.driverId)
                    && !request.resource.data.keys().hasAny([
                         'assignedParcelIds', 'trustScore'
                       ]);
      allow delete: if isOwner(resource.data.driverId) || isAdmin();
    }

    // Trust'га таъсир қилувчи воқеалар журнали — ЎЗГАРМАС.
    // Клиент ўқиёлмайди ҳам: воқеа матни модерация изоҳини ўз ичига
    // олиши мумкин.
    match /trust_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Баҳолар. Фақат бажарилган талаб бўйича, callable орқали.
    // Агрегат ҳамма учун очиқ (`provider_stats.rating`).
    match /demand_ratings/{ratingId} {
      allow read: if isAuth();
      allow write: if false; // submitRating
    }

    // Push idempotency журнали — фақат сервер.
    match /demand_push_log/{key} {
      allow read, write: if false;
    }

    // Idempotency калитлари (Т-12) — фақат сервер.
    match /demand_idempotency/{key} {
      allow read, write: if false;
    }

    // Ягона категория дарахти. Ҳамма ўқийди, админ ёзади.
    match /taxonomy/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Модул созламалари: тўлқинлар, score чегараси, push лимитлари.
    //
    // Клиент ЎҚИЙДИ (форма чегаралари ва «Intent Router» луғати учун),
    // лекин ёзмайди. `enabled`/`pushEnabled` kill switch'лари ҳам шу ерда.
    match /module_config/{key} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Жарима ва қарз ҲОЛАТИ. Пулнинг ўзи `wallet_ledger`да (Т-11).
    match /demand_penalties/{penaltyId} {
      allow read: if isOwner(resource.data.providerId) || isAdmin();
      allow write: if false; // applyPenalty
    }

    // Курьер ҳужжатлари: паспорт ва ўзини ўзи банд қилиш ҳужжати.
    //
    // Фақат эгаси юклайди, фақат модератор кўради. Файлларнинг ўзи
    // ёпиқ Storage папкасида (`storage.rules`).
    match /courier_documents/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
                    && !request.resource.data.keys().hasAny([
                         'verified', 'verifiedAt', 'verifiedBy', 'rejectReason'
                       ]);
      allow delete: if isAdmin();
    }

    // Жонли кузатув (P2).
    //
    // Т-3: Realtime Database ЖОРИЙ ЭТИЛМАЙДИ — Урганч ҳажмида Firestore
    // кунига ~$0,13, RTDB эса янги инстанс + SDK + rules файли талаб
    // қилади. Кунлик фаол кузатув 2000'дан ошса қайта кўрилади.
    //
    // Ёзишни фақат тайинланган курьер қилади, ўқишни юборувчи ва
    // қабул қилувчи. Иловасиз қабул қилувчи `getTracking(token)` орқали.
    match /demand_tracking/{demandId} {
      allow read: if isAuth() && (
                    isOwner(resource.data.senderId)
                    || isOwner(resource.data.recipientId)
                    || isOwner(resource.data.courierId)
                    || isAdmin()
                  );
      allow write: if isAuth()
                   && isOwner(resource.data.courierId)
                   && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lat', 'lng', 'heading', 'speed', 'updatedAt', 'etaMinutes']);
    }

    // Сийраклаштирилган маршрут тарихи — 30 кун, низо учун далил.
    // Фақат модератор кўради.
    match /demand_tracking_history/{demandId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Тариф формуласи ва комиссия — версия ва тарих билан.
    // Клиент ўқийди (нарх тавсиясини кўрсатиш учун), админ ёзади.
    //
    // ИСТИСНО — AVA Logistics тарифи (`logistics`, `logistics_v{N}`):
    // ичида ички ҳақ тақсимоти бор (14-банд) — фақат админ ўқийди, мижоз
    // нархни callable орқали олади; ёзиш ФАҚАТ callable орқали
    // (`adminUpsertLogisticsTariff` — валидация + audit, 41-банд).
    match /module_tariffs/{key} {
      function isLogisticsTariff() {
        return key == 'logistics' || key.matches('logistics_v[0-9]+');
      }
      allow read: if isAdmin() || (isAuth() && !isLogisticsTariff());
      allow write: if isAdmin() && !isLogisticsTariff();
    }

    // Кунлик аналитика агрегати (Т-22) — фақат админ.
    match /analytics_demand_daily/{key} {
      allow read: if isAdmin();
      allow write: if false;
    }

  }
}
