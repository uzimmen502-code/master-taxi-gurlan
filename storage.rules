rules_version = '2';
// Deploy: firebase deploy --only storage  |  Guide: docs/storage_cors_uz.md
service firebase.storage {
  match /b/{bucket}/o {
    // Админ панел каталог юкловчиси (Phone Auth token + `users/{phone}.role`).
    //
    // Аввал `bread_images`, `extra_images`, `oil_images`, `food_images`,
    // `platform_images` — `write: if true` («TEMP … after Admin Auth»):
    // ҳар ким (ҳатто кирмаган) иловадаги каталог расмларини алмаштира
    // оларди (номлари детерминистик: `{docId}.jpg`). `entertainment/` эса
    // аутентификациясиз 400MB юклашга рухсат берарди. Админ web аллақачон
    // Phone Auth'да (`adminWebSignIn` → `phone_number` claim), ягона
    // юкловчи — `BreadImageStorage` (админ экранлари) ва Кино каталоги таби.
    //
    // ⚠ Cross-service (Storage → Firestore) қоида: биринчи deploy'да CLI
    // Storage хизматига `firebaserules.firestoreServiceAgent` ролини
    // беришни сўрайди — розилик берилмаса текширув рад этади (админ юклаши
    // тўхтайди).
    function panelPhone() {
      return request.auth != null && request.auth.token.phone_number is string
          ? request.auth.token.phone_number.replace('\\+', '')
          : '';
    }
    function hasCatalogRole(docId) {
      return firestore.exists(/databases/(default)/documents/users/$(docId))
          && firestore.get(/databases/(default)/documents/users/$(docId)).data.role
              in ['admin', 'superadmin', 'dispatcher', 'finance'];
    }
    function isCatalogAdmin() {
      let p = panelPhone();
      return p != ''
          && (hasCatalogRole(p)
              || (p.size() == 12 && p.matches('998[0-9]{9}')
                  && hasCatalogRole(p[3:12])));
    }
    // 20MB — аввал чегара умуман йўқ эди; сиқилмаган телефон фотоси ҳам
    // ўтсин (ёзувчи фақат админ).
    function catalogImageOk() {
      return isCatalogAdmin()
          && request.resource.size < 20 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Нон расмлари
    match /bread_images/{name=**} {
      allow read: if true;
      allow write: if catalogImageOk();
      allow delete: if isCatalogAdmin();
    }

    // Қўшимча маҳсулот расмлари
    match /extra_images/{name=**} {
      allow read: if true;
      allow write: if catalogImageOk();
      allow delete: if isCatalogAdmin();
    }

    // Shaharlararo safar kinosi (MP4) — o'qish hammaga; yozish faqat admin,
    // .mp4, ≤400MB (har yuklash 4 GiB transkod ishga tushiradi).
    match /entertainment/{fileName} {
      allow read: if true;
      allow create: if isCatalogAdmin()
          && fileName.matches('.*\\.mp4')
          && request.resource.size < 400 * 1024 * 1024
          && request.resource.contentType.matches('video/.*');
      allow update, delete: if false;
    }

    // Арзон маҳсулотлар расмлари (ownerId = canonical phone; image ≤8MB).
    match /ads/{ownerId}/{fileName} {
      function adsStoragePhone() {
        return request.auth.token.phone_number.replace('\\+', '');
      }
      function adsOwnerPathOk() {
        let p = adsStoragePhone();
        return p == ownerId
            || (ownerId.size() == 12 && ownerId.matches('998[0-9]{9}')
                && p == ownerId[3:12])
            || (p.size() == 12 && p.matches('998[0-9]{9}')
                && ownerId == p[3:12]);
      }
      allow read: if true;
      allow write: if request.auth != null
          && adsOwnerPathOk()
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && adsOwnerPathOk();
    }

    // AVA Logistics — handover dalil rasmlari (relay 7.4, 3-qadam):
    // `ads/` bilan bir xil qoida — faqat o'z telefon papkasi, ≤8MB, rasm.
    // O'qish auth bilan: custody dalili ommaviy emas, lekin egasi va
    // ikkala ijrochi URL orqali ko'radi (Storage qoidasi Firestore'ni
    // tekshira olmaydi).
    match /logistics/{uploaderId}/{fileName} {
      function lgPhone() {
        return request.auth.token.phone_number.replace('\\+', '');
      }
      function lgOwnerPathOk() {
        let p = lgPhone();
        return p == uploaderId
            || (uploaderId.size() == 12 && uploaderId.matches('998[0-9]{9}')
                && p == uploaderId[3:12])
            || (p.size() == 12 && p.matches('998[0-9]{9}')
                && uploaderId == p[3:12]);
      }
      allow read: if request.auth != null;
      allow write: if request.auth != null
          && lgOwnerPathOk()
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Ulgurji bozor mahsulot rasmlari — `ads/` bilan bir xil qoida:
    // faqat o'z telefon papkasiga (9 / 998-prefiks alias), ≤8MB, faqat rasm.
    match /wholesale_products/{sellerId}/{fileName} {
      function wsPhone() {
        return request.auth.token.phone_number.replace('\\+', '');
      }
      function wsOwnerPathOk() {
        let p = wsPhone();
        return p == sellerId
            || (sellerId.size() == 12 && sellerId.matches('998[0-9]{9}')
                && p == sellerId[3:12])
            || (p.size() == 12 && p.matches('998[0-9]{9}')
                && sellerId == p[3:12]);
      }
      allow read: if true;
      allow write: if request.auth != null
          && wsOwnerPathOk()
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && wsOwnerPathOk();
    }

    // Kafe-restoran rasmlari (logotip, muqova, taomlar) — faqat restoran
    // A'ZOSI (`restaurants/{rid}/members/{phone}`, CF yozadi), ≤ 8MB, rasm.
    // O'qish — hammaga (menyu loginsiz ko'riladi). Cross-service qoida
    // (Storage → Firestore) — yuqoridagi IAM eslatmasi shu yerga ham taalluqli.
    // Test: functions/test/storage_restaurant_rules.test.js
    match /restaurant_images/{restaurantId}/{fileName} {
      function restPhone() {
        return request.auth != null && request.auth.token.phone_number is string
            ? request.auth.token.phone_number.replace('\\+', '')
            : '';
      }
      function isRestaurantMember() {
        let p = restPhone();
        return p != ''
            && firestore.exists(/databases/(default)/documents/restaurants/$(restaurantId)/members/$(p));
      }
      allow read: if true;
      allow write: if request.auth != null
          && isRestaurantMember()
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && isRestaurantMember();
    }

    // Davra (Mening yaqinlarim) fotoalbomi. O'qish — download URL bilan hammaga;
    // yozish — authed, faqat .jpg, ≤8MB. A'zolik Firestore qatlamida tekshiriladi.
    match /circles/{circleId}/album/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
          && fileName.matches('.*\\.jpg')
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Foydalanuvchi profil fotosi (Qarindoshlar «Мен» bilan sinxron).
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
          && request.auth.token.phone_number.replace('\\+', '') == userId
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
          && request.auth.token.phone_number.replace('\\+', '') == userId;
    }

    // Qarindosh fotosi — shaxsiy. Yozish/o'chirish faqat egasi (userId = phone),
    // o'qish download URL bilan (rasm sirli emas, faqat egasiga ko'rinadi amalda).
    match /relatives/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
          && request.auth.token.phone_number.replace('\\+', '') == userId
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
          && request.auth.token.phone_number.replace('\\+', '') == userId;
    }

    // Tanishuv (dating) profil fotolari. Yozish/o'chirish faqat egasi;
    // o'qish download URL bilan (tasdiqlangan profil fotolari ochiq ko'rinadi).
    match /dating/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
          && request.auth.token.phone_number.replace('\\+', '') == userId
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
          && request.auth.token.phone_number.replace('\\+', '') == userId;
    }

    // Мой/фильтр каталог расмлари (админ upload + илова read).
    match /oil_images/{name=**} {
      allow read: if true;
      allow write: if catalogImageOk();
      allow delete: if isCatalogAdmin();
    }

    // Таом каталог расмлари
    match /food_images/{name=**} {
      allow read: if true;
      allow write: if catalogImageOk();
      allow delete: if isCatalogAdmin();
    }

    // Платформа дўкони каталог расмлари (админ upload + илова read).
    match /platform_images/{name=**} {
      allow read: if true;
      allow write: if catalogImageOk();
      allow delete: if isCatalogAdmin();
    }

    // TV Market видеолари + постер — authed, ≤400MB.
    //
    // Илгари 100MB эди. Клиентда 15MB чегараси турганда бу девор ҳеч
    // қачон кўринмас эди; у олиб ташлангач, узун видео тўғри шунга
    // урилиб 403 берди (масалан 4 дақиқалик ролик 720p да 121MB).
    // Давомийлик чегараси серверда (`TV_CLIP_MAX_SECONDS`), бу эса
    // фақат сўнгги тўсиқ — `entertainment/` даги 400MB билан бир хил.
    match /tv_clips/{ownerPhone}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
          && request.resource.size < 400 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    match /tv_profile/{ownerPhone}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
          && request.resource.size < 8 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    match /tv_shop/{ownerPhone}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
          && request.resource.size < 8 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Telegram wallet top-up receipts — write CF Admin SDK only; finance read via signed URL CF.
    match /topup_receipts/{uid}/{fileName} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
